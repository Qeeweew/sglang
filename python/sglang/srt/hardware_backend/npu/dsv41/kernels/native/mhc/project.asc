#include <mhc/project_pipeline.h>
using namespace mhc;
__global__ __mix__(1, 2) void mhc_project(GM_ADDR residual, GM_ADDR fn, GM_ADDR projection,
                                          GM_ADDR squares, GM_ADDR inputs, GM_ADDR products, uint64_t rows,
                                              uint64_t padded_rows) {
    uint32_t actor = GetBlockIdx();
    if ASCEND_IS_AIV
        actor /= GetTaskRatio();
    const uint64_t row_tiles = (rows + kProjectPlan.tile_rows - 1) / kProjectPlan.tile_rows;
    // Host launches a dense prefix of live (split,row-group) pairs. Preserve
    // the original logical group and maximum-budget ring pitch for both actors.
    const uint32_t live_groups = min(uint64_t(kProjectPlan.row_groups), row_tiles);
    const uint32_t group = actor / live_groups * kProjectPlan.row_groups + actor % live_groups;
    if ASCEND_IS_AIC {
        CubeProject cube;
        cube.run(fn, inputs, products, group, rows);
    }
    if ASCEND_IS_AIV {
        project_vector(residual, projection, squares, inputs, products, group,
                       GetSubBlockIdx(), rows, padded_rows);
    }
}
