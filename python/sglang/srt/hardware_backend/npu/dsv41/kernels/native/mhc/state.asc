// BF16 state boundaries are explicit. Scalar coefficients and all reductions
// remain FP32. Dimensions and launch grids are passed by the checked host.
#include <mhc/vector_pipeline.h>
#if defined(MHC_PEER_ATTN)
#include <peer_all_reduce/attention_pipeline.h>
#elif defined(MHC_PEER_MOE)
#include <peer_all_reduce/moe_pipeline.h>
#endif
using namespace mhc;

#if defined(MHC_POST_COMBINE)
// Preload a bounded four-source Scalar packet before issuing its ordered
// Vector chain. This is independent of B; complete packets precede a runtime
// tail, and stream/coefficient addresses advance by one source stride.
__aicore__ inline void accumulate_source_packet(__ubuf__ float *total, __ubuf__ float *streams,
                                                __ubuf__ float *coefficients, uint32_t source,
                                                uint32_t branches, uint32_t tile, uint32_t dest) {
    constexpr uint8_t packet_repeats = 1;
    const uint32_t first = source * branches + dest;
    const float c0 = coefficients[first], c1 = coefficients[first + branches],
                c2 = coefficients[first + 2 * branches], c3 = coefficients[first + 3 * branches];
    auto input = streams + (source * tile);
    if (source == 0)
        asc_mul_scalar(total, input, c0, packet_repeats, 1, 1, kRepeatBlocks, kRepeatBlocks);
    else
        asc_axpy(total, input, c0, packet_repeats, 1, 1, kRepeatBlocks, kRepeatBlocks);
    pipe_barrier(PIPE_V);
    asc_axpy(total, (input + (tile)), c1, packet_repeats, 1, 1, kRepeatBlocks, kRepeatBlocks);
    pipe_barrier(PIPE_V);
    asc_axpy(total, (input + (2 * tile)), c2, packet_repeats, 1, 1, kRepeatBlocks, kRepeatBlocks);
    pipe_barrier(PIPE_V);
    asc_axpy(total, (input + (3 * tile)), c3, packet_repeats, 1, 1, kRepeatBlocks, kRepeatBlocks);
    pipe_barrier(PIPE_V);
}
// Post collapse owns exactly two equal normalization panels. Keeping that
// pipeline explicit avoids a dead whole-row branch in this fused entry.
__aicore__ inline void normalize_post_halves(__ubuf__ bfloat16_t *collapsed, __ubuf__ float *value,
                                             __ubuf__ float *work, __ubuf__ float *scratch,
                                             __ubuf__ float *stat, __ubuf__ float *weight,
                                             uint32_t width, float inverse_width, VectorEvents &ev,
                                             bool statistics_ready, GM_ADDR output) {
    const uint32_t half = width / 2;
    if (!statistics_ready) {
        for (uint32_t part = 0; part < 2; ++part) {
            const uint8_t segment_repeats = 1;
            asc_set_mask_count();
            asc_set_vector_mask(0, half);
            asc_bfloat162float(value, (collapsed + (part * half)), 1, 1, 1, kRepeatBlocks,
                               kRepeatBlocks / 2);
            pipe_barrier(PIPE_V);
            asc_mul(work, value, value, segment_repeats, 1, 1, 1, kRepeatBlocks, kRepeatBlocks,
                    kRepeatBlocks);
            pipe_barrier(PIPE_V);
            asc_set_mask_norm();
            reduce_r64((stat + (part * kBlockFloats)), work, scratch, half);
        }
    }
    const uint32_t scalar_elements = 1;
    const uint64_t scalar_mask =
        scalar_elements >= kRepeatFloats ? UINT64_MAX : (uint64_t(1) << scalar_elements) - 1;
    const uint8_t scalar_repeats = (1 + kRepeatFloats - 1) / kRepeatFloats;
    asc_set_vector_mask(0, scalar_mask);
    asc_add(stat, stat, (stat + (kBlockFloats)), scalar_repeats, 1, 1, 1, kRepeatBlocks,
            kRepeatBlocks, kRepeatBlocks);
    pipe_barrier(PIPE_V);
    const float inverse = inverse_rms(stat, inverse_width, ev);
    const uint8_t segment_repeats = 1;
    asc_set_mask_count();
    asc_set_vector_mask(0, half);
    for (uint32_t part = 0; part < 2; ++part) {
        asc_bfloat162float(value, (collapsed + (part * half)), 1, 1, 1, kRepeatBlocks,
                           kRepeatBlocks / 2);
        pipe_barrier(PIPE_V);
        asc_mul_scalar(work, value, inverse, segment_repeats, 1, 1, kRepeatBlocks, kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_mul(work, work, (weight + (part * half)), segment_repeats, 1, 1, 1, kRepeatBlocks,
                kRepeatBlocks, kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_float2bfloat16_rn((collapsed + (part * half)), work, 1, 1, 1, kRepeatBlocks / 2,
                              kRepeatBlocks);
        pipe_barrier(PIPE_V);
        {
            set_flag(PIPE_V, PIPE_MTE3, ::event_t(VectorEvents::store_ready));
            wait_flag(PIPE_V, PIPE_MTE3, ::event_t(VectorEvents::store_ready));
        }
        asc_copy_ub2gm_align((gm<bfloat16_t>(output) + (part * half)), (collapsed + (part * half)),
                             1, half * sizeof(*((collapsed + (part * half)))), 0, 0, 0, 0);
    }
    asc_set_mask_norm();
}

#endif

#if defined(MHC_COMBINE)
__global__ __vector__ void mhc_combine(GM_ADDR residual, GM_ADDR pre, GM_ADDR weight,
                                       GM_ADDR output, uint64_t rows) {
    constexpr const StateParams &p = kStatePlan;
    InitSocState();
    SetSaturationFlag<SaturationMode::FLOAT>(false); // IEEE Inf/NaN, as in the FP32 reference.
    VectorEvents ev;
    constexpr bool initial = MHC_INITIAL, normalize = MHC_NORMALIZE;
    const CombineLayout l(p.branches, p.width, p.column_tile);
    auto raw = ub<bfloat16_t>(l.raw);
    auto streams = ub<float>(l.streams);
    auto total = ub<float>(l.total), work = ub<float>(l.work);
    auto rounded = ub<bfloat16_t>(l.rounded);
    auto w = ub<float>(l.weight), scratch = ub<float>(l.scratch);
    auto stat = ub<float>(l.stat);
    auto r = gm<bfloat16_t>(residual), out = gm<bfloat16_t>(output);
    auto coefficients = gm<float>(pre);
    if (normalize) {
        asc_copy_gm2ub_align(w, gm<float>(weight), 1, p.width * sizeof(*(w)), 0, 0, 0, 0);
        {
            set_flag(PIPE_MTE2, PIPE_V, ::event_t(VectorEvents::loaded));
            wait_flag(PIPE_MTE2, PIPE_V, ::event_t(VectorEvents::loaded));
        }
    }
    const uint64_t core = GetBlockIdx(), cores = kWorkers;
    const uint64_t row_tasks = rows > core ? (rows - core + cores - 1) / cores : 0;
    const uint64_t tasks = row_tasks * p.column_tiles;
    if (tasks) {
        load_rows(raw, (r + (core * p.branches * p.width)), p.branches, p.column_tile, p.width,
                  p.column_tile);
        set_flag(PIPE_MTE2, PIPE_V, ::event_t(ev.raw_ready[0]));
    }
    for (uint64_t ordinal = 0; ordinal < tasks; ++ordinal) {
        const uint64_t row = core + ordinal / p.column_tiles * cores;
        const uint32_t start = ordinal % p.column_tiles * p.column_tile;
        const uint32_t n = p.width - start < p.column_tile ? p.width - start : p.column_tile;
        wait_flag(PIPE_MTE2, PIPE_V, ::event_t(ev.raw_ready[0]));
        {
            asc_bfloat162float(streams, raw, p.branches * p.column_tile);
            asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
        };
        // Raw BF16 storage is free as soon as Cast has consumed it. Fetch
        // the next column/row while this tile's FP32 arithmetic runs.
        if (ordinal + 1 < tasks) {
            set_flag(PIPE_V, PIPE_MTE2, ::event_t(ev.raw_reuse[0]));
            wait_flag(PIPE_V, PIPE_MTE2, ::event_t(ev.raw_reuse[0]));
            const uint64_t next = ordinal + 1;
            const uint64_t next_row = core + next / p.column_tiles * cores;
            const uint32_t next_start = next % p.column_tiles * p.column_tile;
            const uint32_t next_n =
                p.width - next_start < p.column_tile ? p.width - next_start : p.column_tile;
            load_rows(raw, (r + (next_row * p.branches * p.width + next_start)), p.branches, next_n,
                      p.width, p.column_tile);
            set_flag(PIPE_MTE2, PIPE_V, ::event_t(ev.raw_ready[0]));
        }
        pipe_barrier(PIPE_V);
        const uint32_t tile_elements = n;
        const uint64_t tile_mask =
            tile_elements >= kRepeatFloats ? UINT64_MAX : (uint64_t(1) << tile_elements) - 1;
        const uint8_t tile_repeats = (n) / kRepeatFloats;
        asc_set_vector_mask(0, tile_mask);
        float factor = initial ? 1.0f : coefficients[row * p.branches];
        asc_mul_scalar(total, streams, factor, tile_repeats, 1, 1, kRepeatBlocks, kRepeatBlocks);
        pipe_barrier(PIPE_V);
        if (!initial)
            for (uint32_t b = 1; b < p.branches; ++b) {
                factor = coefficients[row * p.branches + b];
                asc_axpy(total, (streams + (b * p.column_tile)), factor, tile_repeats, 1, 1,
                         kRepeatBlocks, kRepeatBlocks);
                pipe_barrier(PIPE_V);
            }
        // The previous row's output DMA may overlap the next raw load and
        // weighted arithmetic. It retires before rounded is written again.
        if (!start && ordinal)
            wait_flag(PIPE_MTE3, PIPE_V, ::event_t(ev.packed_reuse[0]));
        {
            asc_float2bfloat16_rn((rounded + (start)), total, n);
            asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
        };
        pipe_barrier(PIPE_V);
        if (start + n == p.width) {
            if (normalize)
                normalize_row(rounded, streams, work, scratch, stat, w, p.width, kInverseWidth, ev);
            {
                set_flag(PIPE_V, PIPE_MTE3, ::event_t(VectorEvents::store_ready));
                wait_flag(PIPE_V, PIPE_MTE3, ::event_t(VectorEvents::store_ready));
            }
            asc_copy_ub2gm_align((out + (row * p.width)), rounded, 1, p.width * sizeof(*(rounded)),
                                 0, 0, 0, 0);
            if (ordinal + 1 < tasks)
                set_flag(PIPE_MTE3, PIPE_V, ::event_t(ev.packed_reuse[0]));
        }
    }
    {
        set_flag(PIPE_MTE2, PIPE_S, ::event_t(VectorEvents::load_drained));
        wait_flag(PIPE_MTE2, PIPE_S, ::event_t(VectorEvents::load_drained));
        set_flag(PIPE_MTE3, PIPE_S, ::event_t(VectorEvents::store_drained));
        wait_flag(PIPE_MTE3, PIPE_S, ::event_t(VectorEvents::store_drained));
        set_flag(PIPE_V, PIPE_S, ::event_t(VectorEvents::scalar_read));
        wait_flag(PIPE_V, PIPE_S, ::event_t(VectorEvents::scalar_read));
    }
}
#elif defined(MHC_COLLAPSE)
__global__ __vector__ void mhc_collapse(GM_ADDR residual, GM_ADDR pre, GM_ADDR output, uint64_t rows) {
    constexpr const StateParams &p = kStatePlan;
    InitSocState();
    SetSaturationFlag<SaturationMode::FLOAT>(false); // IEEE Inf/NaN, as in the FP32 reference.
    VectorEvents ev;
    const uint32_t t = p.column_tile, b = p.branches;
    const uint32_t streams_offset = b * t * kBf16Bytes,
                   total_offset = streams_offset + b * t * kFp32Bytes;
    const uint32_t work_offset = total_offset + t * kFp32Bytes + kBankPhaseBytes;
    const uint32_t packed_offset = work_offset + t * kFp32Bytes + kBankPhaseBytes;
    auto raw = ub<bfloat16_t>(0);
    auto streams = ub<float>(streams_offset);
    auto total = ub<float>(total_offset), work = ub<float>(work_offset);
    auto packed = ub<bfloat16_t>(packed_offset);
    auto r = gm<bfloat16_t>(residual), out = gm<bfloat16_t>(output);
    auto coeff = gm<float>(pre);
    const uint64_t jobs = rows * p.column_tiles, cores = kWorkers, core = GetBlockIdx();
    const uint64_t tasks = jobs > core ? (jobs - core + cores - 1) / cores : 0;
    if (tasks) {
        uint64_t first = core / p.column_tiles;
        uint32_t start = core % p.column_tiles * t;
        const uint32_t n = p.width - start < t ? p.width - start : t;
        load_rows(raw, (r + (first * b * p.width + start)), b, n, p.width, t);
        set_flag(PIPE_MTE2, PIPE_V, ::event_t(ev.raw_ready[0]));
    }
    for (uint64_t ordinal = 0; ordinal < tasks; ++ordinal) {
        const uint64_t job = core + ordinal * cores, row = job / p.column_tiles;
        const uint32_t start = job % p.column_tiles * t,
                       n = p.width - start < t ? p.width - start : t, slot = ordinal % kSlots;
        wait_flag(PIPE_MTE2, PIPE_V, ::event_t(ev.raw_ready[0]));
        {
            asc_bfloat162float(streams, raw, b * t);
            asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
        };
        if (ordinal + 1 < tasks) {
            set_flag(PIPE_V, PIPE_MTE2, ::event_t(ev.raw_reuse[0]));
            wait_flag(PIPE_V, PIPE_MTE2, ::event_t(ev.raw_reuse[0]));
            const uint64_t next = job + cores, next_row = next / p.column_tiles;
            const uint32_t next_start = next % p.column_tiles * t,
                           next_n = p.width - next_start < t ? p.width - next_start : t;
            load_rows(raw, (r + (next_row * b * p.width + next_start)), b, next_n, p.width, t);
            set_flag(PIPE_MTE2, PIPE_V, ::event_t(ev.raw_ready[0]));
        }
        pipe_barrier(PIPE_V);
        const uint8_t tile_repeats = 1;
        asc_set_mask_count();
        asc_set_vector_mask(0, n);
        asc_mul_scalar(total, streams, coeff[row * b], tile_repeats, 1, 1, kRepeatBlocks,
                       kRepeatBlocks);
        pipe_barrier(PIPE_V);
        for (uint32_t source = 1; source < b; ++source) {
            asc_axpy(total, (streams + (source * t)), coeff[row * b + source], tile_repeats, 1, 1,
                     kRepeatBlocks, kRepeatBlocks);
            if (source + 1 < b)
                pipe_barrier(PIPE_V);
        }
        if (ordinal >= kSlots)
            wait_flag(PIPE_MTE3, PIPE_V, ::event_t(ev.packed_reuse[slot]));
        pipe_barrier(PIPE_V);
        {
            asc_float2bfloat16_rn((packed + (slot * t)), total, n);
            asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
        };
        set_flag(PIPE_V, PIPE_MTE3, ::event_t(ev.packed_ready[slot]));
        wait_flag(PIPE_V, PIPE_MTE3, ::event_t(ev.packed_ready[slot]));
        asc_copy_ub2gm_align((out + (row * p.width + start)), (packed + (slot * t)), 1,
                             n * sizeof(*((packed + (slot * t)))), 0, 0, 0, 0);
        if (ordinal + kSlots < tasks)
            set_flag(PIPE_MTE3, PIPE_V, ::event_t(ev.packed_reuse[slot]));
    }
    {
        set_flag(PIPE_MTE2, PIPE_S, ::event_t(VectorEvents::load_drained));
        wait_flag(PIPE_MTE2, PIPE_S, ::event_t(VectorEvents::load_drained));
        set_flag(PIPE_MTE3, PIPE_S, ::event_t(VectorEvents::store_drained));
        wait_flag(PIPE_MTE3, PIPE_S, ::event_t(VectorEvents::store_drained));
        set_flag(PIPE_V, PIPE_S, ::event_t(VectorEvents::scalar_read));
        wait_flag(PIPE_V, PIPE_S, ::event_t(VectorEvents::scalar_read));
    }
}
#elif defined(MHC_MEAN)
__aicore__ inline void compute_mean_panel(__ubuf__ bfloat16_t *raw, __ubuf__ float *total,
                                          __ubuf__ float *value, uint32_t b, uint32_t t, uint32_t n,
                                          bool release_raw, uint32_t slot, VectorEvents &ev) {
    {
        asc_bfloat162float(total, raw, n);
        asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
    };
    const uint32_t tile_elements = n;
    const uint64_t tile_mask =
        tile_elements >= kRepeatFloats ? UINT64_MAX : (uint64_t(1) << tile_elements) - 1;
    const uint8_t tile_repeats = (n) / kRepeatFloats;
    asc_set_vector_mask(0, tile_mask);
#pragma unroll
    for (uint32_t source = 1; source < kBranchCapacity; ++source) {
        if (source >= b)
            continue;
        {
            asc_bfloat162float(value, (raw + (source * t)), n);
            asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
        };
        if (source + 1 == b && release_raw)
            set_flag(PIPE_V, PIPE_MTE2, ::event_t(ev.raw_reuse[slot]));
        pipe_barrier(PIPE_V);
        asc_add(total, total, value, tile_repeats, 1, 1, 1, kRepeatBlocks, kRepeatBlocks,
                kRepeatBlocks);
        pipe_barrier(PIPE_V);
    }
    if (b == 1) {
        if (release_raw)
            set_flag(PIPE_V, PIPE_MTE2, ::event_t(ev.raw_reuse[slot]));
        pipe_barrier(PIPE_V);
    }
    asc_mul_scalar(total, total, 1.0f / b, tile_repeats, 1, 1, kRepeatBlocks, kRepeatBlocks);
}
__global__ __vector__ void mhc_mean(GM_ADDR residual, GM_ADDR output, uint32_t column, uint64_t rows) {
    constexpr const StateParams &p = kStatePlan;
    const uint64_t full_tasks = rows * kColumnTiles / kWorkers;
    const uint32_t extra_tasks = rows * kColumnTiles % kWorkers;
    InitSocState();
    SetSaturationFlag<SaturationMode::FLOAT>(false); // IEEE Inf/NaN, as in the FP32 reference.
    VectorEvents ev;
    const uint32_t t = p.column_tile, b = p.branches;
#if defined(MHC_MEAN_SINGLE_TILE)
    constexpr uint32_t slots = 1;
#else
    constexpr uint32_t slots = kSlots;
#endif
    const MeanLayout l(b, t, slots);
    auto raw = ub<bfloat16_t>(l.raw), packed = ub<bfloat16_t>(l.packed);
    auto total = ub<float>(l.total), value = ub<float>(l.value);
    auto r = gm<bfloat16_t>(residual), out = gm<bfloat16_t>(output);
#if defined(MHC_MEAN_SINGLE_TILE)
    const uint64_t job = GetBlockIdx(), row = job / p.column_tiles;
    const uint32_t start = job % p.column_tiles * t;
    const uint32_t n = p.width - start < t ? p.width - start : t;
    load_rows(raw, (r + (row * b * p.width + start)), b, n, p.width, t);
    {
        set_flag(PIPE_MTE2, PIPE_V, ::event_t(VectorEvents::loaded));
        wait_flag(PIPE_MTE2, PIPE_V, ::event_t(VectorEvents::loaded));
    }
    compute_mean_panel(raw, total, value, b, t, n, false, 0, ev);
    pipe_barrier(PIPE_V);
    {
        asc_float2bfloat16_rn(packed, total, n);
        asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
    };
    {
        set_flag(PIPE_V, PIPE_MTE3, ::event_t(VectorEvents::store_ready));
        wait_flag(PIPE_V, PIPE_MTE3, ::event_t(VectorEvents::store_ready));
    }
    asc_copy_ub2gm_align((out + ((row * p.output_columns + column) * p.width + start)), packed, 1,
                         n * sizeof(*(packed)), 0, 0, 0, 0);
#else
    const uint64_t core = GetBlockIdx(), cores = kWorkers,
                   tasks = full_tasks + (core < extra_tasks);
    for (uint64_t step = 0; step < tasks + kSlots; ++step) {
        const uint32_t slot = step % kSlots;
        if (step >= kSlots) {
            const uint64_t job = core + (step - kSlots) * cores, row = job / p.column_tiles;
            const uint32_t start = job % p.column_tiles * t,
                           n = p.width - start < t ? p.width - start : t;
            wait_flag(PIPE_V, PIPE_MTE3, ::event_t(ev.packed_ready[slot]));
            asc_copy_ub2gm_align((out + ((row * p.output_columns + column) * p.width + start)),
                                 (packed + (slot * t)), 1, n * sizeof(*((packed + (slot * t)))), 0,
                                 0, 0, 0);
            if (step < tasks)
                set_flag(PIPE_MTE3, PIPE_V, ::event_t(ev.packed_reuse[slot]));
        }
        if (step < tasks) {
            const uint64_t job = core + step * cores, row = job / p.column_tiles;
            const uint32_t start = job % p.column_tiles * t,
                           n = p.width - start < t ? p.width - start : t;
            if (step >= kSlots)
                wait_flag(PIPE_V, PIPE_MTE2, ::event_t(ev.raw_reuse[slot]));
            load_rows((raw + (slot * b * t)), (r + (row * b * p.width + start)), b, n, p.width, t);
            set_flag(PIPE_MTE2, PIPE_V, ::event_t(ev.raw_ready[slot]));
        }
        if (step >= 1 && step <= tasks) {
            const uint32_t compute_slot = (step - 1) % kSlots;
            const uint64_t job = core + (step - 1) * cores;
            const uint32_t start = job % p.column_tiles * t,
                           n = p.width - start < t ? p.width - start : t;
            wait_flag(PIPE_MTE2, PIPE_V, ::event_t(ev.raw_ready[compute_slot]));
            if (step >= 2)
                pipe_barrier(PIPE_V);
            compute_mean_panel((raw + (compute_slot * b * t)), total, value, b, t, n,
                               step + 1 < tasks, compute_slot, ev);
            if (step > kSlots)
                wait_flag(PIPE_MTE3, PIPE_V, ::event_t(ev.packed_reuse[compute_slot]));
            pipe_barrier(PIPE_V);
            {
                asc_float2bfloat16_rn((packed + (compute_slot * t)), total, n);
                asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
            };
            set_flag(PIPE_V, PIPE_MTE3, ::event_t(ev.packed_ready[compute_slot]));
        }
    }
#endif
    {
        set_flag(PIPE_MTE2, PIPE_S, ::event_t(VectorEvents::load_drained));
        wait_flag(PIPE_MTE2, PIPE_S, ::event_t(VectorEvents::load_drained));
        set_flag(PIPE_MTE3, PIPE_S, ::event_t(VectorEvents::store_drained));
        wait_flag(PIPE_MTE3, PIPE_S, ::event_t(VectorEvents::store_drained));
        set_flag(PIPE_V, PIPE_S, ::event_t(VectorEvents::scalar_read));
        wait_flag(PIPE_V, PIPE_S, ::event_t(VectorEvents::scalar_read));
    }
}
#else
// Both post entries share one arithmetic pipeline. The fused entry keeps the
// BF16 updated state visible, then BF16-rounds collapse before normalization.
#if defined(MHC_PEER_ATTN)
#define MHC_POST_ENTRY peer_attention_mhc
#elif defined(MHC_PEER_MOE)
#define MHC_POST_ENTRY peer_moe_mhc
#else
#define MHC_POST_ENTRY mhc_post
#endif
__global__ __vector__ void MHC_POST_ENTRY(GM_ADDR input, GM_ADDR residual,
#if defined(MHC_POST_COMBINE)
                                    GM_ADDR pre,
#endif
                                    GM_ADDR post, GM_ADDR comb,
#if defined(MHC_POST_COMBINE)
                                    GM_ADDR weight,
#endif
                                    GM_ADDR updated
#if defined(MHC_POST_COMBINE)
                                    ,
                                    GM_ADDR output
#endif
, uint64_t rows
#if defined(MHC_PEER_ATTN) || defined(MHC_PEER_MOE)
    , GM_ADDR peer_local, GM_ADDR peer_table, GM_ADDR peer_inverse, GM_ADDR peer_ids,
    GM_ADDR peer_weights, GM_ADDR peer_shared, uint32_t peer_rank, uint32_t peer_topk
#endif
) {
    constexpr const StateParams &p = kStatePlan;
    InitSocState();
    SetSaturationFlag<SaturationMode::FLOAT>(false); // IEEE Inf/NaN, as in the FP32 reference.
    VectorEvents ev;
    const uint32_t t = p.column_tile, b = p.branches;
#if defined(MHC_PEER_ATTN)
    const uint64_t peer_epoch = peer_attention::prepare(input, peer_local, peer_table, peer_rank, rows);
    auto peer_source = reinterpret_cast<__gm__ bfloat16_t *>(
        reinterpret_cast<__gm__ uint64_t *>(peer_table)[1 - peer_rank] + peer_all_reduce::kControlBytes);
    pipe_barrier(PIPE_ALL);
#elif defined(MHC_PEER_MOE)
    peer_moe::View peer_view(peer_local, peer_table, peer_rank, rows);
    peer_moe::publish_partial<true>(peer_view, input, peer_inverse, peer_ids, peer_weights, peer_topk);
    peer_moe::reduce_owned(peer_view, peer_shared);
    pipe_barrier(PIPE_ALL);
#endif
    const PostLayout l(b, p.width, t);
    auto raw = ub<bfloat16_t>(l.raw), rawx = ub<bfloat16_t>(l.rawx),
         packed = ub<bfloat16_t>(l.packed);
    auto streams = ub<float>(l.streams), value = ub<float>(l.value), total = ub<float>(l.total);
    auto work = ub<float>(l.work), mixed = ub<float>(l.mixed), rounded = ub<float>(l.rounded);
    auto collapsed = ub<bfloat16_t>(l.collapsed);
    auto w = ub<float>(l.weight);
    auto scratch = ub<float>(l.scratch), stat = ub<float>(l.stat);
    auto coeffcache = ub<float>(l.coefficients), precache = ub<float>(l.pre),
         postcache = ub<float>(l.post);
    auto x = gm<bfloat16_t>(input), r = gm<bfloat16_t>(residual), u = gm<bfloat16_t>(updated);
    bool pending = false;
#if defined(MHC_POST_COMBINE)
    bool collapsed_pending = false;
    asc_copy_gm2ub_align(w, gm<float>(weight), 1, p.width * sizeof(*(w)), 0, 0, 0, 0);
    {
        set_flag(PIPE_MTE2, PIPE_V, ::event_t(VectorEvents::loaded));
        wait_flag(PIPE_MTE2, PIPE_V, ::event_t(VectorEvents::loaded));
    }
    const uint64_t jobs = rows;
#else
    const uint64_t jobs = rows * p.column_tiles;
#endif
    for (uint64_t job = GetBlockIdx(); job < jobs; job += kWorkers) {
#if defined(MHC_POST_COMBINE)
        const uint64_t row = job;
        const uint32_t first = 0, last = p.width;
#else
        const uint64_t row = job / p.column_tiles;
        const uint32_t first = job % p.column_tiles * t,
                       last = first + t < p.width ? first + t : p.width;
#endif
        {
            set_flag(PIPE_V, PIPE_MTE2, ::event_t(VectorEvents::raw_free));
            wait_flag(PIPE_V, PIPE_MTE2, ::event_t(VectorEvents::raw_free));
        }
        asc_copy_gm2ub_align(coeffcache, (gm<float>(comb) + (row * b * b)), 1,
                             b * b * sizeof(*(coeffcache)), 0, 0, 0, 0);
        asc_copy_gm2ub_align(postcache, (gm<float>(post) + (row * b)), 1, b * sizeof(*(postcache)),
                             0, 0, 0, 0);
#if defined(MHC_POST_COMBINE)
        asc_copy_gm2ub_align(precache, (gm<float>(pre) + (row * b)), 1, b * sizeof(*(precache)), 0,
                             0, 0, 0);
#endif
        // Coefficients and the first input panel have disjoint UB owners;
        // one import stage and readiness event covers both DMA groups.
#if defined(MHC_PEER_MOE)
        const uint32_t peer_owner = peer_view.owner(row);
        peer_protocol::await(peer_protocol::signal(peer_view.region(peer_owner), 3,
            (row % peer_view.shard_rows) % peer_all_reduce::kWorkers), peer_view.epoch);
        set_flag(PIPE_S, PIPE_MTE2, EVENT_ID0);
        wait_flag(PIPE_S, PIPE_MTE2, EVENT_ID0);
#endif
        const uint32_t first_n = p.width - first < t ? p.width - first : t;
#if !defined(MHC_PEER_ATTN) && !defined(MHC_PEER_MOE)
        load_rows(raw, (r + (row * b * p.width + first)), b, first_n, p.width, t);
        asc_copy_gm2ub_align(rawx, (x + (row * p.width + first)), 1, first_n * sizeof(*(rawx)), 0,
                             0, 0, 0);
        set_flag(PIPE_MTE2, PIPE_V, ::event_t(ev.raw_ready[0]));
#endif
        for (uint32_t start = first; start < last; start += t) {
            const uint32_t n = p.width - start < t ? p.width - start : t;
#if defined(MHC_PEER_ATTN) || defined(MHC_PEER_MOE)
            set_flag(PIPE_V, PIPE_MTE2, ::event_t(ev.raw_reuse[0]));
            wait_flag(PIPE_V, PIPE_MTE2, ::event_t(ev.raw_reuse[0]));
            load_rows(raw, r + row * b * p.width + start, b, n, p.width, t);
#if defined(MHC_PEER_ATTN)
            asc_copy_gm2ub(rawx, x + row * p.width + start, n * 2);
            asc_copy_gm2ub(reinterpret_cast<__ubuf__ bfloat16_t *>(work),
                           peer_source + row * p.width + start, n * 2);
#else
            const uint32_t owner = peer_view.owner(row);
            asc_copy_gm2ub(rawx, peer_view.returned(owner) +
                           (row % peer_view.shard_rows) * p.width + start, n * 2);
#endif
            set_flag(PIPE_MTE2, PIPE_V, ::event_t(ev.raw_ready[0]));
#endif
            wait_flag(PIPE_MTE2, PIPE_V, ::event_t(ev.raw_ready[0]));
            {
                asc_bfloat162float(streams, raw, b * t);
                asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
            };
            {
                asc_bfloat162float(value, rawx, n);
#if defined(MHC_PEER_ATTN)
                asc_bfloat162float(total, reinterpret_cast<__ubuf__ bfloat16_t *>(work), n);
                pipe_barrier(PIPE_V);
                asc_add(value, value, total, n);
                pipe_barrier(PIPE_V);
                asc_float2bfloat16_rn(rawx, value, n);
                pipe_barrier(PIPE_V);
                asc_bfloat162float(value, rawx, n);
#endif
                asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
            };
            if (start == first) {
                set_flag(PIPE_V, PIPE_S, ::event_t(VectorEvents::scalar_read));
                wait_flag(PIPE_V, PIPE_S, ::event_t(VectorEvents::scalar_read));
            }
            // Raw input can be refilled after both casts, independently of
            // the FP32 destinations and packed updated-state DMA below.
            if (start + t < last) {
#if !defined(MHC_PEER_ATTN) && !defined(MHC_PEER_MOE)
                set_flag(PIPE_V, PIPE_MTE2, ::event_t(ev.raw_reuse[0]));
                wait_flag(PIPE_V, PIPE_MTE2, ::event_t(ev.raw_reuse[0]));
                const uint32_t next = start + t;
                const uint32_t next_n = p.width - next < t ? p.width - next : t;
                load_rows(raw, (r + (row * b * p.width + next)), b, next_n, p.width, t);
                asc_copy_gm2ub_align(rawx, (x + (row * p.width + next)), 1,
                                     next_n * sizeof(*(rawx)), 0, 0, 0, 0);
                set_flag(PIPE_MTE2, PIPE_V, ::event_t(ev.raw_ready[0]));
#endif
            }
            pipe_barrier(PIPE_V);
#if defined(MHC_POST_COMBINE)
            const uint8_t tile_repeats = 1;
            asc_set_mask_count();
            asc_set_vector_mask(0, n);
#else
            const uint32_t tile_elements = n;
            const uint64_t tile_mask =
                tile_elements >= kRepeatFloats ? UINT64_MAX : (uint64_t(1) << tile_elements) - 1;
            const uint8_t tile_repeats = (n) / kRepeatFloats;
            asc_set_vector_mask(0, tile_mask);
#endif
#pragma unroll 2
            for (uint32_t dest = 0; dest < b; ++dest) {
#if defined(MHC_POST_COMBINE)
                uint32_t source = 0;
                constexpr uint32_t packet = 4; // Scalar preload/code-size budget.
                for (; source + packet <= b; source += packet)
                    accumulate_source_packet(total, streams, coeffcache, source, b, t, dest);
                uint32_t stream_offset = source * t, coefficient_offset = source * b + dest;
                for (; source < b; ++source) {
                    const float factor = coeffcache[coefficient_offset];
                    if (source == 0)
                        asc_mul_scalar(total, (streams + (stream_offset)), factor, tile_repeats, 1,
                                       1, kRepeatBlocks, kRepeatBlocks);
                    else
                        asc_axpy(total, (streams + (stream_offset)), factor, tile_repeats, 1, 1,
                                 kRepeatBlocks, kRepeatBlocks);
                    pipe_barrier(PIPE_V);
                    stream_offset += t;
                    coefficient_offset += b;
                }
#else
                asc_mul_scalar(total, streams, coeffcache[dest], tile_repeats, 1, 1, kRepeatBlocks,
                               kRepeatBlocks);
                pipe_barrier(PIPE_V);
#pragma unroll 4
                for (uint32_t source = 1; source < b; ++source) {
                    asc_mul_scalar(work, (streams + (source * t)), coeffcache[source * b + dest],
                                   tile_repeats, 1, 1, kRepeatBlocks, kRepeatBlocks);
                    pipe_barrier(PIPE_V);
                    asc_add(total, total, work, tile_repeats, 1, 1, 1, kRepeatBlocks, kRepeatBlocks,
                            kRepeatBlocks);
                    pipe_barrier(PIPE_V);
                }
#endif
#if defined(MHC_POST_COMBINE)
                asc_axpy(total, value, postcache[dest], tile_repeats, 1, 1, kRepeatBlocks,
                         kRepeatBlocks);
                pipe_barrier(PIPE_V);
#else
                asc_mul_scalar(work, value, postcache[dest], tile_repeats, 1, 1, kRepeatBlocks,
                               kRepeatBlocks);
                pipe_barrier(PIPE_V);
                asc_add(total, total, work, tile_repeats, 1, 1, 1, kRepeatBlocks, kRepeatBlocks,
                        kRepeatBlocks);
                pipe_barrier(PIPE_V);
#endif
                if (pending)
                    wait_flag(PIPE_MTE3, PIPE_V, ::event_t(ev.packed_reuse[0]));
#if defined(MHC_POST_COMBINE)
                asc_float2bfloat16_rn(packed, total, 1, 1, 1, kRepeatBlocks / 2, kRepeatBlocks);
#else
                {
                    asc_float2bfloat16_rn(packed, total, n);
                    asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
                };
#endif
                pipe_barrier(PIPE_V);
                {
                    set_flag(PIPE_V, PIPE_MTE3, ::event_t(VectorEvents::store_ready));
                    wait_flag(PIPE_V, PIPE_MTE3, ::event_t(VectorEvents::store_ready));
                }
                asc_copy_ub2gm_align((u + ((row * b + dest) * p.width + start)), packed, 1,
                                     n * sizeof(*(packed)), 0, 0, 0, 0);
                set_flag(PIPE_MTE3, PIPE_V, ::event_t(ev.packed_reuse[0]));
                pending = true;
#if defined(MHC_POST_COMBINE)
                asc_bfloat162float(rounded, packed, 1, 1, 1, kRepeatBlocks, kRepeatBlocks / 2);
                pipe_barrier(PIPE_V);
                if (!dest)
                    asc_mul_scalar(mixed, rounded, precache[dest], tile_repeats, 1, 1,
                                   kRepeatBlocks, kRepeatBlocks);
                else
                    asc_axpy(mixed, rounded, precache[dest], tile_repeats, 1, 1, kRepeatBlocks,
                             kRepeatBlocks);
                pipe_barrier(PIPE_V);
#endif
            }
#if defined(MHC_POST_COMBINE)
            if (!start && collapsed_pending) {
                wait_flag(PIPE_MTE3, PIPE_V, ::event_t(ev.packed_reuse[1]));
                collapsed_pending = false;
            }
            asc_float2bfloat16_rn((collapsed + (start)), mixed, 1, 1, 1, kRepeatBlocks / 2,
                                  kRepeatBlocks);
            pipe_barrier(PIPE_V);
            if (t * 2 == p.width) {
                asc_bfloat162float(rounded, (collapsed + (start)), 1, 1, 1, kRepeatBlocks,
                                   kRepeatBlocks / 2);
                pipe_barrier(PIPE_V);
                asc_mul(work, rounded, rounded, tile_repeats, 1, 1, 1, kRepeatBlocks, kRepeatBlocks,
                        kRepeatBlocks);
                pipe_barrier(PIPE_V);
                asc_set_mask_norm();
                reduce_r64((stat + (start / t * kBlockFloats)), work, scratch, n);
            }
#endif
        }
#if defined(MHC_POST_COMBINE)
        // Reuse the rounded FP32 arena when it can hold a norm panel;
        // its bank phase keeps the two multiplicands independent of work.
        asc_set_mask_norm();
        auto norm_value = t >= p.width / 2 ? rounded : value;
        normalize_post_halves(collapsed, norm_value, work, scratch, stat, w, p.width, kInverseWidth,
                              ev, t * 2 == p.width, output + row * p.width * kBf16Bytes);
        // Output DMA may overlap the next row's coefficient/input import
        // and update arithmetic. Its reader releases collapsed before that
        // row writes its first collapsed panel, using an independent ID.
        set_flag(PIPE_MTE3, PIPE_V, ::event_t(ev.packed_reuse[1]));
        collapsed_pending = true;
#endif
    }
    if (pending)
        wait_flag(PIPE_MTE3, PIPE_V, ::event_t(ev.packed_reuse[0]));
#if defined(MHC_POST_COMBINE)
    if (collapsed_pending)
        wait_flag(PIPE_MTE3, PIPE_V, ::event_t(ev.packed_reuse[1]));
#endif
    {
        set_flag(PIPE_MTE2, PIPE_S, ::event_t(VectorEvents::load_drained));
        wait_flag(PIPE_MTE2, PIPE_S, ::event_t(VectorEvents::load_drained));
        set_flag(PIPE_MTE3, PIPE_S, ::event_t(VectorEvents::store_drained));
        wait_flag(PIPE_MTE3, PIPE_S, ::event_t(VectorEvents::store_drained));
        set_flag(PIPE_V, PIPE_S, ::event_t(VectorEvents::scalar_read));
        wait_flag(PIPE_V, PIPE_S, ::event_t(VectorEvents::scalar_read));
    }
#if defined(MHC_PEER_ATTN)
    peer_protocol::finish(peer_local, peer_epoch);
#elif defined(MHC_PEER_MOE)
    peer_view.finish();
#endif
}
#endif
