// DSpark verification budget. FP32 sequential survival, exact lexicographic ties.
// Ascend C 910B: vector rank scans; each block owns complete 32-byte row groups.
#include <common/device.h>
#include <kernel_operator.h>
#include <c_api/asc_simd.h>
#include <dspark_schedule/launch.h>
using namespace AscendC;

// A row group owns a complete DMA block of FP32 output; no cache-line writes
// overlap between workers. Capacities tile arbitrary runtime rows and gamma.
static_assert(dspark_schedule::kDataBlockBytes == ONE_BLK_SIZE);
constexpr uint32_t kRequestGroup = dspark_schedule::kRequestGroup;
constexpr uint32_t kPrefixColumns = ONE_REPEAT_BYTE_SIZE / (2 * sizeof(float));
constexpr uint32_t kSelectScalarBytes = ONE_BLK_SIZE * sizeof(float);
static_assert(AscendC::TMP_UB_OFFSET + kSelectScalarBytes <= AscendC::TOTAL_UB_SIZE);
constexpr uint32_t kRankTile = ONE_REPEAT_BYTE_SIZE; // one byte-mask block, 4 FP32 repeats

#if defined(DSPARK_SCHEDULE_PREPARE)
__global__ __aicore__ void dspark_prepare_kernel(GM_ADDR confidence, GM_ADDR survival, float eps, int64_t rows) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    InitSocState();
    constexpr int64_t gamma = DSPARK_SCHEDULE_GAMMA;
    constexpr int64_t columns = DSPARK_SCHEDULE_COLUMNS;
    const int64_t stride = (rows + kRequestGroup - 1) / kRequestGroup * kRequestGroup;

    constexpr uint32_t kPayloadElements = kRequestGroup * kPrefixColumns;
    constexpr uint32_t kOutputOffset = kPayloadElements * sizeof(float);
    auto input = reinterpret_cast<__ubuf__ float *>(uint64_t(0));
    auto output = reinterpret_cast<__ubuf__ float *>(uint64_t(kOutputOffset));
    __gm__ float *x, *y;
    x = reinterpret_cast<__gm__ float *>((__gm__ float *)confidence);
    y = reinterpret_cast<__gm__ float *>((__gm__ float *)survival);
    constexpr TEventID ls = 0; // one immediately consumed token on this pipe pair
    constexpr TEventID sl = 0; // one immediately consumed token on this pipe pair
    constexpr TEventID sm = 0; // one immediately consumed token on this pipe pair
    constexpr TEventID ms = 0; // one immediately consumed token on this pipe pair
    constexpr float kNegativeInfinity = -__builtin_inff();
    for (int64_t group = GetBlockIdx(); group < stride / kRequestGroup;
         group += DSPARK_SCHEDULE_WORKERS) {
        int64_t first = group * kRequestGroup;
        float running[kRequestGroup];
        for (uint32_t r = 0; r < kRequestGroup; ++r)
            running[r] = 1.0f;
        for (int64_t start = 0; start < columns; start += kPrefixColumns) {
            uint32_t n = (columns - start < kPrefixColumns) ? columns - start : kPrefixColumns;
            for (uint32_t r = 0; r < kRequestGroup; ++r) {
                if (first + r < rows) {
                    asc_copy_gm2ub_align(
                        reinterpret_cast<__ubuf__ uint8_t *>((input + (r * kPrefixColumns))),
                        reinterpret_cast<__gm__ uint8_t *>((x + ((first + r) * gamma + start))), 1,
                        n * uint32_t(sizeof(float)), 0, 0, 0, 0);
                }
            }
            native_device::pipe_fence<PIPE_MTE2, PIPE_S, ls>();
            for (uint32_t r = 0; r < kRequestGroup; ++r) {
                for (uint32_t c = 0; c < n; ++c) {
                    float value = kNegativeInfinity;
                    if (first + r < rows) {
                        // One FP32 multiply per prefix step, matching NPU Cumprod.
                        running[r] = running[r] * input[r * kPrefixColumns + c];
                        if (running[r] >= eps)
                            value = running[r];
                    }
                    output[c * kRequestGroup + r] = value;
                }
            }
            native_device::pipe_fence<PIPE_S, PIPE_MTE2, sl>();
            native_device::pipe_fence<PIPE_S, PIPE_MTE3, sm>();
            for (uint32_t c = 0; c < n; ++c) {
                asc_copy_ub2gm((y + ((start + c) * stride + first)), (output + (c * kRequestGroup)),
                               uint32_t((kRequestGroup) * sizeof(float)));
            }
            native_device::pipe_fence<PIPE_MTE3, PIPE_S, ms>();
        }
    }
    constexpr TEventID kInputDrained = 0;
    native_device::pipe_fence<PIPE_MTE2, PIPE_S, kInputDrained>();
}

#else
__global__ __aicore__ void dspark_finish_kernel(GM_ADDR survival, GM_ADDR verify_lens,
                                                int64_t budget, int64_t minimum, int64_t maximum, int64_t rows) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    InitSocState();
    constexpr int64_t gamma = DSPARK_SCHEDULE_GAMMA;
    constexpr int64_t columns = DSPARK_SCHEDULE_COLUMNS;
    const int64_t stride = (rows + kRequestGroup - 1) / kRequestGroup * kRequestGroup;

    constexpr uint32_t kVectorBytes = kRankTile * sizeof(float);
    constexpr uint32_t kValuesOffset = 0;
    constexpr uint32_t kFlagsOffset = kValuesOffset + kVectorBytes;
    constexpr uint32_t kEqualOffset = kFlagsOffset + kVectorBytes;
    constexpr uint32_t kPrefixOffset = kEqualOffset + kVectorBytes;
    constexpr uint32_t kOnesOffset = kPrefixOffset + kVectorBytes;
    constexpr uint32_t kMaskOffset = kOnesOffset + kVectorBytes;
    constexpr uint32_t kReducedOffset = kMaskOffset + kRankTile / 8;
    constexpr uint32_t kScratchOffset = kReducedOffset + ONE_REPEAT_BYTE_SIZE;
    constexpr uint32_t kResultOffset = kScratchOffset + kVectorBytes;
    auto select_scalar = reinterpret_cast<__ubuf__ float *>(uint64_t(AscendC::TMP_UB_OFFSET));
    auto values = reinterpret_cast<__ubuf__ float *>(uint64_t(kValuesOffset));
    auto flags = reinterpret_cast<__ubuf__ float *>(uint64_t(kFlagsOffset));
    auto equal = reinterpret_cast<__ubuf__ float *>(uint64_t(kEqualOffset));
    auto prefix = reinterpret_cast<__ubuf__ float *>(uint64_t(kPrefixOffset));
    auto ones = reinterpret_cast<__ubuf__ float *>(uint64_t(kOnesOffset));
    auto mask = reinterpret_cast<__ubuf__ uint8_t *>(uint64_t(kMaskOffset));
    auto reduced = reinterpret_cast<__ubuf__ float *>(uint64_t(kReducedOffset));
    auto result = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(kResultOffset));
    __gm__ float *scores;
    __gm__ int32_t *output;
    scores = reinterpret_cast<__gm__ float *>((__gm__ float *)survival);
    output = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)verify_lens);
    constexpr TEventID lv = 0; // one immediately consumed token on this pipe pair
    constexpr TEventID vl = 0; // one immediately consumed token on this pipe pair
    constexpr TEventID vs = 0; // one immediately consumed token on this pipe pair
    constexpr TEventID sm = 0; // one immediately consumed token on this pipe pair
    constexpr TEventID ms = 0; // one immediately consumed token on this pipe pair
    const int64_t count = columns * stride;
    constexpr float kNegativeInfinity = -__builtin_inff();
    asc_duplicate(ones, 1.0f, kRankTile);
    if (count < kRankTile)
        asc_duplicate((values + (count)), kNegativeInfinity, uint32_t(kRankTile - count));
    pipe_barrier(PIPE_V);
    if (count < kRankTile) {
        // One imported rank tile always overwrites the same valid prefix.
        // Its inactive suffix remains -inf across every candidate comparison;
        // initialize it once rather than clearing the whole tile per scan.
        native_device::pipe_fence<PIPE_V, PIPE_MTE2, vl>();
    }
    for (int64_t group = GetBlockIdx(); group < (rows + kRequestGroup - 1) / kRequestGroup;
         group += DSPARK_SCHEDULE_WORKERS) {
        int64_t first = group * kRequestGroup;
        uint32_t actual = (rows - first < kRequestGroup) ? rows - first : kRequestGroup;
        for (uint32_t r = 0; r < actual; ++r) {
            int64_t selected = 0;
            if (budget > 0) {
                for (int64_t position = 0; position < columns; ++position) {
                    int64_t own_index = position * stride + first + r;
                    float own = scores[own_index];
                    if (!(own > kNegativeInfinity))
                        continue; // Invalid NaN/threshold/padded candidates.
                    int64_t rank = 0;
                    for (int64_t start = 0; start < count && rank < budget; start += kRankTile) {
                        uint32_t n = (count - start < kRankTile) ? count - start : kRankTile;
                        if (n < kRankTile && count > kRankTile) {
                            // A streamed full tile overwrote this suffix, so
                            // restore only its inactive lanes before the tail.
                            asc_duplicate((values + (n)), kNegativeInfinity, kRankTile - n);
                            pipe_barrier(PIPE_V);
                            native_device::pipe_fence<PIPE_V, PIPE_MTE2, vl>();
                        }
                        asc_copy_gm2ub(
                            values, (scores + (start)),
                            uint32_t((n) * sizeof(float))); // n and addresses are 32B aligned.
                        native_device::pipe_fence<PIPE_MTE2, PIPE_V, lv>();
                        int64_t before = own_index - start;
                        asc_set_mask_norm();
                        asc_set_vector_mask(0, ~uint64_t(0));
                        if (before >= kRankTile)
                            asc_ge_scalar(
                                mask, values, own,
                                uint8_t(kRankTile / (ONE_REPEAT_BYTE_SIZE / sizeof(float))), 1, 1,
                                8, 8);
                        else
                            asc_gt_scalar(
                                mask, values, own,
                                uint8_t(kRankTile / (ONE_REPEAT_BYTE_SIZE / sizeof(float))), 1, 1,
                                8, 8);
                        pipe_barrier(PIPE_V);
                        {
                            asc_set_mask_count();
                            asc_set_vector_mask(0, ONE_BLK_SIZE);
                            asc_duplicate(select_scalar, 0.0f, uint8_t(1), 1, 8);
                            pipe_barrier(PIPE_V);
                            asc_set_cmp_mask(select_scalar);
                            pipe_barrier(PIPE_V);
                            asc_set_vector_mask(0, kRankTile);
                            if ASCEND_IS_AIV {
                                vsel(flags, ones, mask, 1, 1, 1, 1, 8, 8, 8,
                                     uint8_t(SELMODE::VSEL_TENSOR_SCALAR_MODE));
                            }
                            asc_set_vector_mask(~uint64_t(0), ~uint64_t(0));
                            asc_set_mask_norm();
                        };
                        pipe_barrier(PIPE_V);
                        if (before > 0 && before < kRankTile) {
                            asc_eq_scalar(
                                mask, values, own,
                                uint8_t(kRankTile / (ONE_REPEAT_BYTE_SIZE / sizeof(float))), 1, 1,
                                8, 8);
                            pipe_barrier(PIPE_V);
                            {
                                asc_set_mask_count();
                                asc_set_vector_mask(0, ONE_BLK_SIZE);
                                asc_duplicate(select_scalar, 0.0f, uint8_t(1), 1, 8);
                                pipe_barrier(PIPE_V);
                                asc_set_cmp_mask(select_scalar);
                                pipe_barrier(PIPE_V);
                                asc_set_vector_mask(0, kRankTile);
                                if ASCEND_IS_AIV {
                                    vsel(equal, ones, mask, 1, 1, 1, 1, 8, 8, 8,
                                         uint8_t(SELMODE::VSEL_TENSOR_SCALAR_MODE));
                                }
                                asc_set_vector_mask(~uint64_t(0), ~uint64_t(0));
                                asc_set_mask_norm();
                            };
                            asc_duplicate(prefix, 0.0f, kRankTile);
                            pipe_barrier(PIPE_V);
                            asc_duplicate(prefix, 1.0f, static_cast<uint32_t>(before));
                            pipe_barrier(PIPE_V);
                            asc_mul(equal, equal, prefix, kRankTile);
                            pipe_barrier(PIPE_V);
                            asc_add(flags, flags, equal, kRankTile);
                            pipe_barrier(PIPE_V);
                        }
                        asc_set_mask_count();
                        asc_set_vector_mask(0, kRankTile);
                        if ASCEND_IS_AIV {
                            vcadd(reduced, flags, 1, DEFAULT_REDUCE_DST_REP_STRIDE,
                                  DEFAULT_BLK_STRIDE, DEFAULT_REPEAT_STRIDE,
                                  true); // same accumulator reduction as SDK
                        }
                        pipe_barrier(PIPE_V);
                        native_device::pipe_fence<PIPE_V, PIPE_S, vs>();
                        rank += static_cast<int64_t>(GetReduceRepeatSumSpr<float>());
                        asc_set_mask_norm();
                        asc_set_vector_mask(uint64_t(-1), uint64_t(-1));
                        native_device::pipe_fence<PIPE_V, PIPE_MTE2, vl>();
                    }
                    if (rank < budget)
                        ++selected;
                }
            }
            int64_t length = minimum + selected;
            int64_t lower = minimum > 1 ? minimum : 1;
            length = length < lower ? lower : length;
            length = length > maximum ? maximum : length;
            result[r] = static_cast<int32_t>(length);
        }
        native_device::pipe_fence<PIPE_S, PIPE_MTE3, sm>();
        asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((output + (first))),
                             reinterpret_cast<__ubuf__ uint8_t *>(result), 1,
                             actual * uint32_t(sizeof(int32_t)), 0, 0, 0, 0);
        native_device::pipe_fence<PIPE_MTE3, PIPE_S, ms>();
    }
    constexpr TEventID kInputDrained = 0;
    native_device::pipe_fence<PIPE_MTE2, PIPE_S, kInputDrained>();
}

#endif
