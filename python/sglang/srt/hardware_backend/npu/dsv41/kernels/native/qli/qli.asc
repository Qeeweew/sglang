// Project-owned 910B INT8 lightning indexer. The numerical contract is checked
// against the independent Python reference; no vendor kernel is included.
#include <kernel_operator.h>
#if QLI_MERGE
#include <qli/merge_pipeline.h>
extern "C" __global__ __aicore__ void qli_rank_merge(qli::Sources args) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    AscendC::InitSocState();
    AscendC::SetSaturationFlag<AscendC::SaturationMode::FLOAT>(false);
    qli::MergePipeline pipeline(args);
    pipeline.run();
}
#else
#include <qli/cube_pipeline.h>
#include <qli/vector_pipeline.h>
extern "C" __global__ __aicore__ void qli_score(qli::Sources args) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    AscendC::InitSocState();
    AscendC::SetSaturationFlag<AscendC::SaturationMode::FLOAT>(false);
    if ASCEND_IS_AIC {
        qli::CubePipeline pipeline(args, AscendC::GetBlockIdx());
        pipeline.run();
    }
    if ASCEND_IS_AIV {
        qli::VectorPipeline pipeline(args, AscendC::GetBlockIdx() / 2,
                                            AscendC::GetSubBlockIdx());
        pipeline.run();
    }
}
#endif
