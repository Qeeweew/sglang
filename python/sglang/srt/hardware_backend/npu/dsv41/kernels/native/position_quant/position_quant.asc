// Ascend C / arch2201. Bind-stable geometry and actual workers are constexpr.
#include <common/device.h>
#include <kernel_operator.h>
#include <position_quant/params.h>
#include <position_quant/arena.h>
using namespace AscendC;
namespace {
constexpr int64_t kWorkers = POSITION_QUANT_WORKERS;
}
#if defined(POSITION_QUANT_ROPE)
#include <position_quant/rope.h>
#elif defined(POSITION_QUANT_GATHER)
__global__ __aicore__ void rope_cache_gather_kernel(GM_ADDR cos_cache, GM_ADDR sin_cache,
                                                    GM_ADDR positions, GM_ADDR input_slots,
                                                    GM_ADDR cos_out, GM_ADDR sin_out,
                                                    GM_ADDR valid_out, GM_ADDR slots_out, int64_t rows) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    using namespace position_quant;
    using Arena = GatherArena;
    constexpr int64_t cache_rows = POSITION_QUANT_BOUND;
    constexpr uint32_t trig_columns = POSITION_QUANT_DIM;
    auto c = reinterpret_cast<__ubuf__ float *>(uint64_t(Arena::cosine));
    auto s = c + Arena::trig_columns;
    auto mask = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(Arena::mask));
    auto slots = reinterpret_cast<__ubuf__ int64_t *>(uint64_t(Arena::slots));
    __gm__ float *cc, *sc, *co, *so;
    __gm__ int64_t *pos, *si, *os;
    __gm__ int32_t *valid;
    cc = (__gm__ float *)cos_cache;
    sc = (__gm__ float *)sin_cache;
    co = (__gm__ float *)cos_out;
    so = (__gm__ float *)sin_out;
    pos = (__gm__ int64_t *)positions;
    si = (__gm__ int64_t *)input_slots;
    os = (__gm__ int64_t *)slots_out;
    valid = (__gm__ int32_t *)valid_out;
    constexpr TEventID dm = 0, md = 0, vm = 0, mv = 0, sm = 0;
    for (int64_t group = GetBlockIdx(); group < (rows + kGatherGroupRows - 1) / kGatherGroupRows;
         group += kWorkers) {
        int64_t first = group * kGatherGroupRows;
        uint32_t n = rows - first < kGatherGroupRows ? rows - first : kGatherGroupRows;
        for (uint32_t j = 0; j < n; ++j) {
            int64_t row = first + j, p = pos[row];
            bool ok = p >= 0 && p < cache_rows;
            mask[j] = ok ? 1 : 0;
            if constexpr (POSITION_QUANT_WITH_SLOTS)
                slots[j] = ok ? si[row] : int64_t(-1);
            if (ok) {
                asc_copy_gm2ub(c, (cc + (p * trig_columns)),
                               uint32_t((trig_columns) * sizeof(float)));
                asc_copy_gm2ub(s, (sc + (p * trig_columns)),
                               uint32_t((trig_columns) * sizeof(float)));
                native_device::pipe_fence<PIPE_MTE2, PIPE_MTE3, dm>();
            } else {
                asc_duplicate(c, 1.0f, trig_columns);
                asc_duplicate(s, 0.0f, trig_columns);
                pipe_barrier(PIPE_V);
                native_device::pipe_fence<PIPE_V, PIPE_MTE3, vm>();
            }
            asc_copy_ub2gm((co + (row * trig_columns)), c,
                           uint32_t((trig_columns) * sizeof(float)));
            asc_copy_ub2gm((so + (row * trig_columns)), s,
                           uint32_t((trig_columns) * sizeof(float)));
            native_device::pipe_fence<PIPE_MTE3, PIPE_MTE2, md>();
            native_device::pipe_fence<PIPE_MTE3, PIPE_V, mv>();
        }
        // mask/slots have Scalar producers. Retire the metadata DMA back
        // to Scalar before the next group may overwrite either staging span.
        native_device::pipe_fence<PIPE_S, PIPE_MTE3, sm>();
        asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((valid + (first))),
                             reinterpret_cast<__ubuf__ uint8_t *>(mask), 1,
                             n * uint32_t(sizeof(int32_t)), 0, 0, 0, 0);
        if constexpr (POSITION_QUANT_WITH_SLOTS)
            asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((os + (first))),
                                 reinterpret_cast<__ubuf__ uint8_t *>(slots), 1,
                                 n * uint32_t(sizeof(int64_t)), 0, 0, 0, 0);
        native_device::pipe_fence<PIPE_MTE3, PIPE_S, sm>();
    }
    native_device::pipe_fence<PIPE_V, PIPE_S, kTailDrainEvent>();
    native_device::pipe_fence<PIPE_MTE2, PIPE_S, kTailDrainEvent>();
    native_device::pipe_fence<PIPE_MTE3, PIPE_S, kTailDrainEvent>();
}
#elif defined(POSITION_QUANT_SCATTER_BF16) || defined(POSITION_QUANT_SCATTER_INT8)
#if defined(POSITION_QUANT_SCATTER_INT8)
using T = int8_t;
#else
using T = bfloat16_t;
#endif
__global__ __aicore__ void scatter_kernel(GM_ADDR values, GM_ADDR scales, GM_ADDR slots,
                                          GM_ADDR cache, GM_ADDR cache_scales, int64_t rows) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    using namespace position_quant;
    constexpr int64_t capacity = POSITION_QUANT_BOUND;
    constexpr uint32_t dim = POSITION_QUANT_DIM;
    constexpr uint32_t payload_bytes = kWidthCapacityElements * sizeof(T);
    auto tmp = reinterpret_cast<__ubuf__ T *>(uint64_t(0));
    auto sf = reinterpret_cast<__ubuf__ float *>(uint64_t(payload_bytes));
    auto sh = reinterpret_cast<__ubuf__ half *>(sf + ScatterArena::source_bytes / sizeof(float));
    __gm__ T *src, *dst;
    __gm__ float *scale;
    __gm__ half *ds;
    __gm__ int64_t *ids;
    src = (__gm__ T *)values;
    dst = (__gm__ T *)cache;
    scale = (__gm__ float *)scales;
    ds = (__gm__ half *)cache_scales;
    ids = (__gm__ int64_t *)slots;
    constexpr TEventID load = 0, reuse = 0, sv = 0, vm = 0, mv = 0;
    constexpr TEventID scale_read_retired = 0;
    for (int64_t row = 0; row < rows; ++row) {
        int64_t slot = ids[row];
        if (slot < 0 || slot >= capacity)
            continue;
        int64_t owner = POSITION_QUANT_WITH_SCALES ? slot / kScaleGroupRows : slot;
        // Fixed persistent workers own disjoint destination cache lines.
        const int64_t actor = owner % kWorkers;
        if (actor != GetBlockIdx())
            continue;
        asc_copy_gm2ub(tmp, (src + (row * dim)), uint32_t((dim) * sizeof(T)));
        native_device::pipe_fence<PIPE_MTE2, PIPE_MTE3, load>();
        asc_copy_ub2gm((dst + (slot * dim)), tmp, uint32_t((dim) * sizeof(T)));
        native_device::pipe_fence<PIPE_MTE3, PIPE_MTE2, reuse>();
        if constexpr (POSITION_QUANT_WITH_SCALES) {
            sf[0] = scale[row];
            native_device::pipe_fence<PIPE_S, PIPE_V, sv>();
            asc_float2half_rn(sh, sf, kScaleGroupRows);
            pipe_barrier(PIPE_V);
            // Scalar may overwrite sf only after the Vector cast consumed it.
            native_device::pipe_fence<PIPE_V, PIPE_S, scale_read_retired>();
            native_device::pipe_fence<PIPE_V, PIPE_MTE3, vm>();
            asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((ds + (slot))),
                                 reinterpret_cast<__ubuf__ uint8_t *>(sh), 1, 2, 0, 0, 0, 0);
            native_device::pipe_fence<PIPE_MTE3, PIPE_V, mv>();
        }
    }
#if defined(POSITION_QUANT_SCATTER_INT8)
    native_device::pipe_fence<PIPE_V, PIPE_S, kTailDrainEvent>();
#endif
    native_device::pipe_fence<PIPE_MTE2, PIPE_S, kTailDrainEvent>();
    native_device::pipe_fence<PIPE_MTE3, PIPE_S, kTailDrainEvent>();
}
#else
class QuantizeRows {
    static constexpr TEventID load = 0, reuse = 0, store = 0, retired = 0, vs = 0, sv = 0;
    // MTE3 -> Scalar retires sf/sh readers before the next scale group may
    // overwrite its Scalar-owned FP32 staging. This pair has a private bank.
    static constexpr TEventID kScaleScratchRetired = 0;

  public:
    __aicore__ inline void run(GM_ADDR x, GM_ADDR cos, GM_ADDR sin, GM_ADDR y, GM_ADDR scales,
                               GM_ADDR tables, int64_t rows) {
        using namespace position_quant;
            using Arena = QuantArena;
        constexpr uint32_t heads = POSITION_QUANT_HEADS;
        constexpr uint32_t mode = POSITION_QUANT_MODE;
        constexpr bool inverse = POSITION_QUANT_INVERSE;
        constexpr uint32_t dim = POSITION_QUANT_DIM;
        constexpr uint32_t rotary_dim = POSITION_QUANT_ROTARY_DIM;
        auto in = reinterpret_cast<__ubuf__ bfloat16_t *>(uint64_t(Arena::input));
        auto out = reinterpret_cast<__ubuf__ bfloat16_t *>(uint64_t(Arena::output));
        auto f = reinterpret_cast<__ubuf__ float *>(uint64_t(Arena::floats));
        auto work = reinterpret_cast<__ubuf__ float *>(uint64_t(Arena::work));
        auto a = reinterpret_cast<__ubuf__ float *>(uint64_t(Arena::absolute));
        auto red = reinterpret_cast<__ubuf__ float *>(uint64_t(Arena::reduction));
        auto rt = reinterpret_cast<__ubuf__ float *>(uint64_t(Arena::rawtrig));
        auto tr = reinterpret_cast<__ubuf__ float *>(uint64_t(Arena::trig));
        auto sw = reinterpret_cast<__ubuf__ float *>(uint64_t(Arena::swapped));
        auto offsets = reinterpret_cast<__ubuf__ uint32_t *>(uint64_t(Arena::offsets));
        auto signs = reinterpret_cast<__ubuf__ float *>(uint64_t(Arena::signs));
        auto sf = reinterpret_cast<__ubuf__ float *>(uint64_t(Arena::scale32));
        auto sh = reinterpret_cast<__ubuf__ half *>(uint64_t(Arena::scale16));
        auto codes = reinterpret_cast<__ubuf__ int8_t *>(uint64_t(Arena::codes));
        auto ints = reinterpret_cast<__ubuf__ int16_t *>(uint64_t(Arena::rounded));
        __gm__ bfloat16_t *src;
        __gm__ int8_t *quant;
        __gm__ float *c, *s, *scales32, *sign_lut;
        __gm__ half *scales16;
        __gm__ uint32_t *lut;
        src = (__gm__ bfloat16_t *)x;
        quant = (__gm__ int8_t *)y;
        scales32 = (__gm__ float *)scales;
        scales16 = (__gm__ half *)scales;
        c = (__gm__ float *)cos;
        s = (__gm__ float *)sin;
        lut = (__gm__ uint32_t *)tables;
        sign_lut = (__gm__ float *)tables + (2 * rotary_dim);
        if constexpr (POSITION_QUANT_HAS_TRIG) {
            asc_copy_gm2ub(offsets, lut, uint32_t(((2 * rotary_dim)) * sizeof(float)));
            asc_copy_gm2ub(signs, sign_lut, uint32_t((rotary_dim) * sizeof(float)));
            native_device::pipe_fence<PIPE_MTE2, PIPE_V, load>();
        }
        // Whole groups of16 scales belong to one core; no cross-core partial
        // 32-byte scale writes. Q has32 heads; K tail is the final group only.
        constexpr int64_t group_size = kScaleGroupRows;
        int64_t groups = (rows + group_size - 1) / group_size;
        for (int64_t group = GetBlockIdx(); group < groups; group += kWorkers) {
            int64_t first = group * group_size;
            uint32_t count = (rows - first < group_size) ? rows - first : group_size;
            for (uint32_t j = 0; j < count; ++j) {
                int64_t row = first + j;
                asc_copy_gm2ub(in, (src + (row * dim)), uint32_t((dim) * sizeof(bfloat16_t)));
                if constexpr (POSITION_QUANT_HAS_TRIG) {
                    asc_copy_gm2ub(rt, (c + (row / heads * (rotary_dim / 2))),
                                   uint32_t((rotary_dim / 2) * sizeof(float)));
                    asc_copy_gm2ub((rt + (rotary_dim / 2)), (s + (row / heads * (rotary_dim / 2))),
                                   uint32_t((rotary_dim / 2) * sizeof(float)));
                }
                native_device::pipe_fence<PIPE_MTE2, PIPE_V, load>();
                asc_bfloat162float(f, in, dim);
                pipe_barrier(PIPE_V);
                if constexpr (POSITION_QUANT_HAS_TRIG) {
                    asc_gather(tr, rt, (offsets + (rotary_dim)), rotary_dim);
                    asc_gather((tr + (rotary_dim)), (rt + (rotary_dim / 2)),
                               (offsets + (rotary_dim)), rotary_dim);
                    asc_gather(sw, (f + (dim - rotary_dim)), offsets, rotary_dim);
                    pipe_barrier(PIPE_V);
                    if (inverse) {
                        asc_mul_scalar((tr + (rotary_dim)), (tr + (rotary_dim)), -1.0f, rotary_dim);
                        pipe_barrier(PIPE_V);
                    }
                    asc_mul(sw, sw, (tr + (rotary_dim)), rotary_dim);
                    asc_mul((f + (dim - rotary_dim)), (f + (dim - rotary_dim)), tr, rotary_dim);
                    pipe_barrier(PIPE_V);
                    asc_mul(sw, sw, signs, rotary_dim);
                    pipe_barrier(PIPE_V);
                    asc_add((f + (dim - rotary_dim)), (f + (dim - rotary_dim)), sw, rotary_dim);
                    pipe_barrier(PIPE_V);
                    asc_float2bfloat16_rn(out, f, dim);
                    pipe_barrier(PIPE_V);
                    asc_bfloat162float(f, out, dim);
                    pipe_barrier(PIPE_V);
                }
                asc_abs(a, f, dim);
                pipe_barrier(PIPE_V);
                maximum(red, a, work, dim);
                pipe_barrier(PIPE_V);
                native_device::pipe_fence<PIPE_V, PIPE_S, vs>();
                float maximum = red[0];
                float scale = maximum * (1.0f / 127.0f);
                if (mode == 1) {
                    asc_duplicate(a, scale, dim);
                    pipe_barrier(PIPE_V);
                    // Width-sized output scratch owns temporary FP16 scales;
                    // the separate sh span holds only the final 16-scale group.
                    asc_float2half_rn(reinterpret_cast<__ubuf__ half *>(out), a, dim);
                    pipe_barrier(PIPE_V);
                    asc_half2float(a, reinterpret_cast<__ubuf__ half *>(out), dim);
                    pipe_barrier(PIPE_V);
                    asc_max_scalar(a, a, 0x1p-24f, dim);
                    pipe_barrier(PIPE_V);
                    native_device::pipe_fence<PIPE_V, PIPE_S, vs>();
                    scale = a[0];
                    asc_div(work, f, a, dim);
                    pipe_barrier(PIPE_V);
                    asc_max_scalar(work, work, -127.0f, dim);
                    pipe_barrier(PIPE_V);
                } else if (maximum == 0.0f) {
                    asc_duplicate(work, 0.0f, dim);
                    pipe_barrier(PIPE_V);
                } else if (maximum < 0x1p-120f) {
                    // Avoid overflowing127/amax for BF16 subnormals.
                    asc_duplicate(a, maximum, dim);
                    pipe_barrier(PIPE_V);
                    asc_div(work, f, a, dim);
                    pipe_barrier(PIPE_V);
                    asc_mul_scalar(work, work, 127.0f, dim);
                    pipe_barrier(PIPE_V);
                } else {
                    // Match dynamic_quant's vector asc_div(127, amax), whose
                    // reciprocal/multiply rounding can differ from scalar
                    // FP32 division exactly at n+0.5 code boundaries.
                    asc_duplicate(a, maximum, dim);
                    asc_duplicate(work, 127.0f, dim);
                    pipe_barrier(PIPE_V);
                    asc_div(work, work, a, dim);
                    pipe_barrier(PIPE_V);
                    asc_mul(work, f, work, dim);
                    pipe_barrier(PIPE_V);
                }
                asc_min_scalar(work, work, 127.0f, dim);
                pipe_barrier(PIPE_V);
                asc_float2int16_rn(ints, work, dim);
                pipe_barrier(PIPE_V);
                asc_int162half(reinterpret_cast<__ubuf__ half *>(out), ints, dim);
                pipe_barrier(PIPE_V);
                asc_half2int8_rz(codes, reinterpret_cast<__ubuf__ half *>(out), dim);
                pipe_barrier(PIPE_V);
                native_device::pipe_fence<PIPE_V, PIPE_MTE3, store>();
                if (dim % (ONE_BLK_SIZE / sizeof(int8_t)) == 0)
                    asc_copy_ub2gm((quant + (row * dim)), codes, uint32_t((dim) * sizeof(int8_t)));
                else
                    asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((quant + (row * dim))),
                                         reinterpret_cast<__ubuf__ uint8_t *>(codes), 1, dim, 0, 0,
                                         0, 0);
                sf[j] = scale;

                native_device::pipe_fence<PIPE_MTE3, PIPE_V, retired>();
                native_device::pipe_fence<PIPE_V, PIPE_MTE2, reuse>();
            }
            native_device::pipe_fence<PIPE_S, PIPE_V, sv>();
            if (mode == 1) {
                asc_float2half_rn(sh, sf, kScaleGroupRows);
                pipe_barrier(PIPE_V);
                native_device::pipe_fence<PIPE_V, PIPE_MTE3, store>();
                asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((scales16 + (first))),
                                     reinterpret_cast<__ubuf__ uint8_t *>(sh), 1,
                                     count * uint32_t(sizeof(half)), 0, 0, 0, 0);
            } else {
                native_device::pipe_fence<PIPE_V, PIPE_MTE3, store>();
                asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((scales32 + (first))),
                                     reinterpret_cast<__ubuf__ uint8_t *>(sf), 1,
                                     count * uint32_t(sizeof(float)), 0, 0, 0, 0);
            }
            // sf is Scalar-written in the next group. Waiting on Scalar
            // retires both the raw FP32 store and the query sf->half reader.
            native_device::pipe_fence<PIPE_MTE3, PIPE_S, kScaleScratchRetired>();
        }
        // Final reuse Waits consume on V and MTE2 after the last useful
        // store. Draining just the MTE3 producer would not retire them.
        native_device::pipe_fence<PIPE_V, PIPE_S, kTailDrainEvent>();
        native_device::pipe_fence<PIPE_MTE2, PIPE_S, kTailDrainEvent>();
        native_device::pipe_fence<PIPE_MTE3, PIPE_S, kTailDrainEvent>();
    }
};

__global__ __aicore__ void position_quant_kernel(GM_ADDR x, GM_ADDR cos, GM_ADDR sin, GM_ADDR y,
                                                 GM_ADDR scales, GM_ADDR tables, int64_t rows) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    InitSocState();
    SetSaturationFlag<SaturationMode::FLOAT>(false);
    QuantizeRows op;
    op.run(x, cos, sin, y, scales, tables, rows);
}
#endif
