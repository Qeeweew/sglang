#include <kernel_operator.h>
#include <c_api/asc_simd.h>
#include <router/layout.h>
using namespace AscendC;
namespace {
constexpr uint32_t E = ROUTER_EXPERTS, K = ROUTER_TOP_K, W = ROUTER_WORKERS;
constexpr uint32_t R = router_layout::tile_rows(E, K), L = router_layout::kMaxTopK;
constexpr uint32_t kRepeatElements = ONE_REPEAT_BYTE_SIZE / sizeof(float);
constexpr router_layout::ArenaLayout layout(R, E, K);
constexpr uint32_t arena = 2 * R * E * sizeof(float);
static_assert(arena + layout.bytes <= TMP_UB_OFFSET);
static_assert(K > 0 && K <= L);
// Sort all 32-element segments together, then merge four ordered lists at a
// time. Full four-list groups use repeat across rows; a row tail uses valid_bit.
__aicore__ __ubuf__ float *sort_rows(__ubuf__ float *a, __ubuf__ float *b,
                                    __ubuf__ float *rank, __ubuf__ uint32_t *indices, uint32_t n) {
    asc_bitsort(a, rank, indices, n * E / 32);
    pipe_barrier(PIPE_V);
    for (uint32_t width = 32; width < E; width *= 4) {
        if (E % (4 * width) == 0) {
            __ubuf__ float *lists[4] = {a, a + 2 * width, a + 4 * width, a + 6 * width};
            asc_mrgsort4(b, lists, uint8_t(n * E / (4 * width)), width, width, width, width, false, 15);
        } else for (uint32_t r = 0; r < n; ++r) {
            for (uint32_t at = 0; at < E; at += 4 * width) {
                __ubuf__ float *lists[4];
                uint16_t lengths[4];
                uint8_t valid = 0;
                for (uint32_t i = 0; i < 4; ++i) {
                    const uint32_t start = min(E, at + i * width);
                    lists[i] = a + 2 * (r * E + start);
                    lengths[i] = min(width, E - start);
                    if (lengths[i]) valid |= 1 << i;
                }
                asc_mrgsort4(b + 2 * (r * E + at), lists, uint8_t(1),
                              lengths[0], lengths[1], lengths[2], lengths[3], false, valid);
            }
        }
        pipe_barrier(PIPE_V);
        auto old = a; a = b; b = old;
    }
    return a;
}
} // namespace

__global__ __aicore__ void router_kernel(GM_ADDR logits, GM_ADDR correction, GM_ADDR ids_out,
                                         GM_ADDR weights_out, GM_ADDR valid_rows, GM_ADDR alternate,
                                         GM_ADDR image_mask, GM_ADDR dp_counts,
                                         float factor, int64_t rows, int64_t dp_stride) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    InitSocState();
    SetSaturationFlag<SaturationMode::FLOAT>(false);
    constexpr uint32_t experts = E, topk = K, tile_rows = R;
    const int64_t groups = (rows + R - 1) / R, per_worker = (groups + W - 1) / W;
    const int64_t begin = GetBlockIdx() * per_worker, end = min(groups, begin + per_worker);
    auto input0 = reinterpret_cast<__ubuf__ float *>(uint64_t(0));
    auto input1 = reinterpret_cast<__ubuf__ float *>(uint64_t(R * E * sizeof(float)));
    auto score = reinterpret_cast<__ubuf__ float *>(uint64_t(arena + layout.score));
    auto bias = reinterpret_cast<__ubuf__ float *>(uint64_t(arena + layout.bias));
    auto alt = reinterpret_cast<__ubuf__ float *>(uint64_t(arena + layout.alternate));
    auto exp_neg_abs = reinterpret_cast<__ubuf__ float *>(uint64_t(arena + layout.exponential));
    auto one_plus_exp = reinterpret_cast<__ubuf__ float *>(uint64_t(arena + layout.one_plus_exp));
    auto log_adjustment = reinterpret_cast<__ubuf__ float *>(uint64_t(arena + layout.logarithm));
    auto denominator = reinterpret_cast<__ubuf__ float *>(uint64_t(arena + layout.denominator));
    auto rank = reinterpret_cast<__ubuf__ float *>(uint64_t(arena + layout.ranking));
    auto indices = reinterpret_cast<__ubuf__ uint32_t *>(uint64_t(arena + layout.indices));
    auto mask = reinterpret_cast<__ubuf__ uint8_t *>(indices);
    auto selected = reinterpret_cast<__ubuf__ float *>(uint64_t(arena + layout.selected));
    auto selected_ids = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(arena + layout.selected_ids));
    auto score_offsets = reinterpret_cast<__ubuf__ uint32_t *>(uint64_t(arena + layout.score_offsets));
    auto sums = reinterpret_cast<__ubuf__ float *>(uint64_t(arena + layout.sums));
    auto pair_offsets = reinterpret_cast<__ubuf__ uint32_t *>(uint64_t(arena + layout.pair_offsets));
    auto packing = reinterpret_cast<__ubuf__ uint32_t *>(uint64_t(arena + layout.packing));
    auto out_ids = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(arena + layout.output));
    auto out_weights = reinterpret_cast<__ubuf__ float *>(uint64_t(arena + layout.output + layout.output_stride * 4));
    auto input = (__gm__ float *)logits, cb = (__gm__ float *)correction, ab = (__gm__ float *)alternate;
    auto images = (__gm__ int32_t *)image_mask;
#if ROUTER_DP_INT64
    auto dp = (__gm__ int64_t *)dp_counts;
#else
    auto dp = (__gm__ int32_t *)dp_counts;
#endif
    const int64_t live_rows = valid_rows ? ((__gm__ int32_t *)valid_rows)[0] : rows;
    const uint32_t prepared_rows = min(int64_t(R), rows - begin * R);
    // Eight integer seeds; all remaining address generation is Vector.
    for (uint32_t i = 0; i < 8; ++i) pair_offsets[i] = i;
    for (uint32_t r = 0; r < prepared_rows; ++r)
        for (uint32_t k = 0; k < K; ++k) packing[r * K + k] = (r * L + k) * 4;
    set_flag(PIPE_S, PIPE_V, EVENT_ID0);
    wait_flag(PIPE_S, PIPE_V, EVENT_ID0);
    for (uint32_t n = 8; n < L; n *= 2) {
        asc_add_scalar((__ubuf__ int32_t *)(pair_offsets + n), (__ubuf__ int32_t *)pair_offsets, int32_t(n), n);
        pipe_barrier(PIPE_V);
    }
    asc_shiftleft(pair_offsets, pair_offsets, uint32_t(3), L);
    pipe_barrier(PIPE_V);
    asc_add_scalar((__ubuf__ int32_t *)pair_offsets, (__ubuf__ int32_t *)pair_offsets, int32_t(4), L);
    pipe_barrier(PIPE_V);
    for (uint32_t r = 0; r < prepared_rows; ++r) {
        if (correction) asc_copy_gm2ub(bias + r * E, cb, E * 4);
        if (alternate) asc_copy_gm2ub(alt + r * E, ab, E * 4);
    }
    if (!correction) asc_duplicate(bias, 0.f, prepared_rows * E);
    set_flag(PIPE_MTE2, PIPE_V, EVENT_ID2);
    wait_flag(PIPE_MTE2, PIPE_V, EVENT_ID2);
    asc_copy_gm2ub(input0, input + begin * R * E, prepared_rows * E * 4);
    set_flag(PIPE_MTE2, PIPE_V, EVENT_ID0);
    for (int64_t group = begin; group < end; ++group) {
        const uint32_t input_slot = (group - begin) % 2;
        wait_flag(PIPE_MTE2, PIPE_V, ::event_t(input_slot));
        auto x = input_slot ? input1 : input0;
        const int64_t first = group * R;
        const uint32_t n = min(int64_t(R), rows - first);
        if (group + 1 < end) {
            const uint32_t next_slot = (input_slot + 1) % 2;
            if (group != begin) wait_flag(PIPE_V, PIPE_MTE2, ::event_t(next_slot));
            const uint32_t nn = min(int64_t(R), rows - first - R);
            asc_copy_gm2ub(next_slot ? input1 : input0, input + (first + R) * E, nn * E * 4);
            set_flag(PIPE_MTE2, PIPE_V, ::event_t(next_slot));
        }
        uint32_t count = n * experts;
        // Stable sqrt(softplus(x)): compute the small exponential for both
        // signs and preserve the upstream near-underflow correction.
        asc_set_mask_norm();
        asc_set_vector_mask(0, ~uint64_t(0));
        asc_abs(denominator, x, uint8_t(count / kRepeatElements), 1, 1, 8, 8);
        pipe_barrier(PIPE_V);
        asc_mul_scalar(exp_neg_abs, denominator, -1.f, uint8_t(count / kRepeatElements), 1, 1, 8,
                       8);
        pipe_barrier(PIPE_V);
        asc_exp(exp_neg_abs, exp_neg_abs, uint8_t(count / kRepeatElements), 1, 1, 8, 8);
        pipe_barrier(PIPE_V);
        asc_add_scalar(one_plus_exp, exp_neg_abs, 1.f, uint8_t(count / kRepeatElements), 1, 1, 8,
                       8);
        pipe_barrier(PIPE_V);
        asc_log(log_adjustment, one_plus_exp, uint8_t(count / kRepeatElements), 1, 1, 8, 8);
        asc_add_scalar(denominator, one_plus_exp, -1.f, uint8_t(count / kRepeatElements), 1, 1, 8,
                       8);
        pipe_barrier(PIPE_V);
        asc_max_scalar(denominator, denominator, router_layout::kMinimumNormalF32,
                       uint8_t(count / kRepeatElements), 1, 1, 8, 8);
        pipe_barrier(PIPE_V);
        asc_mul(log_adjustment, log_adjustment, exp_neg_abs, uint8_t(count / kRepeatElements), 1, 1,
                1, 8, 8, 8);
        pipe_barrier(PIPE_V);
        asc_div(log_adjustment, log_adjustment, denominator, uint8_t(count / kRepeatElements), 1, 1,
                1, 8, 8, 8);
        pipe_barrier(PIPE_V);
        asc_eq_scalar(mask, one_plus_exp, 1.f, uint8_t(count / 64), 1, 1, 8, 8);
        pipe_barrier(PIPE_V);
        {
            auto select_address = reinterpret_cast<__ubuf__ uint32_t *>(uint64_t(TMP_UB_OFFSET));
            asc_set_mask_count();
            asc_set_vector_mask(0, ONE_BLK_SIZE);
            asc_duplicate(select_address, uint32_t(reinterpret_cast<uint64_t>(mask)), uint8_t(1), 1,
                          8);
            pipe_barrier(PIPE_V);
            asc_set_cmp_mask(select_address);
            pipe_barrier(PIPE_V);
            asc_set_vector_mask(0, count);
            if ASCEND_IS_AIV {
                vsel(log_adjustment, exp_neg_abs, log_adjustment, 1, 1, 1, 1, 8, 8, 8,
                     uint8_t(SELMODE::VSEL_TENSOR_TENSOR_MODE));
            }
            pipe_barrier(PIPE_V);
            asc_set_vector_mask(~uint64_t(0), ~uint64_t(0));
            asc_set_mask_norm();
        };
        pipe_barrier(PIPE_V);
        asc_set_vector_mask(0, ~uint64_t(0));
        asc_max_scalar(score, x, 0.f, uint8_t(count / kRepeatElements), 1, 1, 8, 8);
        pipe_barrier(PIPE_V);
        asc_add(score, score, log_adjustment, uint8_t(count / kRepeatElements), 1, 1, 1, 8, 8, 8);
        pipe_barrier(PIPE_V);
        asc_sqrt(score, score, uint8_t(count / kRepeatElements), 1, 1, 8, 8);
        pipe_barrier(PIPE_V);
        set_flag(PIPE_V, PIPE_MTE2, ::event_t(input_slot));
        if (alternate == nullptr)
            asc_add(rank, score, bias, count);
        else
            for (uint32_t r = 0; r < n; ++r) {
                bool image = images[first + r] != 0;
                asc_add((rank + (r * experts)), (score + (r * experts)),
                        ((image ? alt : bias) + r * experts), experts);
            }
        pipe_barrier(PIPE_V);
        if (group != begin) wait_flag(PIPE_MTE3, PIPE_V, EVENT_ID0);
        // The softplus mask is retired. Generate local expert labels in the
        // same span, then sort all rows without reading a winner on Scalar.
        asc_shiftright(indices, pair_offsets, uint32_t(3), L);
        pipe_barrier(PIPE_V);
        for (uint32_t size = L; size < E; size *= 2) {
            asc_add_scalar((__ubuf__ int32_t *)(indices + size), (__ubuf__ int32_t *)indices,
                           int32_t(size), min(size, E - size));
            pipe_barrier(PIPE_V);
        }
        for (uint32_t r = 1; r < n; ++r) asc_copy_ub2ub(indices + r * E, indices, E * 4);
        pipe_barrier(PIPE_V);
        auto sorted = sort_rows(exp_neg_abs, log_adjustment, rank, indices, n);
        asc_duplicate(selected, 0.f, n * L);
        pipe_barrier(PIPE_V);
        for (uint32_t r = 0; r < n; ++r) {
            asc_gather(selected_ids + r * L, (__ubuf__ int32_t *)(sorted + 2 * r * E), pair_offsets, K);
            pipe_barrier(PIPE_V);
            asc_shiftleft(score_offsets + r * L, (__ubuf__ uint32_t *)(selected_ids + r * L), uint32_t(2), K);
            pipe_barrier(PIPE_V);
            asc_gather(selected + r * L, score + r * E, score_offsets + r * L, K);
        }
        pipe_barrier(PIPE_V);
        asc_set_mask_norm();
        asc_set_vector_mask(0, K == L ? ~uint64_t(0) : (uint64_t(1) << K) - 1);
        asc_repeat_reduce_sum(sums, selected, uint8_t(n), 1, 1, L / 8);
        asc_set_vector_mask(~uint64_t(0), ~uint64_t(0));
        pipe_barrier(PIPE_V);
        asc_add_scalar(sums, sums, router_layout::kWeightDenominatorEpsilon, n);
        pipe_barrier(PIPE_V);
        asc_brcb((__ubuf__ uint32_t *)denominator, (__ubuf__ uint32_t *)sums, 1, 8, uint8_t(1));
        pipe_barrier(PIPE_V);
        asc_set_vector_mask(0, K == L ? ~uint64_t(0) : (uint64_t(1) << K) - 1);
        asc_div(selected, selected, denominator, uint8_t(n), 1, 1, 0, 8, 8, 1);
        pipe_barrier(PIPE_V);
        asc_mul_scalar(selected, selected, factor, uint8_t(n), 1, 1, 8, 8);
        asc_set_vector_mask(~uint64_t(0), ~uint64_t(0));
        pipe_barrier(PIPE_V);
        for (uint32_t r = 0; r < n; ++r) {
            const int64_t row = first + r;
#if ROUTER_HAS_DP
            const bool valid = row % dp_stride < int32_t(dp[row / dp_stride]);
#else
            const bool valid = row < live_rows;
#endif
            if (!valid) {
                asc_duplicate(selected_ids + r * L, int32_t(-1), K);
                asc_duplicate(selected + r * L, 0.f, K);
            }
        }
        pipe_barrier(PIPE_V);
        asc_gather(out_ids, selected_ids, packing, n * K);
        asc_gather(out_weights, selected, packing, n * K);
        set_flag(PIPE_V, PIPE_MTE3, EVENT_ID0);
        wait_flag(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm_align((__gm__ uint8_t *)((__gm__ int32_t *)ids_out + first * K),
                             (__ubuf__ uint8_t *)out_ids, 1, n * K * 4, 0, 0, 0, 0);
        asc_copy_ub2gm_align((__gm__ uint8_t *)((__gm__ float *)weights_out + first * K),
                             (__ubuf__ uint8_t *)out_weights, 1, n * K * 4, 0, 0, 0, 0);
        set_flag(PIPE_MTE3, PIPE_V, EVENT_ID0);
    }
    wait_flag(PIPE_MTE3, PIPE_V, EVENT_ID0);
    for (uint32_t slot = 0; slot < 2 && slot < end - begin; ++slot)
        wait_flag(PIPE_V, PIPE_MTE2, ::event_t(slot));
    set_flag(PIPE_MTE2, PIPE_S, EVENT_ID2);
    wait_flag(PIPE_MTE2, PIPE_S, EVENT_ID2);
    set_flag(PIPE_V, PIPE_S, EVENT_ID0);
    wait_flag(PIPE_V, PIPE_S, EVENT_ID0);
    set_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
    wait_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
}
