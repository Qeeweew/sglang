#include <mhc/vector_pipeline.h>
using namespace mhc;
__global__ __vector__ void mhc_project_small(GM_ADDR residual, GM_ADDR fn, GM_ADDR projection,
                                             GM_ADDR squares, uint64_t rows, uint64_t padded_rows) {
    constexpr const ProjectParams &p = kProjectPlan;
    InitSocState();
    SetSaturationFlag<SaturationMode::FLOAT>(false); // IEEE Inf/NaN, as in the FP32 reference.
    VectorEvents ev;
    constexpr uint32_t columns = kBlockFloats, k = kSmallProjectionPanelCapacity;
    constexpr SmallProjectionLayout layout(k);
    auto weights = ub<float>(layout.weights), value = ub<float>(layout.value),
         products = ub<float>(layout.products);
    auto raw = ub<bfloat16_t>(layout.raw);
    auto scratch = ub<float>(layout.scratch), out = ub<float>(layout.output);
    auto sums = ub<float>(layout.sums), stat = ub<float>(layout.stat);
    auto r = gm<bfloat16_t>(residual);
    auto f = gm<float>(fn), proj = gm<float>(projection), sq = gm<float>(squares);
    const uint32_t groups = (p.projection_columns + columns - 1) / columns;
    const uint64_t tasks = uint64_t(p.panel_count) * groups;
    for (uint64_t task = GetBlockIdx(); task < tasks; task += kWorkers) {
        const uint32_t panel = task / groups, col = task % groups * columns, start = panel * k;
        const uint32_t valid_k = p.input_width - start < k ? p.input_width - start : k;
        const uint32_t live_cols =
            col >= p.projection_columns
                ? 0
                : (p.projection_columns - col < columns ? p.projection_columns - col : columns);
        if (live_cols < columns || valid_k < k) {
            {
                asc_duplicate(weights, 0.0f, columns * k);
                asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
            };
            pipe_barrier(PIPE_V);
        }
        // The first full import has no Vector predecessor. Later tasks
        // must retire the previous weights before reusing this UB arena.
        if (task >= kWorkers || live_cols < columns || valid_k < k) {
            set_flag(PIPE_V, PIPE_MTE2, ::event_t(VectorEvents::raw_free));
            wait_flag(PIPE_V, PIPE_MTE2, ::event_t(VectorEvents::raw_free));
        }
        if (live_cols)
            asc_copy_gm2ub(weights, (f + (col * p.input_width + start)), uint16_t(live_cols),
                           uint16_t(valid_k / kBlockFloats),
                           uint16_t((p.input_width - valid_k) / kBlockFloats),
                           uint16_t((k - valid_k) / kBlockFloats));
        if (valid_k < k) {
            // The tail remains zero across row imports, because every later
            // DMA writes only valid_k elements and Cast only reads raw.
            {
                asc_duplicate(reinterpret_cast<__ubuf__ uint16_t *>(raw), uint16_t(0), k);
                asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
            };
            pipe_barrier(PIPE_V);
        }
        for (uint64_t first = 0; first < rows; first += p.tile_rows) {
            {
                asc_duplicate(out, 0.0f, p.tile_rows * columns);
                asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
            };
            {
                asc_duplicate(sums, 0.0f, round_up(p.tile_rows, kBlockFloats));
                asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
            };
            pipe_barrier(PIPE_V);
            {
                set_flag(PIPE_V, PIPE_MTE2, ::event_t(VectorEvents::raw_free));
                wait_flag(PIPE_V, PIPE_MTE2, ::event_t(VectorEvents::raw_free));
            }
            asc_copy_gm2ub_align(raw, (r + (first * p.input_width + start)), 1,
                                 valid_k * sizeof(*(raw)), 0, 0, 0, 0);
            // The initial import also covers Fn's disjoint DMA above.
            {
                set_flag(PIPE_MTE2, PIPE_V, ::event_t(VectorEvents::loaded));
                wait_flag(PIPE_MTE2, PIPE_V, ::event_t(VectorEvents::loaded));
            }
            for (uint32_t row = 0; row < p.tile_rows && first + row < rows; ++row) {
                if (row)
                    wait_flag(PIPE_MTE2, PIPE_V, ::event_t(ev.raw_ready[0]));
                {
                    asc_bfloat162float(value, raw, k);
                    asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
                };
                if (row + 1 < p.tile_rows && first + row + 1 < rows) {
                    // Cast releases only the BF16 import arena. Its next row
                    // can overlap all current FP32 products and reductions.
                    set_flag(PIPE_V, PIPE_MTE2, ::event_t(ev.raw_reuse[0]));
                    wait_flag(PIPE_V, PIPE_MTE2, ::event_t(ev.raw_reuse[0]));
                    asc_copy_gm2ub_align(raw, (r + ((first + row + 1) * p.input_width + start)), 1,
                                         valid_k * sizeof(*(raw)), 0, 0, 0, 0);
                    set_flag(PIPE_MTE2, PIPE_V, ::event_t(ev.raw_ready[0]));
                }
                pipe_barrier(PIPE_V);
                const uint32_t panel_elements = k;
                const uint64_t panel_mask = panel_elements >= kRepeatFloats
                                                ? UINT64_MAX
                                                : (uint64_t(1) << panel_elements) - 1;
                const uint8_t panel_repeats = (k) / kRepeatFloats;
                asc_set_vector_mask(0, panel_mask);
#pragma unroll
                for (uint32_t c = 0; c < columns; ++c)
                    asc_mul((products + (c * k)), (weights + (c * k)), value, panel_repeats, 1, 1,
                            1, kRepeatBlocks, kRepeatBlocks, kRepeatBlocks);
                pipe_barrier(PIPE_V);
                panel_sum((out + (row * columns)), products, scratch, columns, k);
                if (col == 0) {
                    asc_set_vector_mask(0, panel_mask);
                    asc_mul(products, value, value, panel_repeats, 1, 1, 1, kRepeatBlocks,
                            kRepeatBlocks, kRepeatBlocks);
                    pipe_barrier(PIPE_V);
                    reduce_r64(stat, products, scratch, k);
                    {
                        set_flag(PIPE_V, PIPE_S, ::event_t(VectorEvents::scalar_read));
                        wait_flag(PIPE_V, PIPE_S, ::event_t(VectorEvents::scalar_read));
                    }
                    sums[row] = stat[0];
                }
            }
            if (col == 0) {
                set_flag(PIPE_S, PIPE_V, ::event_t(VectorEvents::scalar_write));
                wait_flag(PIPE_S, PIPE_V, ::event_t(VectorEvents::scalar_write));
            }
            {
                set_flag(PIPE_V, PIPE_MTE3, ::event_t(VectorEvents::store_ready));
                wait_flag(PIPE_V, PIPE_MTE3, ::event_t(VectorEvents::store_ready));
            }
            asc_copy_ub2gm(
                (proj + ((uint64_t(panel) * padded_rows + first) * p.projection_stride + col)),
                out, uint16_t(p.tile_rows), uint16_t(columns / kBlockFloats), 0,
                uint16_t((p.projection_stride - columns) / kBlockFloats));
            if (col == 0)
                asc_copy_ub2gm_align((sq + (uint64_t(panel) * padded_rows + first)), sums, 1,
                                     p.tile_rows * sizeof(*(sums)), 0, 0, 0, 0);
            {
                set_flag(PIPE_MTE3, PIPE_V, ::event_t(VectorEvents::stored));
                wait_flag(PIPE_MTE3, PIPE_V, ::event_t(VectorEvents::stored));
            }
            if (col == 0 && groups * columns < p.projection_stride) {
                {
                    asc_duplicate(out, 0.0f, p.tile_rows * columns);
                    asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
                };
                pipe_barrier(PIPE_V);
                {
                    set_flag(PIPE_V, PIPE_MTE3, ::event_t(VectorEvents::store_ready));
                    wait_flag(PIPE_V, PIPE_MTE3, ::event_t(VectorEvents::store_ready));
                }
                asc_copy_ub2gm(
                    (proj + ((uint64_t(panel) * padded_rows + first) * p.projection_stride +
                             groups * columns)),
                    out, uint16_t(p.tile_rows),
                    uint16_t((p.projection_stride - groups * columns) / kBlockFloats), 0,
                    uint16_t(groups * columns / kBlockFloats));
                {
                    set_flag(PIPE_MTE3, PIPE_V, ::event_t(VectorEvents::stored));
                    wait_flag(PIPE_MTE3, PIPE_V, ::event_t(VectorEvents::stored));
                }
            }
        }
    }
    {
        set_flag(PIPE_MTE2, PIPE_S, ::event_t(VectorEvents::load_drained));
        wait_flag(PIPE_MTE2, PIPE_S, ::event_t(VectorEvents::load_drained));
        set_flag(PIPE_MTE3, PIPE_S, ::event_t(VectorEvents::store_drained));
        wait_flag(PIPE_MTE3, PIPE_S, ::event_t(VectorEvents::store_drained));
        set_flag(PIPE_V, PIPE_S, ::event_t(VectorEvents::scalar_read));
        wait_flag(PIPE_V, PIPE_S, ::event_t(VectorEvents::scalar_read));
    }
}
