#include <kernel_operator.h>
#include <c_api/asc_simd.h>
#include <dspark_markov/launch.h>

using namespace AscendC;

namespace {
constexpr uint32_t kInvalid = 0x7fffffffU;
constexpr uint32_t kSign = 0x80000000U;
constexpr uint32_t kRanksPerTile = 32;
constexpr uint32_t kRows = dspark_markov::kRowsPerTile;
constexpr uint32_t kRankBytes = kRows * 2 * sizeof(uint32_t);
static_assert(kRankBytes == 32);

__aicore__ inline uint32_t score_key(uint32_t bits) {
    const uint32_t magnitude = bits & ~kSign;
    if (magnitude > 0x7f800000U) return UINT32_MAX;
    if (!magnitude) return kSign;
    return bits ^ (kSign | (0U - (bits >> 31)));
}
}

__global__ __aicore__ void markov_merge_candidates(GM_ADDR candidates, GM_ADDR tokens,
                                                   int64_t ranks, int64_t rows) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    InitSocState();
    auto input = reinterpret_cast<__ubuf__ uint32_t *>(uint64_t(0));
    auto output = reinterpret_cast<__ubuf__ uint32_t *>(uint64_t(kRankBytes * kRanksPerTile));
#ifdef MARKOV_EMIT_PACKET
    constexpr bool packet = true;
#else
    constexpr bool packet = false;
#endif
    const int64_t tile_stride = int64_t(GetBlockNum()) * kRows;
    for (int64_t first = int64_t(GetBlockIdx()) * kRows; first < rows; first += tile_stride) {
        const uint32_t count = rows - first < kRows ? rows - first : kRows;
        const uint64_t gap = uint64_t(rows - count) * 8;
        const uint32_t capacity = gap <= UINT32_MAX ? kRanksPerTile : 1;
        uint32_t best_keys[kRows];
        for (int64_t start = 0; start < ranks; start += capacity) {
            const uint32_t batch = ranks - start < capacity ? ranks - start : capacity;
            asc_copy_gm2ub_align(reinterpret_cast<__ubuf__ uint8_t *>(input),
                                 candidates + (start * rows + first) * 8,
                                 batch, count * 8, 0, 0, uint32_t(gap), 0);
            set_flag(PIPE_MTE2, PIPE_S, EVENT_ID0);
            wait_flag(PIPE_MTE2, PIPE_S, EVENT_ID0);
            for (uint32_t row = 0; row < count; ++row) {
                uint32_t key = start ? best_keys[row] : 0;
                uint32_t token = start ? output[2 * row + packet] : kInvalid;
                uint32_t score = packet && start ? output[2 * row] : 0xff800000U;
                for (uint32_t rank = 0; rank < batch; ++rank) {
                    const uint32_t index = 2 * (rank * kRows + row);
                    const uint32_t id = input[index + 1] & ~kSign;
                    const uint32_t next = score_key(input[index]);
                    if (id != kInvalid && (next > key || (next == key && id < token))) {
                        key = next;
                        token = id;
                        score = input[index];
                    }
                }
                best_keys[row] = key;
                output[2 * row] = packet ? score : token;
                output[2 * row + 1] = packet ? token : 0;
            }
            if (start + batch < ranks || first + tile_stride < rows) {
                set_flag(PIPE_S, PIPE_MTE2, EVENT_ID0);
                wait_flag(PIPE_S, PIPE_MTE2, EVENT_ID0);
            }
        }
        set_flag(PIPE_S, PIPE_MTE3, EVENT_ID0);
        wait_flag(PIPE_S, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm_align(tokens + first * 8, reinterpret_cast<__ubuf__ uint8_t *>(output),
                             1, count * 8, 0, 0, 0, 0);
        set_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
        wait_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
    }
}
