#include <common/cube.h>
#include <common/device.h>
#include <kernel_operator.h>
#include <c_api/asc_simd.h>
#include <projection/launch.h>
#include <common/arch2201.h>
using namespace AscendC;
namespace projection {
namespace {
constexpr bool kGrouped = PROJECTION_GROUPED != 0;
#if PROJECTION_FP32
using Output = float;
#else
using Output = bfloat16_t;
#endif
constexpr uint32_t kLogicalK = PROJECTION_K;
constexpr uint32_t kOutputColumns = PROJECTION_N;
constexpr uint32_t kGroups = PROJECTION_GROUPS;
constexpr uint32_t kWorkers = PROJECTION_WORKERS;
constexpr uint32_t kTileRows = PROJECTION_TM;
constexpr uint32_t kTileColumns = PROJECTION_TN;
constexpr uint32_t kPanelColumns = PROJECTION_PANEL;
constexpr uint32_t kDotColumns = PROJECTION_DOT;
// M_MTE1 slot credits use IDs3/4; IDs0/1/2 remain available to this entry.
// The typed arenas and named IDs3/4 are owned and drained by this pipeline.
constexpr event_t kAccumulator = event_t(0);
constexpr event_t kMatrixState = event_t(0);
constexpr event_t kDrain = event_t(0);
constexpr uint32_t kSlots = 2;
constexpr uint32_t kOperandEventBase = 3;
constexpr uint32_t kL1Bytes =
    kSlots * kMaxCombinedTileExtent * kMaxPanelColumns * sizeof(bfloat16_t);
constexpr uint32_t kL0ABytes = kSlots * kMaxTileRows * kMaxDotColumns * sizeof(bfloat16_t);
constexpr uint32_t kL0BBytes = kSlots * kMaxTileColumns * kMaxDotColumns * sizeof(bfloat16_t);
constexpr uint32_t kL0CBytes = kMaxAccumulatorElements * sizeof(float);
static_assert(kL1Bytes <= arch2201::kL1Bytes && kL0ABytes <= arch2201::kL0ABytes &&
              kL0BBytes <= arch2201::kL0BBytes && kL0CBytes <= arch2201::kL0CBytes);

// Ownership: MTE2 -> L1[2] -> MTE1 -> L0A/B[2] -> Cube -> L0C -> FIX.
// Initial empty credits are seeded below; each consumer returns its slot after
// its last read. FIX owns C until the final output store retires.
class ProjectionPipeline {
    int64_t rows_;

    __cbuf__ bfloat16_t *l1_;
    __ca__ bfloat16_t *activation_l0a_;
    __cb__ bfloat16_t *weight_l0b_;
    __cc__ float *accumulator_l0c_;
    __gm__ bfloat16_t *input_, *weight_;
    __gm__ Output *output_;
    static constexpr uint32_t kA1Elements = kTileRows * kPanelColumns;
    static constexpr uint32_t kB1Elements = kTileColumns * kPanelColumns;
    static constexpr uint32_t kA0Elements = kTileRows * kDotColumns;
    static constexpr uint32_t kB0Elements = kTileColumns * kDotColumns;
    static constexpr bool kShortRows = PROJECTION_SHORT_ROWS;

    __aicore__ inline void coordinates(int64_t tile, uint32_t &group, int64_t &row,
                                       uint32_t &column) const {
        const uint32_t columns = (kOutputColumns + kTileColumns - 1) / kTileColumns;
        const int64_t rows = (rows_ + kTileRows - 1) / kTileRows;
        group = kGrouped ? tile / (rows * columns) : 0;
        int64_t local = kGrouped ? tile % (rows * columns) : tile;
        int64_t mi = local / columns;
        uint32_t ni = local % columns;
        // An eight-row wave reuses dense weight lines across neighboring rows.
        constexpr uint32_t kReuseWaveRows = 8;
        if (!kGrouped && rows > 5 && kOutputColumns % kTileColumns == 0) {
            const int64_t base = local / (kReuseWaveRows * columns) * kReuseWaveRows;
            const uint32_t height = min(int64_t(kReuseWaveRows), rows - base);
            const uint32_t relative = local % (kReuseWaveRows * columns);
            const uint32_t nbase = relative / (height * kReuseWaveRows) * kReuseWaveRows;
            const uint32_t width = min(kReuseWaveRows, columns - nbase);
            const uint32_t inner = relative % (height * kReuseWaveRows);
            mi = base + inner % height;
            ni = nbase + (inner / height + inner % height) % width;
        }
        row = mi * kTileRows;
        column = ni * kTileColumns;
    }
    __aicore__ inline __cbuf__ bfloat16_t *activation_l1(uint32_t slot) {
        return l1_ + slot * kA1Elements;
    }
    __aicore__ inline __cbuf__ bfloat16_t *weight_l1(uint32_t slot) {
        return l1_ + kSlots * kA1Elements + slot * kB1Elements;
    }
    __aicore__ inline void load_panel(uint32_t generation, uint32_t group, int64_t row,
                                       uint32_t column, uint32_t panel) {
        const uint32_t start_k = panel * kPanelColumns;
        const uint32_t rows = min(int64_t(kTileRows), rows_ - row);
        const uint32_t columns = min(kTileColumns, kOutputColumns - column);
        const uint32_t depth = min(kPanelColumns, kLogicalK - start_k);
        const uint32_t slot = generation % kSlots;
        auto left = activation_l1(slot), right = weight_l1(slot);
        wait_flag(PIPE_MTE1, PIPE_MTE2, ::event_t(slot));
        if (!kShortRows && (rows != kTileRows || depth != kPanelColumns)) {
            asc_fill_value_config fill{};
            fill.repeat = 1;
            fill.blk_num = kA1Elements * sizeof(bfloat16_t) / 32;
            asc_fill_l1(reinterpret_cast<__cbuf__ uint16_t *>(left), uint32_t(0), fill);
            pipe_barrier(PIPE_MTE2);
        }
        asc_copy_gm2l1_nd2nz(left, input_ + (row * kGroups + group) * kLogicalK + start_k, 1,
                             uint16_t(rows), uint16_t(depth), 0, uint16_t(kGroups * kLogicalK),
                             uint16_t(kTileRows), 1, 0);
        if (columns != kTileColumns || depth != kPanelColumns) {
            asc_fill_value_config fill{};
            fill.repeat = 1;
            fill.blk_num = kB1Elements * sizeof(bfloat16_t) / 32;
            asc_fill_l1(reinterpret_cast<__cbuf__ uint16_t *>(right), uint32_t(0), fill);
            pipe_barrier(PIPE_MTE2);
        }
        if constexpr (kGrouped) {
            asc_copy_gm2l1_nd2nz(
                right, weight_ + (int64_t(group) * kOutputColumns + column) * kLogicalK + start_k,
                1, uint16_t(columns), uint16_t(depth), 0, uint16_t(kLogicalK),
                uint16_t(kTileColumns), 1, 0);
        } else {
            asc_copy_gm2l1_nd2nz(right, weight_ + int64_t(start_k) * kOutputColumns + column, 1,
                                 uint16_t(depth), uint16_t(columns), 0, uint16_t(kOutputColumns),
                                 uint16_t(kPanelColumns), 1, 0);
        }
        set_flag(PIPE_MTE2, PIPE_MTE1, ::event_t(slot));
    }
    __aicore__ inline void compute_tile(uint32_t generation, uint32_t group, int64_t row,
                                        uint32_t column, uint32_t panel, uint32_t panels) {
        const uint32_t slot = generation % kSlots;
        const uint32_t depth = min(kPanelColumns, kLogicalK - panel * kPanelColumns);
        auto left = activation_l1(slot), right = weight_l1(slot);
        auto accumulator = accumulator_l0c_;
        wait_flag(PIPE_MTE2, PIPE_MTE1, ::event_t(slot));
        if (!panel && generation)
            wait_flag(PIPE_FIX, PIPE_M, ::event_t(kAccumulator));
#pragma unroll
        for (uint32_t chunk = 0; chunk < kMaxPanelColumns / kMaxDotColumns; ++chunk) {
            const uint32_t start = chunk * kDotColumns;
            if (start >= depth)
                break;
            const uint32_t operand_slot = chunk % kSlots;
            const uint32_t dot_k = min(kDotColumns, depth - start);
            auto a = activation_l0a_ + operand_slot * kA0Elements;
            auto b = weight_l0b_ + operand_slot * kB0Elements;
            wait_flag(PIPE_M, PIPE_MTE1, ::event_t(kOperandEventBase + operand_slot));
            if constexpr (kTileRows == 16) {
                asc_copy_l12l0a(a, left + start * kTileRows, 0, uint8_t(dot_k / 16), 1, 0);
            } else {
                asc_copy_l12l0a(reinterpret_cast<__ca__ half *>(a),
                                reinterpret_cast<__cbuf__ half *>(left + start * kTileRows), dot_k,
                                kTileRows, 0, 0, 1, 1, 1, 1, 1, 1, false, false, false, false,
                                dot_k);
            }
            if constexpr (kGrouped) {
                asc_copy_l12l0b(b, right + start * kTileColumns, 0,
                                uint8_t(kTileColumns * dot_k / 256), 1, 0);
            } else {
                asc_copy_l12l0b(reinterpret_cast<__cb__ half *>(b),
                                reinterpret_cast<__cbuf__ half *>(right + start * 16), kTileColumns,
                                dot_k, 0, 0, 1, 1, 1, 1, 1, 1, false, false, false, true,
                                kTileColumns);
            }
            // The last operand import retires both L1 panels. Return their
            // credit before MMAD, matching HEAD's import/compute overlap.
            if (start + dot_k == depth)
                set_flag(PIPE_MTE1, PIPE_MTE2, ::event_t(slot));
            native_device::pipe_fence<PIPE_MTE1, PIPE_M>(operand_slot);
            native_device::mmad(accumulator, a, b, kTileRows, dot_k, kTileColumns, 0,
                                panel == 0 && chunk == 0);
            set_flag(PIPE_M, PIPE_MTE1, ::event_t(kOperandEventBase + operand_slot));
        }
        if (panel + 1 == panels) {
            native_device::pipe_fence<PIPE_M, PIPE_FIX, kAccumulator>();
            const uint16_t valid_columns = min(kTileColumns, kOutputColumns - column);
            const uint16_t valid_rows = min(int64_t(kTileRows), rows_ - row);
            if constexpr (PROJECTION_FP32) {
                copy_matrix_cc_to_gm(output_ + (row * kGroups + group) * kOutputColumns + column,
                                     accumulator, 0, valid_columns, valid_rows,
                                     kGroups * kOutputColumns, kTileRows, 0, QuantMode_t::NoQuant,
                                     0, false, true);
            } else {
                copy_matrix_cc_to_gm(output_ + (row * kGroups + group) * kOutputColumns + column,
                                     accumulator, 0, valid_columns, valid_rows,
                                     kGroups * kOutputColumns, kTileRows, 0, QuantMode_t::F322BF16,
                                     0, false, true);
            }
            set_flag(PIPE_FIX, PIPE_M, ::event_t(kAccumulator));
        }
    }

  public:
    __aicore__ explicit ProjectionPipeline(Sources sources, int64_t rows)
        : rows_(rows), input_(reinterpret_cast<__gm__ bfloat16_t *>(sources.x)),
          weight_(reinterpret_cast<__gm__ bfloat16_t *>(sources.w)),
          output_(reinterpret_cast<__gm__ Output *>(sources.y)) {}
    __aicore__ inline void run() {
        InitSocState();
        SetSaturationFlag<SaturationMode::FLOAT>(false);
        l1_ = reinterpret_cast<__cbuf__ bfloat16_t *>(uint64_t(0));
        activation_l0a_ = reinterpret_cast<__ca__ bfloat16_t *>(uint64_t(0));
        weight_l0b_ = reinterpret_cast<__cb__ bfloat16_t *>(uint64_t(0));
        accumulator_l0c_ = reinterpret_cast<__cc__ float *>(uint64_t(0));
        // HEAD configures unchanged ND export state once, before any FIX.
        asc_set_l0c_copy_params(1, 0, 0);
        native_device::pipe_fence<PIPE_S, PIPE_FIX, kMatrixState>();
        if (kShortRows) {
            asc_fill_value_config fill{};
            fill.repeat = 1;
            fill.blk_num = kSlots * kA1Elements * sizeof(bfloat16_t) / 32;
            asc_fill_l1(reinterpret_cast<__cbuf__ uint32_t *>(l1_), uint32_t(0), fill);
            pipe_barrier(PIPE_MTE2);
        }
        // InitSocState owns default padding/boundary. Preserve matrix/repeat packets.
        set_l3d_rpt(uint64_t(1) << 16);
        set_fmatrix(uint64_t(kTileRows) | (uint64_t(1) << 16));
        if constexpr (!kGrouped)
            set_fmatrix_b(uint64_t(kPanelColumns) | (uint64_t(1) << 16));
        // CANN 9.1 HardEvent omits the legal S<->MTE1 pipe pairs. The SDK
        // intrinsic is confined to matrix-state publication and final drain.
        native_device::pipe_fence<PIPE_S, PIPE_MTE1, kMatrixState>();
        for (uint32_t slot = 0; slot < kSlots; ++slot) {
            set_flag(PIPE_MTE1, PIPE_MTE2, ::event_t(slot));
            set_flag(PIPE_M, PIPE_MTE1, ::event_t(kOperandEventBase + slot));
        }
        const uint32_t panels = (kLogicalK + kPanelColumns - 1) / kPanelColumns;
        const int64_t tiles = ((rows_ + kTileRows - 1) / kTileRows) *
                              ((kOutputColumns + kTileColumns - 1) / kTileColumns) * kGroups;
        const int64_t core = GetBlockIdx();
        const int64_t count = tiles > core ? (tiles - core + kWorkers - 1) / kWorkers * panels : 0;
        uint32_t generation = 0;
        for (int64_t tile = core; tile < tiles; tile += kWorkers) {
            uint32_t group, column;
            int64_t row;
            coordinates(tile, group, row, column);
            for (uint32_t step = 0; step <= panels; ++step) {
                if (step < panels)
                    load_panel(generation + step, group, row, column, step);
                if (step)
                    compute_tile(generation + step - 1, group, row, column, step - 1, panels);
            }
            generation += panels;
        }
        for (uint32_t slot = 0; slot < kSlots; ++slot) {
            wait_flag(PIPE_MTE1, PIPE_MTE2, ::event_t(slot));
            wait_flag(PIPE_M, PIPE_MTE1, ::event_t(kOperandEventBase + slot));
        }
        if (count)
            wait_flag(PIPE_FIX, PIPE_M, ::event_t(kAccumulator));
        native_device::pipe_fence<PIPE_MTE2, PIPE_S, kDrain>();
        native_device::pipe_fence<PIPE_MTE1, PIPE_S, kDrain>();
        native_device::pipe_fence<PIPE_M, PIPE_S, kDrain>();
        native_device::pipe_fence<PIPE_FIX, PIPE_S, kDrain>();
    }
};
} // namespace
} // namespace projection
__global__ __aicore__ void projection_kernel(GM_ADDR input, GM_ADDR weight, GM_ADDR output, int64_t rows) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
    if ASCEND_IS_AIC {
        projection::ProjectionPipeline pipeline(
            {uintptr_t(input), uintptr_t(weight), uintptr_t(output)}, rows);
        pipeline.run();
    }
}
