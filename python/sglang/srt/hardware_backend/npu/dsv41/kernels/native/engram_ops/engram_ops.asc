// V4.1/910B only. Scalar INT64 hash + FP32 vector gate.
// Bare arch2201 instructions; per-entry static UB and explicit local events.
#include <common/device.h>
#include <kernel_operator.h>
#include <c_api/asc_simd.h>
#include <engram_ops/layout.h>
using namespace AscendC;
using namespace engram_ops;

#if defined(ENGRAM_OPS_HASH)
__global__ __aicore__ void engram_hash_kernel(GM_ADDR ids_, GM_ADDR positions_, GM_ADDR cu_,
                                              GM_ADDR slots_, GM_ADDR history_, GM_ADDR active_,
                                              GM_ADDR map_, GM_ADDR multipliers_, GM_ADDR primes_,
                                              GM_ADDR offsets_, GM_ADDR out_, int64_t rows, int64_t batch) {
    constexpr int64_t history_rows = ENGRAM_OPS_HISTORY_ROWS, vocab = ENGRAM_OPS_VOCAB;
    constexpr int64_t pad = ENGRAM_OPS_PAD, image = ENGRAM_OPS_IMAGE,
                      mm_shift = ENGRAM_OPS_MM_SHIFT;
    constexpr uint32_t layers = ENGRAM_OPS_LAYERS, history_tokens = ENGRAM_OPS_HISTORY_TOKENS;
    constexpr uint32_t heads = ENGRAM_OPS_HEADS, hash_columns = history_tokens * heads;
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    __gm__ int32_t *ids, *cu, *slots, *history, *active, *map;
    __gm__ int64_t *pos, *mult, *primes, *offsets, *out;
    ids = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)ids_);
    cu = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)cu_);
    slots = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)slots_);
    history = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)history_);
    active = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)active_);
    map = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)map_);
    pos = reinterpret_cast<__gm__ int64_t *>((__gm__ int64_t *)positions_);
    mult = reinterpret_cast<__gm__ int64_t *>((__gm__ int64_t *)multipliers_);
    primes = reinterpret_cast<__gm__ int64_t *>((__gm__ int64_t *)primes_);
    offsets = reinterpret_cast<__gm__ int64_t *>((__gm__ int64_t *)offsets_);
    out = reinterpret_cast<__gm__ int64_t *>((__gm__ int64_t *)out_);
    // This entry issues Scalar/GM, Scalar/UB and MTE3 instructions only.
    // Reset DMA atomics; Vector mask state is neither read nor modified.
    DisableDmaAtomic();
    constexpr HashLayout layout(hash_columns);
    __ubuf__ int64_t *result = reinterpret_cast<__ubuf__ int64_t *>(uint64_t(layout.result));
    constexpr TEventID produced = 0, retired = 0;
    int64_t t = GetBlockIdx() / layers;
    uint32_t layer = GetBlockIdx() % layers;
    const uint32_t token_step = ENGRAM_OPS_WORKERS / layers,
                   layer_step = ENGRAM_OPS_WORKERS % layers;
    for (; t < rows;) {
        // Scalar GM reads use the device data cache. Their parameters are
        // reused across tokens without importing a second UB copy.
        const uint64_t parameters = uint64_t(layer) * hash_columns;
        const uint64_t multiplier_row = uint64_t(layer) * (history_tokens + 1);
        int64_t lo = 0, hi = batch;
        while (lo < hi) {
            int64_t mid = (lo + hi) / 2;
            if (t >= cu[mid + 1])
                lo = mid + 1;
            else
                hi = mid;
        }
        bool live = lo < batch && active[t] != 0;
        int64_t start = live ? cu[lo] : t;
        int64_t slot = live ? slots[lo] : -1;
        live = live && slot >= 0 && slot < history_rows;
        int64_t position = pos[t], off = t - start;
        bool blocked = !live;
        uint64_t rolling = 0;
        // Keep the history loop compact. Only the independent head loop
        // uses a bounded unroll budget; both extents remain runtime values.
#pragma unroll 1
        for (uint32_t shift = 0; shift <= history_tokens; ++shift) {
            int64_t token = 0;
            if (live) {
                token = shift <= off
                            ? ids[t - shift]
                            : history[slot * history_tokens + history_tokens - (shift - off)];
            }
            bool sentinel = image >= 0 && (token == image || token >= mm_shift);
            blocked = blocked || position < shift || sentinel || token < 0 || token >= vocab;
            int64_t compressed = blocked ? pad : map[token];
            // Inputs are bounded at startup: product <= INT64_MAX. Unsigned
            // multiplication/XOR also defines machine semantics unambiguously.
            rolling ^= uint64_t(compressed) * uint64_t(mult[multiplier_row + shift]);
            if (shift) {
                uint32_t head = 0;
                const uint32_t first_column = (shift - 1) * heads;
                for (; head + 4 <= heads; head += 4) {
                    const uint32_t col = first_column + head;
                    const uint64_t p0 = uint64_t(primes[parameters + col + 0]);
                    const uint64_t p1 = uint64_t(primes[parameters + col + 1]);
                    const uint64_t p2 = uint64_t(primes[parameters + col + 2]);
                    const uint64_t p3 = uint64_t(primes[parameters + col + 3]);
                    const int64_t o0 = offsets[parameters + col + 0];
                    const int64_t o1 = offsets[parameters + col + 1];
                    const int64_t o2 = offsets[parameters + col + 2];
                    const int64_t o3 = offsets[parameters + col + 3];
                    result[col + 0] = int64_t(rolling % p0) + o0;
                    result[col + 1] = int64_t(rolling % p1) + o1;
                    result[col + 2] = int64_t(rolling % p2) + o2;
                    result[col + 3] = int64_t(rolling % p3) + o3;
                }
                for (; head < heads; ++head) {
                    const uint32_t col = first_column + head;
                    const uint64_t prime = uint64_t(primes[parameters + col]);
                    result[col] = int64_t(rolling % prime) + offsets[parameters + col];
                }
            }
        }
        native_device::pipe_fence<PIPE_S, PIPE_MTE3, produced>();
        // Layer-major permits table.gather(hashes[layer]) without a copy.
        if (hash_columns % (kDmaBlockBytes / sizeof(int64_t)) == 0)
            asc_copy_ub2gm((out + ((layer * rows + t) * hash_columns)), result,
                           uint32_t((hash_columns) * sizeof(int64_t)));
        else
            asc_copy_ub2gm_align(
                reinterpret_cast<__gm__ uint8_t *>((out + ((layer * rows + t) * hash_columns))),
                reinterpret_cast<__ubuf__ uint8_t *>(result), 1,
                hash_columns * uint32_t(sizeof(int64_t)), 0, 0, 0, 0);
        native_device::pipe_fence<PIPE_MTE3, PIPE_S, retired>();
        // Advance the cyclic task coordinates without a64-bit divide for
        // every token. This preserves the layer coordinate when the
        // actual launch grid is a multiple of the layer count.
        layer += layer_step;
        t += token_step;
        if (layer >= layers) {
            layer -= layers;
            ++t;
        }
    }
}

#elif defined(ENGRAM_OPS_COMMIT)
// Four-value steady packets and two/one-value tails bound both code size and
// short-span loop overhead. Source and count stay runtime values.
__aicore__ inline void copy_scalar_span(__ubuf__ int32_t *dst, __gm__ int32_t *src,
                                        uint32_t count) {
    uint32_t col = 0;
    for (; col + 4 <= count; col += 4) {
        const int32_t a = src[col], b = src[col + 1], c = src[col + 2], d = src[col + 3];
        dst[col] = a;
        dst[col + 1] = b;
        dst[col + 2] = c;
        dst[col + 3] = d;
    }
    if (col + 2 <= count) {
        const int32_t a = src[col], b = src[col + 1];
        dst[col] = a;
        dst[col + 1] = b;
        col += 2;
    }
    if (col < count)
        dst[col] = src[col];
}
__global__ __aicore__ void engram_commit_kernel(GM_ADDR ids_, GM_ADDR cu_, GM_ADDR slots_,
                                                GM_ADDR accepted_, GM_ADDR history_, uint32_t rows,
                                                    int64_t batch) {
    constexpr uint32_t history_rows = ENGRAM_OPS_HISTORY_ROWS;
    constexpr uint32_t history_tokens = ENGRAM_OPS_HISTORY_TOKENS;
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    __gm__ int32_t *ids, *cu, *slots, *accepted, *history;
    ids = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)ids_);
    cu = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)cu_);
    slots = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)slots_);
    accepted = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)accepted_);
    history = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)history_);
    // No Vector operation follows: only DMA atomic state belongs to this
    // Scalar-copy pipeline. Incoming Vector mask state is irrelevant.
    DisableDmaAtomic();
#if ENGRAM_OPS_COMMIT_STREAMING
    // Two block-aligned tails overlap Scalar imports and the previous DMA.
    // Large rows fall back to one resident slot within the same UB budget.
    const uint32_t stride = (history_tokens + kDmaBlockBytes / sizeof(int32_t) - 1) /
                            (kDmaBlockBytes / sizeof(int32_t)) * (kDmaBlockBytes / sizeof(int32_t));
    const uint32_t slot_count = stride <= arch2201::kUbBytes / (2 * sizeof(int32_t)) ? 2 : 1;
    __ubuf__ int32_t *storage = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(0));
    constexpr TEventID produced = 0, retired[2] = {0, 1};
    bool pending[2] = {false, false};
    uint32_t slot_index = 0;
#else
    __ubuf__ int32_t *tail = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(0));
    constexpr TEventID produced = 0, retired = 0;
#endif
    for (int64_t request = GetBlockIdx(); request < batch; request += ENGRAM_OPS_WORKERS) {
        int32_t slot = slots[request], n = accepted[request];
        int32_t begin = cu[request], end = cu[request + 1];
        if (!valid_commit(slot, n, begin, end, rows, history_rows))
            continue;
        // Accepted tokens form one retained history span followed by one
        // contiguous ID span. Select the source once per span, not per value.
        const uint32_t retained = n < history_tokens ? history_tokens - uint32_t(n) : 0;
        const uint64_t history_start = uint64_t(uint32_t(slot)) * history_tokens;
        auto previous = (history + (history_start + (retained ? n : 0)));
        auto replacement = (ids + (uint32_t(begin + n) - (history_tokens - retained)));
#if ENGRAM_OPS_COMMIT_STREAMING
        if (pending[slot_index])
            wait_flag(PIPE_MTE3, PIPE_S, ::event_t(retired[slot_index]));
        auto tail = (storage + (slot_index * stride));
#endif
        copy_scalar_span(tail, previous, retained);
        copy_scalar_span((tail + (retained)), replacement, history_tokens - retained);
        native_device::pipe_fence<PIPE_S, PIPE_MTE3, produced>();
        asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((history + (history_start))),
                             reinterpret_cast<__ubuf__ uint8_t *>(tail), 1,
                             history_tokens * uint32_t(sizeof(int32_t)), 0, 0, 0, 0);
#if ENGRAM_OPS_COMMIT_STREAMING
        set_flag(PIPE_MTE3, PIPE_S, ::event_t(retired[slot_index]));
        pending[slot_index] = true;
        slot_index = slot_count == 2 ? slot_index ^ 1 : 0;
#else
        native_device::pipe_fence<PIPE_MTE3, PIPE_S, retired>();
#endif
    }
#if ENGRAM_OPS_COMMIT_STREAMING
    // Every issued retire credit is consumed before the actor exits.
#pragma unroll
    for (uint32_t slot = 0; slot < 2; ++slot)
        if (pending[slot])
            wait_flag(PIPE_MTE3, PIPE_S, ::event_t(retired[slot]));
#endif
}

#else
// The SDK ReduceSum final stage reads its TPipe event allocator for <=64
// intermediate values. This basic-API tree owns no hidden events and keeps
// the same r64 -> r64 -> scalar FP32 order, including widths above4096.
__aicore__ inline void gate_sum(__ubuf__ float *dst, __ubuf__ float *src, __ubuf__ float *scratch,
                                uint32_t width) {
    const uint32_t count = width / kFp32VectorElements;
    asc_set_vector_mask(0, ~uint64_t(0));
    asc_repeat_reduce_sum(scratch, src, uint8_t(count), 1, 1, kRepeatBlocks);
    pipe_barrier(PIPE_V);
    if (count <= kFp32VectorElements) {
        asc_set_vector_mask(0, count == 64 ? ~uint64_t(0) : (uint64_t(1) << count) - 1);
        asc_repeat_reduce_sum(dst, scratch, uint8_t(1), 1, 1, kRepeatBlocks);
    } else {
        asc_repeat_reduce_sum(scratch, scratch, uint8_t(1), 1, 1, kRepeatBlocks);
        asc_set_vector_mask(0, (uint64_t(1) << (count - kFp32VectorElements)) - 1);
        asc_repeat_reduce_sum(scratch + 1, scratch + kFp32VectorElements, uint8_t(1), 1, 1,
                              kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_set_vector_mask(0, 3);
        asc_repeat_reduce_sum(dst, scratch, uint8_t(1), 1, 1, kRepeatBlocks);
    }
}
__global__ __aicore__ void engram_gate_kernel(GM_ADDR hidden_, GM_ADDR kv_, GM_ADDR qweight_,
                                              GM_ADDR kweight_, GM_ADDR active_, GM_ADDR output_, int64_t tokens) {
    constexpr int64_t D = ENGRAM_OPS_WIDTH;
    constexpr int64_t branches = ENGRAM_OPS_BRANCHES;
    constexpr float inv_sqrt_hidden = ENGRAM_OPS_INV_SQRT_WIDTH;
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    __gm__ bfloat16_t *hidden, *kv, *qw, *kw, *output;
    __gm__ int32_t *active;
    hidden = reinterpret_cast<__gm__ bfloat16_t *>((__gm__ bfloat16_t *)hidden_);
    kv = reinterpret_cast<__gm__ bfloat16_t *>((__gm__ bfloat16_t *)kv_);
    qw = reinterpret_cast<__gm__ bfloat16_t *>((__gm__ bfloat16_t *)qweight_);
    kw = reinterpret_cast<__gm__ bfloat16_t *>((__gm__ bfloat16_t *)kweight_);
    output = reinterpret_cast<__gm__ bfloat16_t *>((__gm__ bfloat16_t *)output_);
    active = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)active_);
    InitSocState();
    SetSaturationFlag<SaturationMode::FLOAT>(false);
    constexpr GateLayout layout(D);
    __ubuf__ bfloat16_t *raw = reinterpret_cast<__ubuf__ bfloat16_t *>(uint64_t(layout.raw_hidden));
    __ubuf__ bfloat16_t *raw2 = reinterpret_cast<__ubuf__ bfloat16_t *>(uint64_t(layout.raw_key));
    __ubuf__ bfloat16_t *packed = reinterpret_cast<__ubuf__ bfloat16_t *>(uint64_t(layout.packed));
    __ubuf__ float *h = reinterpret_cast<__ubuf__ float *>(uint64_t(layout.hidden));
    __ubuf__ float *k = reinterpret_cast<__ubuf__ float *>(uint64_t(layout.key));
    __ubuf__ float *w = reinterpret_cast<__ubuf__ float *>(uint64_t(layout.weight));
    __ubuf__ float *work = reinterpret_cast<__ubuf__ float *>(uint64_t(layout.work));
    __ubuf__ float *scratch = reinterpret_cast<__ubuf__ float *>(uint64_t(layout.scratch));
    __ubuf__ float *stat = reinterpret_cast<__ubuf__ float *>(uint64_t(layout.stat));
    auto hidden_square = stat, key_square = (stat + (kFp32BlockElements));
    auto score = (stat + (2 * kFp32BlockElements)),
         hidden_inverse = (stat + (3 * kFp32BlockElements));
    auto key_inverse = (stat + (4 * kFp32BlockElements)),
         newton = (stat + (5 * kFp32BlockElements));
    constexpr TEventID load = 0, reuse = 0, inspect = 0, release = 0, store = 0, retired = 0;
    constexpr TEventID vector_drained = 0, input_drained = 0, output_drained = 0;
    for (int64_t row = GetBlockIdx(); row < tokens * branches; row += ENGRAM_OPS_WORKERS) {
        int64_t token = row / branches, branch = row % branches;
        asc_duplicate(stat, 0.0f, kFp32VectorElements);
        asc_copy_gm2ub(raw, (hidden + (row * D)), uint32_t((D) * sizeof(bfloat16_t)));
        asc_copy_gm2ub(raw2, (kv + ((token * (branches + 1) + branch) * D)),
                       uint32_t((D) * sizeof(bfloat16_t)));
        native_device::pipe_fence<PIPE_MTE2, PIPE_V, load>();
        asc_bfloat162float(h, raw, D);
        asc_bfloat162float(k, raw2, D);
        native_device::pipe_fence<PIPE_V, PIPE_MTE2, reuse>();
        asc_copy_gm2ub(raw, (qw + (branch * D)), uint32_t((D) * sizeof(bfloat16_t)));
        asc_copy_gm2ub(raw2, (kw + (branch * D)), uint32_t((D) * sizeof(bfloat16_t)));
        native_device::pipe_fence<PIPE_MTE2, PIPE_V, load>();
        asc_bfloat162float(w, raw, D);
        asc_bfloat162float(work, raw2, D);
        pipe_barrier(PIPE_V);
        asc_set_vector_mask(0, ~uint64_t(0));
        asc_mul(w, w, work, uint8_t(D / kFp32VectorElements), 1, 1, 1, kRepeatBlocks, kRepeatBlocks,
                kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_mul(work, h, h, uint8_t(D / kFp32VectorElements), 1, 1, 1, kRepeatBlocks, kRepeatBlocks,
                kRepeatBlocks);
        pipe_barrier(PIPE_V);
        gate_sum(stat, work, scratch, D);
        pipe_barrier(PIPE_V);
        asc_set_vector_mask(0, ~uint64_t(0));
        asc_mul(work, k, k, uint8_t(D / kFp32VectorElements), 1, 1, 1, kRepeatBlocks, kRepeatBlocks,
                kRepeatBlocks);
        pipe_barrier(PIPE_V);
        gate_sum(key_square, work, scratch, D);
        pipe_barrier(PIPE_V);
        asc_set_vector_mask(0, ~uint64_t(0));
        asc_mul(work, h, w, uint8_t(D / kFp32VectorElements), 1, 1, 1, kRepeatBlocks, kRepeatBlocks,
                kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_mul(work, work, k, uint8_t(D / kFp32VectorElements), 1, 1, 1, kRepeatBlocks,
                kRepeatBlocks, kRepeatBlocks);
        pipe_barrier(PIPE_V);
        gate_sum(score, work, scratch, D);
        pipe_barrier(PIPE_V);
        asc_set_vector_mask(0, ~uint64_t(0));
        asc_set_vector_mask(0, (uint64_t(1) << kFp32BlockElements) - 1);
        asc_mul_scalar(stat, stat, 1.0f / D, uint8_t(1), 1, 1, kRepeatBlocks, kRepeatBlocks);
        asc_mul_scalar(key_square, key_square, 1.0f / D, uint8_t(1), 1, 1, kRepeatBlocks,
                       kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_add_scalar(stat, stat, 1e-20f, uint8_t(1), 1, 1, kRepeatBlocks, kRepeatBlocks);
        asc_add_scalar(key_square, key_square, 1e-20f, uint8_t(1), 1, 1, kRepeatBlocks,
                       kRepeatBlocks);
        // 910B vector rsqrt is approximate. One Newton step recovers FP32
        // accuracy before the signed sqrt can amplify a dot-product error.
        pipe_barrier(PIPE_V);
        asc_rsqrt(hidden_inverse, stat, uint8_t(1), 1, 1, kRepeatBlocks, kRepeatBlocks);
        asc_rsqrt(key_inverse, key_square, uint8_t(1), 1, 1, kRepeatBlocks, kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_mul(newton, hidden_inverse, hidden_inverse, uint8_t(1), 1, 1, 1, kRepeatBlocks,
                kRepeatBlocks, kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_mul(newton, newton, stat, uint8_t(1), 1, 1, 1, kRepeatBlocks, kRepeatBlocks,
                kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_mul_scalar(newton, newton, -0.5f, uint8_t(1), 1, 1, kRepeatBlocks, kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_add_scalar(newton, newton, 1.5f, uint8_t(1), 1, 1, kRepeatBlocks, kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_mul(hidden_inverse, hidden_inverse, newton, uint8_t(1), 1, 1, 1, kRepeatBlocks,
                kRepeatBlocks, kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_mul(newton, key_inverse, key_inverse, uint8_t(1), 1, 1, 1, kRepeatBlocks, kRepeatBlocks,
                kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_mul(newton, newton, key_square, uint8_t(1), 1, 1, 1, kRepeatBlocks, kRepeatBlocks,
                kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_mul_scalar(newton, newton, -0.5f, uint8_t(1), 1, 1, kRepeatBlocks, kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_add_scalar(newton, newton, 1.5f, uint8_t(1), 1, 1, kRepeatBlocks, kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_mul(key_inverse, key_inverse, newton, uint8_t(1), 1, 1, 1, kRepeatBlocks, kRepeatBlocks,
                kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_mul(stat, hidden_inverse, key_inverse, uint8_t(1), 1, 1, 1, kRepeatBlocks,
                kRepeatBlocks, kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_mul(score, score, stat, uint8_t(1), 1, 1, 1, kRepeatBlocks, kRepeatBlocks,
                kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_mul_scalar(score, score, inv_sqrt_hidden, uint8_t(1), 1, 1, kRepeatBlocks,
                       kRepeatBlocks);
        native_device::pipe_fence<PIPE_V, PIPE_S, inspect>();
        bool negative = (reinterpret_cast<__ubuf__ uint32_t *>(score)[0] & 0x80000000U) != 0;
        native_device::pipe_fence<PIPE_S, PIPE_V, release>();
        // Normalization is complete; reuse its three dead blocks for the
        // exponential, denominator and reciprocal refinement respectively.
        auto exponential = key_square, denominator = score, correction = hidden_inverse;
        asc_abs(stat, denominator, uint8_t(1), 1, 1, kRepeatBlocks, kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_max_scalar(stat, stat, 1e-6f, uint8_t(1), 1, 1, kRepeatBlocks, kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_sqrt(stat, stat, uint8_t(1), 1, 1, kRepeatBlocks, kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_mul_scalar(exponential, stat, -1.0f, uint8_t(1), 1, 1, kRepeatBlocks, kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_exp(exponential, exponential, uint8_t(1), 1, 1, kRepeatBlocks, kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_add_scalar(denominator, exponential, 1.0f, uint8_t(1), 1, 1, kRepeatBlocks,
                       kRepeatBlocks);
        asc_duplicate(stat, 1.0f, kFp32BlockElements);
        pipe_barrier(PIPE_V);
        asc_set_vector_mask(0, (uint64_t(1) << kFp32BlockElements) - 1);
        asc_div(stat, stat, denominator, uint8_t(1), 1, 1, 1, kRepeatBlocks, kRepeatBlocks,
                kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_mul(correction, stat, denominator, uint8_t(1), 1, 1, 1, kRepeatBlocks, kRepeatBlocks,
                kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_mul_scalar(correction, correction, -1.0f, uint8_t(1), 1, 1, kRepeatBlocks,
                       kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_add_scalar(correction, correction, 2.0f, uint8_t(1), 1, 1, kRepeatBlocks,
                       kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_mul(stat, stat, correction, uint8_t(1), 1, 1, 1, kRepeatBlocks, kRepeatBlocks,
                kRepeatBlocks);
        if (negative) {
            pipe_barrier(PIPE_V);
            asc_mul(stat, stat, exponential, uint8_t(1), 1, 1, 1, kRepeatBlocks, kRepeatBlocks,
                    kRepeatBlocks);
        }
        native_device::pipe_fence<PIPE_V, PIPE_S, inspect>();
        float gate = active[token] ? stat[0] : 0.0f;
        native_device::pipe_fence<PIPE_S, PIPE_V, release>();
        native_device::pipe_fence<PIPE_V, PIPE_MTE2, reuse>();
        asc_copy_gm2ub(raw, (kv + ((token * (branches + 1) + branches) * D)),
                       uint32_t((D) * sizeof(bfloat16_t)));
        native_device::pipe_fence<PIPE_MTE2, PIPE_V, load>();
        asc_bfloat162float(w, raw, D);
        pipe_barrier(PIPE_V);
        asc_set_vector_mask(0, ~uint64_t(0));
        asc_mul_scalar(work, w, gate, uint8_t(D / kFp32VectorElements), 1, 1, kRepeatBlocks,
                       kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_add(work, h, work, uint8_t(D / kFp32VectorElements), 1, 1, 1, kRepeatBlocks,
                kRepeatBlocks, kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_float2bfloat16_rn(packed, work, D);
        native_device::pipe_fence<PIPE_V, PIPE_MTE3, store>();
        asc_copy_ub2gm((output + (row * D)), packed, uint32_t((D) * sizeof(bfloat16_t)));
        native_device::pipe_fence<PIPE_MTE3, PIPE_V, retired>();
        native_device::pipe_fence<PIPE_V, PIPE_MTE2, reuse>();
    }
    // Per-row raw reuse ends with a consumer Wait on MTE2. Drain that pipe
    // explicitly; a completed MTE3 producer alone does not retire this Wait.
    native_device::pipe_fence<PIPE_V, PIPE_S, vector_drained>();
    native_device::pipe_fence<PIPE_MTE2, PIPE_S, input_drained>();
    native_device::pipe_fence<PIPE_MTE3, PIPE_S, output_drained>();
}

#endif
