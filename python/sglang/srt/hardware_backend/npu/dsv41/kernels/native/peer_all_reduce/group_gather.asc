#include <peer_all_reduce/protocol.h>

using namespace AscendC;
using namespace peer_protocol;
namespace p = peer_all_reduce;

namespace {
constexpr uint32_t kTileBytes = 16 * 1024;

// Both ends derive the channel map from the same producer's compact geometry.
// This holds independently for A and B and for the shorter lane in odd batches.
template <bool Stage>
__aicore__ inline void copy_tiles(GM_ADDR input, GM_ADDR stage, GM_ADDR output, uint32_t outer,
                                  uint32_t rows, uint32_t input_rows, uint32_t valid_rows,
                                  uint32_t dst_row, uint32_t row_bytes, bool write_output,
                                  uint32_t channel) {
    if (rows == 0 || row_bytes == 0)
        return;
    const uint32_t plane_bytes = rows * row_bytes;
    const uint32_t share = (outer * plane_bytes + p::kWorkers - 1) / p::kWorkers;
    const uint32_t aligned_share = (share + 31) & ~31U;
    const uint32_t tile_bytes = aligned_share < kTileBytes ? aligned_share : kTileBytes;
    const uint32_t tiles_per_plane = (plane_bytes + tile_bytes - 1) / tile_bytes;
    auto ub = reinterpret_cast<__ubuf__ uint8_t *>(uint64_t(0));
    for (uint32_t tile = channel; tile < outer * tiles_per_plane; tile += p::kWorkers) {
        const uint32_t plane = tile / tiles_per_plane;
        const uint32_t offset = (tile % tiles_per_plane) * tile_bytes;
        const uint32_t remaining = plane_bytes - offset;
        const uint32_t bytes = remaining < tile_bytes ? remaining : tile_bytes;
        auto compact = stage + plane * plane_bytes + offset;
        if constexpr (Stage) {
            asc_copy_gm2ub(ub, input + plane * input_rows * row_bytes + offset, bytes);
        } else {
            asc_copy_gm2ub(ub, compact, bytes);
        }
        native_device::pipe_fence<PIPE_MTE2, PIPE_MTE3, EVENT_ID0>();
        if constexpr (Stage) {
            asc_copy_ub2gm(compact, ub, bytes);
        }
        if (write_output) {
            auto out = output + (plane * valid_rows + dst_row) * row_bytes + offset;
            asc_copy_ub2gm(out, ub, bytes);
        }
        native_device::pipe_fence<PIPE_MTE3, PIPE_MTE2, EVENT_ID0>();
    }
}
} // namespace

extern "C" __global__ __aicore__ void peer_group_gather(
    GM_ADDR in_a, GM_ADDR in_b, GM_ADDR out_a, GM_ADDR out_b, GM_ADDR local, GM_ADDR peer,
    uint32_t rank, uint32_t outer, uint32_t local_rows, uint32_t valid_rows,
    uint32_t row_bytes_a, uint32_t row_bytes_b, uint32_t skip_own_output) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    InitSocState();
    const uint32_t channel = GetBlockIdx();
    // TP2 already has both IPC bases in the captured launch arguments.
    const uint64_t epoch = peer_protocol::begin(local, nullptr, 2, peer);
    const uint32_t own_rows = rank == 0 ? local_rows : valid_rows - local_rows;
    const uint32_t peer_rows = valid_rows - own_rows;
    const uint32_t own_dst = rank == 0 ? 0 : local_rows;
    const uint32_t peer_dst = rank == 0 ? local_rows : 0;
    auto stage = local + p::kControlBytes;
    auto remote = peer + p::kControlBytes;
    copy_tiles<true>(in_a, stage, out_a, outer, own_rows, local_rows, valid_rows, own_dst,
                     row_bytes_a, !skip_own_output, channel);
    copy_tiles<true>(in_b, stage + outer * own_rows * row_bytes_a, out_b, outer, own_rows,
                     local_rows, valid_rows, own_dst, row_bytes_b, !skip_own_output, channel);
    // A ready credit covers only this channel's tiles, including an empty set.
    native_device::pipe_fence<PIPE_MTE3, PIPE_S, EVENT_ID0>();
    publish(signal(local, 1, channel), epoch);
    await(signal(peer, 1, channel), epoch);
    native_device::pipe_fence<PIPE_S, PIPE_MTE2, EVENT_ID0>();
    copy_tiles<false>(nullptr, remote, out_a, outer, peer_rows, local_rows, valid_rows, peer_dst,
                      row_bytes_a, true, channel);
    copy_tiles<false>(nullptr, remote + outer * peer_rows * row_bytes_a, out_b, outer, peer_rows,
                      local_rows, valid_rows, peer_dst, row_bytes_b, true, channel);
    peer_protocol::finish(local, epoch);
}
