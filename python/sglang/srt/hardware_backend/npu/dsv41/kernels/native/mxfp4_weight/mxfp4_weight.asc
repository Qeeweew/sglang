// Startup-only compressed E2M1 -> native NZ C0=16 rank-INT4 and exact FP16 S/2.
// DMA reads complete native N16 blocks. All data conversion/reordering is vector
// work in UB; there are no scalar reads of checkpoint bytes or scale values.
#include <common/device.h>
#include <kernel_operator.h>
#include <c_api/asc_simd.h>
#include <common/arch2201.h>
#include <mxfp4_weight/format.h>
using namespace AscendC;
using namespace mxfp4_weight;

namespace {
// arch2201 C++ Gather(count) emits NORMAL-mask full repeats plus one tail,
// unlike the C count overload, which enters and exits COUNTER for every call.
// The preceding count Cast/arithmetic has restored NORMAL mode. Preserve the
// original mask bitmap on return; no DMA, scratch or synchronization is owned here.
template <uint32_t Elements>
__aicore__ inline void gather_panel(__ubuf__ uint16_t *output, __ubuf__ uint16_t *source,
                                    __ubuf__ uint32_t *offsets) {
    constexpr uint32_t kRepeatElements = ONE_REPEAT_BYTE_SIZE / sizeof(uint16_t);
    constexpr uint16_t kRepeatStride = ONE_REPEAT_BYTE_SIZE / ONE_BLK_SIZE;
    constexpr uint32_t kMaskWordBits = sizeof(uint64_t) * kByteBits;
    constexpr uint32_t kFullRepeats = Elements / kRepeatElements;
    constexpr uint32_t kTailElements = Elements % kRepeatElements;
    static_assert(kFullRepeats <= UINT8_MAX);
    if constexpr (kFullRepeats) {
        asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
        asc_gather(output, source, offsets, kRepeatStride, uint8_t(kFullRepeats));
    }
    if constexpr (kTailElements) {
        constexpr uint64_t kLowMask =
            kTailElements >= kMaskWordBits ? UINT64_MAX : (uint64_t(1) << kTailElements) - 1;
        constexpr uint64_t kHighMask = kTailElements > kMaskWordBits
                                           ? (uint64_t(1) << (kTailElements - kMaskWordBits)) - 1
                                           : 0;
        constexpr uint32_t kTailOffset = Elements - kTailElements;
        asc_set_vector_mask(kHighMask, kLowMask);
        asc_gather(output + kTailOffset, source, offsets + kTailOffset, kRepeatStride, uint8_t(1));
    }
}
} // namespace

__global__ __aicore__ void mxfp4_pack(GM_ADDR codes_addr, GM_ADDR scales_addr, GM_ADDR tables_addr,
                                      GM_ADDR packed_addr, GM_ADDR s2_addr) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    constexpr int64_t k = MXFP4_WEIGHT_K, n = MXFP4_WEIGHT_N;
    constexpr int64_t panel_k = MXFP4_WEIGHT_PANEL_K;
    constexpr bool compact = MXFP4_WEIGHT_COMPACT;
    constexpr uint32_t row_bytes =
        (panel_k / kCodesPerByte + ONE_BLK_SIZE - 1) / ONE_BLK_SIZE * ONE_BLK_SIZE;
    constexpr uint32_t raw_code_elements = kPackColumns * row_bytes,
                       rank_group_elements =
                           panel_k / kCodesPerByte * (kPackColumns / kNibblesPerHalfword);
    constexpr uint32_t output_padded_half_elements = panel_k * (kPackColumns / kNibblesPerHalfword),
                       scale_elements = panel_k / kScaleGroup * kPackColumns;
    constexpr int64_t panels = k / panel_k, ntiles = n / kPackColumns;
    InitSocState();
    asc_set_copy_pad_val(uint8_t(0));
    constexpr uint32_t kSelectScalarBytes = ONE_BLK_SIZE * sizeof(half);
    static_assert(TMP_UB_OFFSET + kSelectScalarBytes <= TOTAL_UB_SIZE);
    auto select_scalar = reinterpret_cast<__ubuf__ half *>(uint64_t(TMP_UB_OFFSET));
    // Preserve the original packed arena layout. Each extent is aligned to
    // ONE_BLK_SIZE by the panel/format contract; offsets are computed once.
    constexpr uint32_t raw_offset = 0;
    constexpr uint32_t half_offset = raw_offset + raw_code_elements;
    constexpr uint32_t index_offset = half_offset + raw_code_elements * sizeof(half);
    constexpr uint32_t rank_offset = index_offset + raw_code_elements * sizeof(int32_t);
    constexpr uint32_t gather_offset = rank_offset + raw_code_elements * sizeof(uint16_t);
    constexpr uint32_t acc_offset = gather_offset + rank_group_elements * sizeof(uint16_t);
    constexpr uint32_t output_offset = acc_offset + rank_group_elements * sizeof(uint32_t);
    constexpr uint32_t mask_offset = output_offset + output_padded_half_elements * sizeof(uint16_t);
    constexpr uint32_t lut_offset = mask_offset + rank_group_elements * sizeof(uint16_t);
    constexpr uint32_t source_ids_offset = lut_offset + kLutBytes;
    constexpr uint32_t out_ids_offset = source_ids_offset + rank_group_elements * sizeof(uint32_t);
    constexpr uint32_t scale_ids_offset =
        out_ids_offset + output_padded_half_elements * sizeof(uint32_t);
    static_assert(scale_ids_offset + scale_elements * sizeof(uint32_t) <= TMP_UB_OFFSET);
    auto raw = reinterpret_cast<__ubuf__ uint8_t *>(uint64_t(raw_offset));
    auto halves = reinterpret_cast<__ubuf__ half *>(uint64_t(half_offset));
    auto index = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(index_offset));
    auto ranks = reinterpret_cast<__ubuf__ uint16_t *>(uint64_t(rank_offset));
    auto gathered = reinterpret_cast<__ubuf__ uint16_t *>(uint64_t(gather_offset));
    auto acc = reinterpret_cast<__ubuf__ uint16_t *>(uint64_t(acc_offset));
    auto output = reinterpret_cast<__ubuf__ uint16_t *>(uint64_t(output_offset));
    auto mask = reinterpret_cast<__ubuf__ uint16_t *>(uint64_t(mask_offset));
    auto lut = reinterpret_cast<__ubuf__ uint16_t *>(uint64_t(lut_offset));
    auto source_ids = reinterpret_cast<__ubuf__ uint32_t *>(uint64_t(source_ids_offset));
    auto out_ids = reinterpret_cast<__ubuf__ uint32_t *>(uint64_t(out_ids_offset));
    auto scale_ids = reinterpret_cast<__ubuf__ uint32_t *>(uint64_t(scale_ids_offset));
    __gm__ uint8_t *codes, *scales, *packed, *compact_s2;
    __gm__ uint16_t *s2, *tables16;
    __gm__ uint32_t *tables32;
    codes = reinterpret_cast<__gm__ uint8_t *>(codes_addr);
    scales = reinterpret_cast<__gm__ uint8_t *>(scales_addr);
    packed = reinterpret_cast<__gm__ uint8_t *>(packed_addr);
    s2 = reinterpret_cast<__gm__ uint16_t *>(s2_addr);
    compact_s2 = reinterpret_cast<__gm__ uint8_t *>(s2_addr);
    tables16 = reinterpret_cast<__gm__ uint16_t *>(tables_addr);
    tables32 = reinterpret_cast<__gm__ uint32_t *>(tables_addr);
    constexpr TEventID load = 0;   // one immediately consumed token on this pipe pair
    constexpr TEventID reuse = 0;  // one immediately consumed token on this pipe pair
    constexpr TEventID store = 0;  // one immediately consumed token on this pipe pair
    constexpr TEventID retire = 0; // one immediately consumed token on this pipe pair
    // LUT/gather indices are loaded once per core before either conversion phase.
    asc_copy_gm2ub(lut, tables16, uint32_t((kLutEntries) * sizeof(uint16_t)));
    asc_copy_gm2ub(source_ids, (tables32 + (kTableIndexOffset)),
                   uint32_t((rank_group_elements) * sizeof(uint32_t)));
    asc_copy_gm2ub(out_ids, (tables32 + (kTableIndexOffset + rank_group_elements)),
                   uint32_t((output_padded_half_elements) * sizeof(uint32_t)));
    asc_copy_gm2ub(
        scale_ids,
        (tables32 + (kTableIndexOffset + rank_group_elements + output_padded_half_elements)),
        uint32_t((scale_elements) * sizeof(uint32_t)));
    native_device::pipe_fence<PIPE_MTE2, PIPE_V, load>();
    asc_duplicate(mask, kNibbleMask, rank_group_elements);
    pipe_barrier(PIPE_V);
    for (int64_t job = GetBlockIdx(); job < panels * ntiles; job += MXFP4_WEIGHT_WORKERS) {
        int64_t panel = job / ntiles, col = job % ntiles * kPackColumns;
        asc_copy_gm2ub_align(
            raw, (codes + (col * (k / kCodesPerByte) + panel * (panel_k / kCodesPerByte))),
            kPackColumns, uint32_t(panel_k / kCodesPerByte), 0,
            uint8_t(row_bytes - panel_k / kCodesPerByte), uint32_t((k - panel_k) / kCodesPerByte),
            0);
        native_device::pipe_fence<PIPE_MTE2, PIPE_V, load>();
        asc_uint82half(halves, raw, raw_code_elements);
        pipe_barrier(PIPE_V);
        asc_half2int32_rn(index, halves, raw_code_elements);
        pipe_barrier(PIPE_V);
        asc_shiftleft(reinterpret_cast<__ubuf__ uint32_t *>(index),
                      reinterpret_cast<__ubuf__ uint32_t *>(index), 1U, raw_code_elements);
        pipe_barrier(PIPE_V);
        gather_panel<raw_code_elements>(ranks, lut, reinterpret_cast<__ubuf__ uint32_t *>(index));
        pipe_barrier(PIPE_V);
#pragma unroll
        for (uint32_t phase = 0; phase < kCodesPerByte; ++phase) {
            asc_duplicate((acc + (phase * rank_group_elements)), uint16_t(0), rank_group_elements);
            pipe_barrier(PIPE_V);
#pragma unroll
            for (uint32_t lane = 0; lane < kNibblesPerHalfword; ++lane) {
                gather_panel<rank_group_elements>(
                    gathered, ranks + lane * row_bytes * 2 / sizeof(uint16_t), source_ids);
                pipe_barrier(PIPE_V);
                if (phase) {
                    asc_shiftright(gathered, gathered, uint16_t(kNibbleBits), rank_group_elements);
                    pipe_barrier(PIPE_V);
                }
                asc_and(gathered, gathered, mask, rank_group_elements);
                pipe_barrier(PIPE_V);
                if (lane) {
                    asc_shiftleft(gathered, gathered, uint16_t(lane * kNibbleBits),
                                  rank_group_elements);
                    pipe_barrier(PIPE_V);
                }
                asc_or((acc + (phase * rank_group_elements)), (acc + (phase * rank_group_elements)),
                       gathered, rank_group_elements);
                pipe_barrier(PIPE_V);
            }
        }
        gather_panel<output_padded_half_elements>(output, acc, out_ids);
        native_device::pipe_fence<PIPE_V, PIPE_MTE3, store>();
        asc_copy_ub2gm(packed + col * (k / kCodesPerByte) +
            panel * panel_k * (kPackColumns / kCodesPerByte), reinterpret_cast<__ubuf__ uint8_t *>(output),
            uint32_t(panel_k * kPackColumns / kCodesPerByte));
        native_device::pipe_fence<PIPE_MTE3, PIPE_V, retire>();
        native_device::pipe_fence<PIPE_V, PIPE_MTE2, reuse>();
        // Scales: native C0 complete source rows, padded only inside UB for DMA.
        asc_copy_gm2ub_align(raw,
                             (scales + (col * (k / kScaleGroup) + panel * (panel_k / kScaleGroup))),
                             kPackColumns, uint32_t(panel_k / kScaleGroup), 0,
                             uint8_t(ONE_BLK_SIZE - panel_k / kScaleGroup),
                             uint32_t((k - panel_k) / kScaleGroup), 0);
        native_device::pipe_fence<PIPE_MTE2, PIPE_V, load>();
        asc_uint82half(halves, raw, kPackColumns * ONE_BLK_SIZE);
        pipe_barrier(PIPE_V);
        // Encode scales directly into the final compact/FP16 storage.
        if (compact) {
            // Normal S/2 stores its FP16 high byte. For E<114, encode
            // negative normal S/2*2^10: b=4*(E-113)+168. No scale lookup.
            auto offset = reinterpret_cast<__ubuf__ half *>(ranks);
            asc_set_mask_norm();
            asc_set_vector_mask(~uint64_t(0), ~uint64_t(0));
            asc_lt_scalar(
                raw, halves, half(kNormalMinCode),
                uint8_t((kPackColumns * ONE_BLK_SIZE) / (ONE_REPEAT_BYTE_SIZE / sizeof(half))), 1,
                1, 8, 8);
            asc_duplicate(offset, half(kCompactSubnormalOffset), kPackColumns * ONE_BLK_SIZE);
            pipe_barrier(PIPE_V);
            {
                asc_set_mask_count();
                asc_set_vector_mask(0, ONE_BLK_SIZE);
                asc_duplicate(select_scalar, half(0), uint8_t(1), 1, 8);
                pipe_barrier(PIPE_V);
                asc_set_cmp_mask(select_scalar);
                pipe_barrier(PIPE_V);
                asc_set_vector_mask(0, kPackColumns * ONE_BLK_SIZE);
                if ASCEND_IS_AIV {
                    vsel(offset, offset, raw, 1, 1, 1, 1, 8, 8, 8,
                         uint8_t(SELMODE::VSEL_TENSOR_SCALAR_MODE));
                }
                asc_set_vector_mask(~uint64_t(0), ~uint64_t(0));
                asc_set_mask_norm();
            };
            asc_add_scalar(halves, halves, half(-kScaleExponentOffset),
                           kPackColumns * ONE_BLK_SIZE);
            pipe_barrier(PIPE_V);
            asc_mul_scalar(halves, halves, half(kHighByteExponentUnit),
                           kPackColumns * ONE_BLK_SIZE);
            pipe_barrier(PIPE_V);
            asc_add(halves, halves, offset, kPackColumns * ONE_BLK_SIZE);
            pipe_barrier(PIPE_V);
            gather_panel<scale_elements>(output, reinterpret_cast<__ubuf__ uint16_t *>(halves),
                                         scale_ids);
            pipe_barrier(PIPE_V);
            asc_half2uint8_rn(raw, reinterpret_cast<__ubuf__ half *>(output), scale_elements);
            native_device::pipe_fence<PIPE_V, PIPE_MTE3, store>();
            asc_copy_ub2gm_align(compact_s2 + col * (k / kScaleGroup) +
                panel * (panel_k / kScaleGroup) * kPackColumns, raw,
                uint16_t(1), uint32_t(scale_elements), 0, 0, 0, 0);
        } else {
            asc_half2int32_rn(index, halves, kPackColumns * ONE_BLK_SIZE);
            pipe_barrier(PIPE_V);
            asc_shiftleft(reinterpret_cast<__ubuf__ uint32_t *>(index),
                          reinterpret_cast<__ubuf__ uint32_t *>(index), 1U,
                          kPackColumns * ONE_BLK_SIZE);
            pipe_barrier(PIPE_V);
            gather_panel<kPackColumns * ONE_BLK_SIZE>(ranks, lut + kAlphabet,
                                                      reinterpret_cast<__ubuf__ uint32_t *>(index));
            pipe_barrier(PIPE_V);
            gather_panel<scale_elements>(output, ranks, scale_ids);
            native_device::pipe_fence<PIPE_V, PIPE_MTE3, store>();
            asc_copy_ub2gm(s2 + col * (k / kScaleGroup) +
                panel * (panel_k / kScaleGroup) * kPackColumns, output,
                uint32_t(scale_elements * sizeof(uint16_t)));
        }
        native_device::pipe_fence<PIPE_MTE3, PIPE_V, retire>();
        native_device::pipe_fence<PIPE_V, PIPE_MTE2, reuse>();
    }
    constexpr TEventID kInputDrained = 0;
    native_device::pipe_fence<PIPE_MTE2, PIPE_S, kInputDrained>();
}
