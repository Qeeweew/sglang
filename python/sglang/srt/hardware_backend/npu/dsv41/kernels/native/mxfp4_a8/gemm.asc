#include <c_api/asc_simd.h>
#include <quant_grouped_gemm/schedule.h>
#include <mxfp4_a8/plan.h>

namespace mxfp4_a8 {
using namespace AscendC;
using quant_gmm::Tile;
constexpr int depth = A8_DEPTH, width = A8_WIDTH, workers = A8_WORKERS;
constexpr int rows = tile_rows(depth, width, A8_G32);
constexpr int columns = tile_columns(depth, width, A8_G32), half_n = columns / 2;
constexpr int panel = panel_depth(depth, columns, A8_G32), panels = depth / panel;
constexpr int local = half_n * panel, weight_bytes = columns * panel;
constexpr bool keep_activation = A8_G32 && panels >= slots &&
                                 rows * depth + slots * weight_bytes <= arch2201::kL1Bytes;
constexpr int activation_slots = keep_activation ? panels : slots;
constexpr int elements = quantum_size(local), blocks = local / elements;
constexpr int weight_steps = panels * blocks;
constexpr bool carry_weights = A8_G32 && weight_steps >= slots;
constexpr int lookahead = blocks + 1 < weight_steps ? blocks + 1 : weight_steps - 1;
constexpr int dot_k = dot_depth(columns), chunks = (panel + dot_k - 1) / dot_k;
constexpr int scale_bytes = elements / 64, scale_slot = (scale_bytes + 31) / 32 * 32;
constexpr int result_offset = slots * weight_bytes, result_bytes = rows * columns * 4;
constexpr int worker_bytes = result_offset + slots * result_bytes;
constexpr int raw_base = 0, factor_base = elements, output_base = factor_base + slots * scale_slot;
constexpr int rank_base = output_base + slots * elements,
              bits_base = rank_base + elements * 2 + 256;
constexpr int expanded_base = bits_base + (A8_G32 ? 0 : elements * 2);
constexpr int small_base = expanded_base + elements / 4;
constexpr int mask_base = small_base + elements / 16;
constexpr int final_base = mask_base + 256;
constexpr int final_elements = rows * half_n;
static_assert(final_base + final_elements * 6 + (columns + rows * 9) * 4 <= arch2201::kUbBytes);
static_assert(slots * columns * dot_k <= arch2201::kL0BBytes &&
              slots * rows * dot_k <= arch2201::kL0ABytes);
static_assert(slots * weight_bytes + activation_slots * rows * panel <= arch2201::kL1Bytes);

template <typename Value> __aicore__ inline __ubuf__ Value *ub(int offset) {
    return reinterpret_cast<__ubuf__ Value *>(uint64_t(offset));
}
template <pipe_t From, pipe_t To> __aicore__ inline void fence(int event) {
    set_flag(From, To, ::event_t(event));
    wait_flag(From, To, ::event_t(event));
}
__aicore__ inline int valid_elements(int step) {
    return step % blocks == blocks - 1 ? local - (blocks - 1) * elements : elements;
}
__aicore__ inline void load(const Inputs &args, const Tile &tile, int step, int serial, int lane) {
    const int slot = serial & 1, count = valid_elements(step);
    const int64_t column = int64_t(tile.expert) * width + tile.col;
    const int64_t start =
        column * depth + step / blocks * weight_bytes + lane * local + step % blocks * elements;
    auto raw = ub<uint8_t>(raw_base + slot * elements / 2);
    auto factors = ub<uint8_t>(factor_base + slot * scale_slot);
    if (serial >= slots)
        wait_flag(PIPE_V, PIPE_MTE2, ::event_t(slot));
    asc_copy_gm2ub(raw, reinterpret_cast<__gm__ uint8_t *>(args.codes) + start / 2,
                   uint32_t(count / 2));
    auto source = reinterpret_cast<__gm__ uint8_t *>(args.factors) + start / 64;
    if constexpr (scale_bytes % 32 == 0)
        asc_copy_gm2ub(factors, source, uint32_t(scale_bytes));
    else
        asc_copy_gm2ub_align(factors, source, 1, count / 64, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, ::event_t(slot));
}
__aicore__ inline void decode(int step, int serial, int known) {
    const int slot = serial & 1, count = valid_elements(step);
    auto raw = ub<uint8_t>(raw_base + slot * elements / 2);
    auto factors = ub<uint8_t>(factor_base + slot * scale_slot);
    wait_flag(PIPE_MTE2, PIPE_V, ::event_t(slot));
    auto rank = ub<half>(rank_base);
    auto bits = ub<int16_t>(bits_base);
    auto small = ub<half>(small_base);
    auto expanded = ub<half>(expanded_base);
    auto decoded = ub<int8_t>(output_base + slot * elements);
    const uint8_t repeats = count / 128;
    pipe_barrier(PIPE_V);
    if constexpr (elements % (128 * group) == 0) {
        asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
        asc_int42half(small, reinterpret_cast<__ubuf__ int4b_t *>(factors),
                      uint8_t(count / (128 * group)), 1, 1, 8, 2);
    } else {
        asc_int42half(small, reinterpret_cast<__ubuf__ int4b_t *>(factors),
                      uint32_t(count / group));
        asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
    }
#if A8_G32
    asc_int42half(rank, reinterpret_cast<__ubuf__ int4b_t *>(raw), repeats, 1, 1, 8, 2);
    if (known < 0 || serial + slots < known * blocks)
        set_flag(PIPE_V, PIPE_MTE2, ::event_t(slot));
    pipe_barrier(PIPE_V);
    asc_set_vector_mask(0, UINT64_MAX);
    for (int offset = 0; offset < 32; offset += 16)
        asc_add_scalar(expanded + offset, small + offset, half(9), uint8_t(count / 1024), 2, 0, 8, 2);
    asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
#else
    const uint8_t pairs = uint8_t(count / 512);
    auto carrier = reinterpret_cast<__ubuf__ int16_t *>(raw);
    asc_shiftleft(bits, carrier, uint16_t(9), pairs, 1, 1, 8, 8);
    asc_shiftleft(bits + elements / 4, carrier, uint16_t(8), pairs, 1, 1, 8, 8);
    asc_shiftleft(bits + elements / 2, carrier, uint16_t(1), pairs, 1, 1, 8, 8);
    asc_shiftright(bits + 3 * elements / 4, carrier, 2, pairs, 1, 1, 8, 8);
    if (known < 0 || serial + slots < known * blocks)
        set_flag(PIPE_V, PIPE_MTE2, ::event_t(slot));
    pipe_barrier(PIPE_V);
    asc_shiftright(bits + elements / 4, bits + elements / 4, 2, pairs, 1, 1, 8, 8);
    asc_set_vector_mask(0, UINT64_MAX);
    for (int offset = 0; offset < 32; offset += 16)
        asc_mul_scalar(expanded + offset, small + offset, half(-4096), uint8_t(count / 1024), 2, 0,
                       8, 2);
    asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
    pipe_barrier(PIPE_V);
    asc_and(reinterpret_cast<__ubuf__ uint16_t *>(rank),
            reinterpret_cast<__ubuf__ uint16_t *>(bits), ub<uint16_t>(mask_base), repeats, 1, 1, 1,
            8, 8, 0);
    pipe_barrier(PIPE_V);
    asc_mul_scalar(rank, rank, half(8), repeats, 1, 1, 8, 8);
#endif
    pipe_barrier(PIPE_V);
    if (serial >= slots)
        wait_flag(PIPE_MTE3, PIPE_V, ::event_t(slot));
#pragma unroll
    for (int atom = 0; atom < elements / 1024; ++atom)
        if (atom * 1024 < count)
            asc_mul_cast_half2int8(decoded + atom * 1024, rank + atom * 1024, expanded + atom * 128,
                                   uint8_t(8), 1, 1, 1, 4, 8, 0);
    set_flag(PIPE_V, PIPE_MTE3, ::event_t(slot));
}
__aicore__ inline void publish(int step, int serial, int lane, __gm__ int8_t *bridge, int known) {
    const int slot = serial & 1, generation = serial / blocks, inner = step % blocks;
    if (!inner && generation >= slots)
        CrossCoreWaitFlag<2, PIPE_MTE3>(2 + (generation & 1));
    wait_flag(PIPE_V, PIPE_MTE3, ::event_t(slot));
    asc_copy_ub2gm(bridge + (generation & 1) * weight_bytes + lane * local + inner * elements,
                   ub<int8_t>(output_base + slot * elements), uint32_t(valid_elements(step)));
    if (inner == blocks - 1)
        CrossCoreSetFlag<2, PIPE_MTE3>(generation & 1);
    if (known < 0 || serial + slots < known * blocks)
        set_flag(PIPE_MTE3, PIPE_V, ::event_t(slot));
}

template <bool row_split> __aicore__ inline void finish_tile(const Inputs &args, const Tile &tile, int job, int lane,
                              __gm__ int8_t *bridge, const Tile *ahead) {
    constexpr int channels = row_split ? columns : half_n;
    const int split = (tile.valid + 1) / 2;
    const int offset = row_split ? lane * split : 0;
    const int valid = row_split ? (lane ? tile.valid - split : split) : tile.valid;
    const int first_col = row_split ? 0 : lane * half_n;
    auto dot = ub<int32_t>(final_base);
    auto value = reinterpret_cast<__ubuf__ float *>(dot);
#if A8_BF16
    using Output = bfloat16_t;
#else
    using Output = half;
#endif
    auto out = ub<Output>(final_base + final_elements * 4);
    auto channel = ub<float>(final_base + final_elements * 6);
    auto token = channel + channels;
    auto broadcast = token + rows;
    auto source =
        reinterpret_cast<__gm__ int32_t *>(bridge + result_offset + (job & 1) * result_bytes);
    auto dst = reinterpret_cast<__gm__ Output *>(args.output) + int64_t(tile.row + offset) * width + tile.col + first_col;
    if constexpr (A8_G32) {
        if (job)
            wait_flag(PIPE_V, PIPE_MTE2, ::event_t(6));
    }
    asc_copy_gm2ub(channel,
                   reinterpret_cast<__gm__ float *>(args.channel) + int64_t(tile.expert) * width +
                       tile.col + first_col,
                   uint32_t(channels * 4));
    asc_copy_gm2ub_align(token, reinterpret_cast<__gm__ float *>(args.token) + tile.row + offset, 1,
                         valid * 4, 0, 0, 0, 0);
    CrossCoreWaitFlag<2, PIPE_MTE2>(4 + (job & 1));
    if constexpr (row_split)
        asc_copy_gm2ub(dot, source + offset * columns, uint32_t(valid * columns * 4));
    else
        asc_copy_gm2ub(dot, source + first_col, uint16_t(valid), channels / 8, channels / 8, 0);
    set_flag(PIPE_MTE2, PIPE_V, ::event_t(6));
    if constexpr (carry_weights) {
        if (ahead)
            load(args, *ahead, lookahead, (job + slots) * weight_steps + lookahead, lane);
    }
    wait_flag(PIPE_MTE2, PIPE_V, ::event_t(6));
    asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
    asc_brcb(reinterpret_cast<__ubuf__ uint32_t *>(broadcast),
             reinterpret_cast<__ubuf__ uint32_t *>(token), 1, 8, uint8_t((valid + 7) / 8));
    asc_int322float_rn(value, dot, uint32_t(valid * channels));
    pipe_barrier(PIPE_V);
    for (int col = 0; col < channels; col += 64) {
        asc_set_vector_mask(0, channels - col >= 64 ? UINT64_MAX : UINT32_MAX);
        asc_mul(value + col, value + col, channel + col, uint8_t(valid), 1, 1, 1, channels / 8,
                channels / 8, 0);
    }
    pipe_barrier(PIPE_V);
    for (int col = 0; col < channels; col += 64) {
        asc_set_vector_mask(0, channels - col >= 64 ? UINT64_MAX : UINT32_MAX);
        asc_mul(value + col, value + col, broadcast, uint8_t(valid), 1, 1, 0, channels / 8,
                channels / 8, 1);
    }
    pipe_barrier(PIPE_V);
    asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
    if constexpr (A8_G32) {
        if (job)
            wait_flag(PIPE_MTE3, PIPE_V, ::event_t(6));
    }
#if A8_BF16
    asc_float2bfloat16_rn(out, value, uint32_t(valid * channels));
#else
    asc_float2half_rn(out, value, uint32_t(valid * channels));
#endif
    if constexpr (A8_G32)
        set_flag(PIPE_V, PIPE_MTE2, ::event_t(6));
    fence<PIPE_V, PIPE_MTE3>(6);
    asc_copy_ub2gm(dst, out, uint16_t(valid), channels / 16, 0, uint16_t((width - channels) / 16));
    if constexpr (A8_G32)
        set_flag(PIPE_MTE3, PIPE_V, ::event_t(6));
    else
        fence<PIPE_MTE3, PIPE_MTE2>(6);
}
__aicore__ inline void finish(const Inputs &args, const Tile &tile, int job, int lane, __gm__ int8_t *bridge,
                              const Tile *ahead = nullptr) {
    if constexpr (rows > fractal_rows) {
        if (tile.valid > fractal_rows) {
            finish_tile<true>(args, tile, job, lane, bridge, ahead);
            return;
        }
    }
    finish_tile<false>(args, tile, job, lane, bridge, ahead);
}

__aicore__ inline void cube(const Inputs &args, const Tile &tile, int part, int generation, int job,
                            __gm__ int8_t *bridge, int live_rows, int known, bool same_activation) {
    const int slot = generation & 1;
    auto left = reinterpret_cast<__cbuf__ int8_t *>(uint64_t((keep_activation ? part : slot) * rows * panel));
    auto right =
        reinterpret_cast<__cbuf__ int8_t *>(uint64_t(activation_slots * rows * panel + slot * weight_bytes));
    auto acc = reinterpret_cast<__cc__ int32_t *>(uint64_t(0));
    if (generation >= slots)
        wait_flag(PIPE_MTE1, PIPE_MTE2, ::event_t(slot));
    if (!keep_activation || !same_activation) {
        asc_copy_gm2l1_nd2nz(left, reinterpret_cast<__gm__ int8_t *>(args.activation) +
                                 int64_t(tile.row) * depth + part * panel,
                             1, uint16_t(tile.valid), uint16_t(panel), 0, uint16_t(depth),
                             uint16_t(live_rows), 1, 0);
        set_flag(PIPE_MTE2, PIPE_MTE1, ::event_t(slot));
    }
    CrossCoreWaitFlag<2, PIPE_MTE2>(slot);
    asc_copy_gm2l1(right, bridge + slot * weight_bytes, uint32_t(weight_bytes));
    if (known < 0 || generation + slots < known)
        CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
    set_flag(PIPE_MTE2, PIPE_MTE1, ::event_t(2 + slot));
    if (!keep_activation || !same_activation)
        wait_flag(PIPE_MTE2, PIPE_MTE1, ::event_t(slot));
    for (int chunk = 0; chunk < chunks; ++chunk) {
        const int serial = generation * chunks + chunk, operand = serial & 1;
        const int live = chunk + 1 == chunks ? panel - chunk * dot_k : dot_k;
        auto left0 = reinterpret_cast<__ca__ int8_t *>(uint64_t(operand * rows * dot_k));
        auto right0 = reinterpret_cast<__cb__ int8_t *>(uint64_t(operand * columns * dot_k));
        if (serial >= slots)
            wait_flag(PIPE_M, PIPE_MTE1, ::event_t(operand));
        auto src = left + chunk * live_rows * dot_k;
        if (live_rows == fractal_rows)
            asc_copy_l12l0a(left0, src, 0, uint8_t(live / group), 1, 0);
        else
            asc_copy_l12l0a(left0, src, live, live_rows, 0, 0, 1, 1, 1, 1, 1, 1, false, false, false, false, live);
        if (!chunk)
            wait_flag(PIPE_MTE2, PIPE_MTE1, ::event_t(2 + slot));
        asc_copy_l12l0b_trans(right0, right + chunk * columns * dot_k, 0,
                              uint8_t(columns * live / 1024), 1, 1, false, 0);
        if (chunk + 1 == chunks && (known < 0 || generation + slots < known))
            set_flag(PIPE_MTE1, PIPE_MTE2, ::event_t(slot));
        fence<PIPE_MTE1, PIPE_M>(operand);
        const uint8_t unit = part + 1 == panels && chunk + 1 == chunks ? 3 : 2;
        asc_mmad(acc, left0, right0, uint16_t(live_rows), uint16_t(live), uint16_t(columns), unit, false,
                 false, !part && !chunk);
        if (live_rows / fractal_rows * (columns / fractal_rows) < 10)
            pipe_barrier(PIPE_M);
        if (known < 0 || serial + slots < known * chunks)
            set_flag(PIPE_M, PIPE_MTE1, ::event_t(operand));
    }
    if (part + 1 == panels) {
        auto result =
            reinterpret_cast<__gm__ int32_t *>(bridge + result_offset + (job & 1) * result_bytes);
        const int fix_rows = keep_activation && tile.valid > rows / 2 ? live_rows : tile.valid;
        asc_copy_l0c2gm(result, acc, uint16_t(columns), uint16_t(fix_rows), columns, live_rows, 3,
                        uint64_t(QuantMode_t::NoQuant), 0, false, true);
        CrossCoreSetFlag<2, PIPE_FIX>(4 + (job & 1));
    }
}
} // namespace mxfp4_a8

extern "C" __global__ __mix__(1, 2) void mxfp4_a8_kernel(mxfp4_a8::Inputs args) {
    using namespace mxfp4_a8;
    if (!reinterpret_cast<__gm__ const int32_t *>(args.routing)[grouped_metadata::kActiveCount])
        return;
    int core = AscendC::GetBlockIdx();
    if ASCEND_IS_AIV {
        core /= 2;
    }
    const int lane = AscendC::GetSubBlockIdx();
    auto bridge = reinterpret_cast<__gm__ int8_t *>(args.scratch) + int64_t(core) * worker_bytes;
    quant_gmm::Schedule<rows, columns> schedule(reinterpret_cast<GM_ADDR>(args.routing),
                                                args.experts, panels, width);
    Tile tile{}, previous{};
    int generation = 0, job = 0, previous_rows = 0;
    bool more = false;
    if (!schedule.next(core, tile))
        return;
    AscendC::InitSocState();
    AscendC::SetSaturationFlag<AscendC::SaturationMode::FLOAT>(false);
    const int known = schedule.known_steps(core, workers);
#if !A8_G32
    if ASCEND_IS_AIV {
        asc_duplicate(ub<uint16_t>(mask_base), uint16_t(0x8e00), uint32_t(128));
    }
#endif
    if ASCEND_IS_AIC {
        asc_set_l0c_copy_params(1, 0, 0);
        fence<PIPE_S, PIPE_FIX>(0);
        if constexpr (rows > fractal_rows)
            set_l3d_rpt(uint64_t(1) << 16);
    }
    do {
        if ASCEND_IS_AIC {
            const int live_rows = rows == fractal_rows || (keep_activation && tile.valid > rows / 2)
                                      ? rows : (tile.valid + 15) / 16 * 16;
            if constexpr (rows > fractal_rows) {
                if (live_rows != previous_rows) {
                    if (job)
                        fence<PIPE_FIX, PIPE_MTE1>(6);
                    if (live_rows > fractal_rows) {
                        fence<PIPE_MTE1, PIPE_S>(6);
                        set_fmatrix(uint64_t(live_rows) | (uint64_t(1) << 16));
                        fence<PIPE_S, PIPE_MTE1>(6);
                    }
                    previous_rows = live_rows;
                }
            }
            const bool same_activation = keep_activation && job && tile.row == previous.row && tile.valid == previous.valid;
            for (int part = 0; part < panels; ++part)
                cube(args, tile, part, generation + part, job, bridge, live_rows, known, same_activation);
            if constexpr (keep_activation)
                previous = tile;
        }
        if ASCEND_IS_AIV {
            for (int step = carry_weights && job ? lookahead + 1 : 0;
                 step < weight_steps + (carry_weights ? 0 : slots); ++step) {
                const int serial = generation * blocks + step;
                if (step < weight_steps)
                    load(args, tile, step, serial, lane);
                if (step >= 1 && step <= weight_steps)
                    decode(step - 1, serial - 1, known);
                if (step >= 2)
                    publish(step - 2, serial - 2, lane, bridge, known);
            }
        }
        Tile ahead{};
        if constexpr (carry_weights)
            more = (known < 0 || generation + panels < known) && schedule.next(core + (job + 1) * workers, ahead);
        if ASCEND_IS_AIV {
            const int next_serial = (generation + panels) * blocks;
            if constexpr (carry_weights) {
                if (more) {
                    for (int step = 0; step < lookahead; ++step) {
                        const int serial = next_serial + step;
                        load(args, ahead, step, serial, lane);
                        decode(serial - 1, serial - 1, known);
                        publish(serial - 2, serial - 2, lane, bridge, known);
                    }
                    const int serial = next_serial + lookahead;
                    decode(serial - 1, serial - 1, known);
                    publish(serial - 2, serial - 2, lane, bridge, known);
                } else {
                    decode(weight_steps - 1, next_serial - 1, known);
                    publish(weight_steps - 2, next_serial - 2, lane, bridge, known);
                    publish(weight_steps - 1, next_serial - 1, lane, bridge, known);
                }
            }
            if (job)
                finish(args, previous, job - 1, lane, bridge, more ? &ahead : nullptr);
            else if (carry_weights && more)
                load(args, ahead, lookahead, next_serial + lookahead, lane);
            previous = tile;
        }
        generation += panels;
        ++job;
        if constexpr (carry_weights)
            tile = ahead;
        else
            more = (known < 0 || generation < known) && schedule.next(core + job * workers, tile);
    } while (more);
    if ASCEND_IS_AIV {
        if (job)
            finish(args, previous, job - 1, lane, bridge);
        if constexpr (A8_G32) {
            wait_flag(PIPE_V, PIPE_MTE2, ::event_t(6));
            wait_flag(PIPE_MTE3, PIPE_V, ::event_t(6));
        }
    }
    for (int slot = 0; known < 0 && slot < slots; ++slot) {
        if ASCEND_IS_AIV {
            if (slot < generation * blocks) {
                wait_flag(PIPE_V, PIPE_MTE2, ::event_t(slot));
                wait_flag(PIPE_MTE3, PIPE_V, ::event_t(slot));
            }
            if (slot < generation)
                AscendC::CrossCoreWaitFlag<2, PIPE_MTE3>(2 + slot);
        }
        if ASCEND_IS_AIC {
            if (slot < generation)
                wait_flag(PIPE_MTE1, PIPE_MTE2, ::event_t(slot));
            if (slot < generation * chunks)
                wait_flag(PIPE_M, PIPE_MTE1, ::event_t(slot));
        }
    }
    pipe_barrier(PIPE_ALL);
}
