// Software E4M3FN/E8M0 decode. Full vector tiles and a runtime tail share the
// same raw-pointer pipeline; request row counts are runtime launch inputs.
#include <kernel_operator.h>
#include <c_api/asc_simd.h>
#include <engram/format.h>
using namespace AscendC;
using namespace engram;

namespace {
inline constexpr int64_t kVocabularyRows = ENGRAM_VOCAB;
inline constexpr int64_t kWidth = ENGRAM_WIDTH;
inline constexpr int64_t kWorkers = ENGRAM_WORKERS;
} // namespace

class EngramGather {
    __gm__ uint8_t *codes_, *exponents_;
    __gm__ int64_t *ids_;
    __gm__ bfloat16_t *output_;
    __ubuf__ uint8_t *raw_;
    __ubuf__ half *half_;
    __ubuf__ int32_t *offsets_;
    __ubuf__ float *value_, *scale_, *lookup_;
    __ubuf__ bfloat16_t *packed_;
    __ubuf__ uint32_t *groups_;
    bool raw_loaded_ = false;
    static constexpr TEventID kLoaded = 0, kLookupReady = 1, kRawFree = 0, kPackedReady = 0,
                              kPackedFree = 0;
    static constexpr TEventID kOutputDrained = 0;
    __aicore__ inline void decode_store(int64_t source, int64_t destination, uint32_t column,
                                        uint32_t count, bool successor) {
        if (source < 0 || source >= kVocabularyRows)
            asc_duplicate(value_, 0.0f, count);
        else {
            // Reuse only for an actual successor import. Every MTE2 wait
            // is followed by DMA -> MTE2_V -> Vector -> output DMA, even
            // when later IDs are invalid and never read the raw storage.
            if (raw_loaded_) {
                set_flag(PIPE_V, PIPE_MTE2, ::event_t(kRawFree));
                wait_flag(PIPE_V, PIPE_MTE2, ::event_t(kRawFree));
            }
            raw_loaded_ = true;
            asc_copy_gm2ub(raw_, (codes_ + (source * kWidth + column)),
                           uint32_t((count) * sizeof(uint8_t)));
            const uint32_t scales = count / kScaleGroupElements;
            asc_copy_gm2ub_align((raw_ + (kDecodeCapacityElements)),
                                 (exponents_ + ((source * kWidth + column) / kScaleGroupElements)),
                                 1, scales, 0, uint8_t(kDmaBlockBytes - scales), 0, 0);
            set_flag(PIPE_MTE2, PIPE_V, ::event_t(kLoaded));
            wait_flag(PIPE_MTE2, PIPE_V, ::event_t(kLoaded));
            asc_uint82half(half_, raw_, count);
            pipe_barrier(PIPE_V);
            asc_half2int32_rn(offsets_, half_, count);
            pipe_barrier(PIPE_V);
            asc_shiftleft(reinterpret_cast<__ubuf__ uint32_t *>(offsets_),
                          reinterpret_cast<__ubuf__ uint32_t *>(offsets_), uint32_t(2), count);
            pipe_barrier(PIPE_V);
            asc_gather(value_, lookup_, reinterpret_cast<__ubuf__ uint32_t *>(offsets_), count);
            pipe_barrier(PIPE_V);
            asc_uint82half(half_, (raw_ + (kDecodeCapacityElements)), kDmaBlockBytes);
            pipe_barrier(PIPE_V);
            asc_half2int32_rn(offsets_, half_, kDmaBlockBytes);
            pipe_barrier(PIPE_V);
            asc_shiftleft(reinterpret_cast<__ubuf__ uint32_t *>(offsets_),
                          reinterpret_cast<__ubuf__ uint32_t *>(offsets_), uint32_t(2),
                          kDmaBlockBytes);
            pipe_barrier(PIPE_V);
            asc_gather(scale_, (lookup_ + (kByteValues)),
                       reinterpret_cast<__ubuf__ uint32_t *>(offsets_), kDmaBlockBytes);
            pipe_barrier(PIPE_V);
            // Gather output cannot alias its source. The index tile is dead
            // after the LUT read and becomes a disjoint expanded-scale tile.
            asc_gather(reinterpret_cast<__ubuf__ float *>(offsets_), scale_, groups_, count);
            pipe_barrier(PIPE_V);
            asc_mul(value_, value_, reinterpret_cast<__ubuf__ float *>(offsets_), count);
        }
        pipe_barrier(PIPE_V);
        asc_float2bfloat16_rn(packed_, value_, count);
        set_flag(PIPE_V, PIPE_MTE3, ::event_t(kPackedReady));
        wait_flag(PIPE_V, PIPE_MTE3, ::event_t(kPackedReady));
        asc_copy_ub2gm((output_ + (destination * kWidth + column)), packed_,
                       uint32_t((count) * sizeof(bfloat16_t)));
        if (successor) {
            // Every tile writes packed output. A following tile consumes
            // this Vector wait before packing its own output.
            set_flag(PIPE_MTE3, PIPE_V, ::event_t(kPackedFree));
            wait_flag(PIPE_MTE3, PIPE_V, ::event_t(kPackedFree));
        }
    }

  public:
    __aicore__ inline void run(GM_ADDR codes, GM_ADDR exponents, GM_ADDR ids, GM_ADDR output,
                               GM_ADDR tables, int64_t rows) {
        InitSocState();
        asc_set_copy_pad_val(uint8_t(0));
        SetSaturationFlag<SaturationMode::FLOAT>(false);
        static_assert(DecodeLayout::total_bytes <= TOTAL_UB_SIZE);
        raw_ = reinterpret_cast<__ubuf__ uint8_t *>(uint64_t(DecodeLayout::raw));
        half_ = reinterpret_cast<__ubuf__ half *>(uint64_t(DecodeLayout::half));
        offsets_ = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(DecodeLayout::offsets));
        value_ = reinterpret_cast<__ubuf__ float *>(uint64_t(DecodeLayout::value));
        scale_ = reinterpret_cast<__ubuf__ float *>(uint64_t(DecodeLayout::scale));
        packed_ = reinterpret_cast<__ubuf__ bfloat16_t *>(uint64_t(DecodeLayout::packed));
        lookup_ = reinterpret_cast<__ubuf__ float *>(uint64_t(DecodeLayout::lookup));
        groups_ = reinterpret_cast<__ubuf__ uint32_t *>(uint64_t(DecodeLayout::groups));
        codes_ = reinterpret_cast<__gm__ uint8_t *>(codes);
        exponents_ = reinterpret_cast<__gm__ uint8_t *>(exponents);
        ids_ = reinterpret_cast<__gm__ int64_t *>(ids);
        output_ = reinterpret_cast<__gm__ bfloat16_t *>(output);
        __gm__ float *source_lookup;
        source_lookup = reinterpret_cast<__gm__ float *>(tables);
        asc_copy_gm2ub(lookup_, source_lookup, uint32_t((kCodebookElements) * sizeof(float)));
        // Scale-group byte offsets are a format constant, not an input.
        // Build eight32-element runs in UB instead of importing a GM table
        // and carrying another pointer through the launch parameter block.
        asc_set_vector_mask(0, (uint64_t(1) << kScaleGroupElements) - 1);
#pragma unroll
        for (uint32_t group = 0; group < kDecodeCapacityElements / kScaleGroupElements; ++group)
            asc_duplicate((groups_ + (group * kScaleGroupElements)),
                          group * uint32_t(sizeof(float)), 1, 1, 8);
        pipe_barrier(PIPE_V);
        // One-shot lookup import owns a different ready token from raw
        // imports: initial Vector setup may still be running when MTE2
        // starts the first raw DMA.
        set_flag(PIPE_MTE2, PIPE_V, ::event_t(kLookupReady));
        wait_flag(PIPE_MTE2, PIPE_V, ::event_t(kLookupReady));
        for (int64_t row = GetBlockIdx(); row < rows; row += kWorkers) {
            const int64_t source = ids_[row];
            uint32_t column = 0;
            for (; column + kDecodeCapacityElements <= kWidth; column += kDecodeCapacityElements)
                decode_store(source, row, column, kDecodeCapacityElements,
                             column + kDecodeCapacityElements < kWidth || row + kWorkers < rows);
            if (column < kWidth)
                decode_store(source, row, column, kWidth - column, row + kWorkers < rows);
        }
        // The final packed tile issues no reuse credit. Every raw wait
        // precedes an actual import and ready handoff; every packed wait
        // precedes a later Cast. Both chains end in this last output DMA.
        set_flag(PIPE_MTE3, PIPE_S, ::event_t(kOutputDrained));
        wait_flag(PIPE_MTE3, PIPE_S, ::event_t(kOutputDrained));
    }
};
__global__ __aicore__ void engram_kernel(GM_ADDR codes, GM_ADDR exponents, GM_ADDR ids,
                                         GM_ADDR output, GM_ADDR tables, int64_t rows) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    EngramGather kernel;
    kernel.run(codes, exponents, ids, output, tables, rows);
}
