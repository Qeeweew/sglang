#include <kernel_operator.h>
#include <w8a16/decode.h>
#include <w8a16/cube.h>

extern "C" __global__ __mix__(1, 2) void w8a16_kernel(GM_ADDR input, GM_ADDR weight, GM_ADDR scales,
                                                     GM_ADDR output, GM_ADDR workspace, int64_t rows) {
    AscendC::InitSocState();
    AscendC::SetSaturationFlag<AscendC::SaturationMode::FLOAT>(false);
    if ASCEND_IS_AIV {
        w8a16::DecodePipeline pipeline;
        pipeline.run(weight, scales, workspace, rows);
    }
    if ASCEND_IS_AIC {
        w8a16::CubePipeline pipeline;
        pipeline.run(input, output, workspace, rows);
    }
}
