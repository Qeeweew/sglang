// V4.1 dense weights: E4M3FN[N,K], one E8M0 exponent per 32x32 tile.
// Ascend C 9.1 public Gather/Cast/DataCopyPad APIs; no native FP8 cast.
#include <kernel_operator.h>
#include <c_api/asc_simd.h>
#include <common/arch2201.h>
#include <fp8_weight/format.h>
using namespace AscendC;
using namespace fp8_weight;
namespace {
// E8M0 checkpoint scales are shared by 32x32 E4M3FN values. Four scale
// columns per job amortize Gather overhead; input dimensions compile from the actual bound
// geometry.
constexpr uint32_t kDmaBytes = ONE_BLK_SIZE;
constexpr uint32_t kFloatLanes = ONE_REPEAT_BYTE_SIZE / sizeof(float);
constexpr uint32_t kFloatBlocksPerRow = kTileColumns * sizeof(float) / kDmaBytes;
constexpr uint32_t kBf16BlocksPerRow = kTileColumns * sizeof(bfloat16_t) / kDmaBytes;
static_assert(kTileElements * (sizeof(uint8_t) + 2 * sizeof(half) + 2 * sizeof(float)) +
                  kLutElements * sizeof(float) + 4 * kTileColumns * sizeof(float) <
              arch2201::kUbBytes);
} // namespace

namespace {
inline constexpr int64_t kRows = FP8_WEIGHT_ROWS;
inline constexpr int64_t kColumns = FP8_WEIGHT_COLS;
inline constexpr int64_t kWorkers = FP8_WEIGHT_WORKERS;
} // namespace

class DenseFp8Weight {
    // One fixed arena, in the same order/alignment as the original buffers.
    static constexpr uint32_t kRaw = 0;
    static constexpr uint32_t kHalf = kRaw + kTileElements;
    static constexpr uint32_t kIndex = kHalf + kTileElements * sizeof(half);
    static constexpr uint32_t kValue = kIndex + kTileElements * sizeof(int32_t);
    static constexpr uint32_t kOutput = kValue + kTileElements * sizeof(float);
    static constexpr uint32_t kScaleRaw = kOutput + kTileElements * sizeof(bfloat16_t);
    static constexpr uint32_t kScale = kScaleRaw + kDmaBytes;
    static constexpr uint32_t kScaleVector = kScale + kScaleGroup * sizeof(float);
    static constexpr uint32_t kLut = kScaleVector + kTileColumns * sizeof(float);
    static constexpr uint32_t kGroups = kLut + kLutElements * sizeof(float);
    static_assert(kGroups + kTileColumns * sizeof(uint32_t) <= arch2201::kUbBytes);
    // Each pipe pair has one live, immediately consumed dependency.
    static constexpr TEventID kInputReady = 0, kInputReusable = 0;
    static constexpr TEventID kOutputReady = 0, kOutputReusable = 0, kVectorDrained = 0;

  public:
    __aicore__ inline void run(GM_ADDR codes_addr, GM_ADDR scale_addr, GM_ADDR out_addr,
                               GM_ADDR lut_addr, GM_ADDR groups_addr) {
        auto raw = reinterpret_cast<__ubuf__ uint8_t *>(uint64_t(kRaw));
        auto halves = reinterpret_cast<__ubuf__ half *>(uint64_t(kHalf));
        auto index = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(kIndex));
        auto value = reinterpret_cast<__ubuf__ float *>(uint64_t(kValue));
        auto output = reinterpret_cast<__ubuf__ bfloat16_t *>(uint64_t(kOutput));
        auto scale_raw = reinterpret_cast<__ubuf__ uint8_t *>(uint64_t(kScaleRaw));
        auto scale = reinterpret_cast<__ubuf__ float *>(uint64_t(kScale));
        auto scale_vector = reinterpret_cast<__ubuf__ float *>(uint64_t(kScaleVector));
        auto lut = reinterpret_cast<__ubuf__ float *>(uint64_t(kLut));
        auto groups = reinterpret_cast<__ubuf__ uint32_t *>(uint64_t(kGroups));
        __gm__ uint8_t *codes, *scales;
        __gm__ bfloat16_t *out;
        __gm__ float *lookup;
        __gm__ uint32_t *offsets;
        codes = reinterpret_cast<__gm__ uint8_t *>(codes_addr);
        scales = reinterpret_cast<__gm__ uint8_t *>(scale_addr);
        out = reinterpret_cast<__gm__ bfloat16_t *>(out_addr);
        lookup = reinterpret_cast<__gm__ float *>(lut_addr);
        offsets = reinterpret_cast<__gm__ uint32_t *>(groups_addr);
        constexpr TEventID ready = kInputReady, load_safe = kInputReusable;
        constexpr TEventID store = kOutputReady, retired = kOutputReusable;
        asc_copy_gm2ub(lut, lookup, uint32_t((kLutElements) * sizeof(float)));
        asc_copy_gm2ub(groups, offsets, uint32_t((kTileColumns) * sizeof(uint32_t)));
        set_flag(PIPE_MTE2, PIPE_V, ::event_t(ready));
        wait_flag(PIPE_MTE2, PIPE_V, ::event_t(ready));
        const int64_t column_tiles = (kColumns + kTileColumns - 1) / kTileColumns;
        const int64_t scale_cols = (kColumns + kScaleGroup - 1) / kScaleGroup;
        const int64_t jobs = ((kRows + kTileRows - 1) / kTileRows) * column_tiles;
        for (int64_t job = GetBlockIdx(); job < jobs; job += kWorkers) {
            const int64_t row = job / column_tiles * kTileRows;
            const int64_t column = job % column_tiles * kTileColumns;
            const uint16_t nr = uint16_t(kRows - row < kTileRows ? kRows - row : kTileRows);
            const uint32_t nc =
                uint32_t(kColumns - column < kTileColumns ? kColumns - column : kTileColumns);
            const uint32_t nc32 = (nc + kDmaBytes - 1) / kDmaBytes * kDmaBytes;
            const uint32_t ns = (nc + kScaleGroup - 1) / kScaleGroup;
            // Fully initialize padded/tail lanes, including unused rows.
            asc_duplicate(reinterpret_cast<__ubuf__ uint16_t *>(raw), uint16_t(0),
                          (kTileElements / 2));
            set_flag(PIPE_V, PIPE_MTE2, ::event_t(load_safe));
            wait_flag(PIPE_V, PIPE_MTE2, ::event_t(load_safe));
            asc_copy_gm2ub_align(raw, (codes + (row * kColumns + column)), nr, nc, 0,
                                 uint8_t(nc32 - nc), uint32_t(kColumns - nc),
                                 (kTileColumns - nc32) / kDmaBytes);
            asc_copy_gm2ub_align(scale_raw,
                                 (scales + (row / kScaleGroup * scale_cols + column / kScaleGroup)),
                                 1, ns, 0, uint8_t(kDmaBytes - ns), 0, 0);
            set_flag(PIPE_MTE2, PIPE_V, ::event_t(ready));
            wait_flag(PIPE_MTE2, PIPE_V, ::event_t(ready));
            asc_uint82half(halves, raw, kTileElements);
            pipe_barrier(PIPE_V);
            asc_half2int32_rn(index, halves, kTileElements);
            pipe_barrier(PIPE_V);
            asc_shiftleft(reinterpret_cast<__ubuf__ uint32_t *>(index),
                          reinterpret_cast<__ubuf__ uint32_t *>(index),
                          uint32_t(__builtin_ctz(sizeof(float))), kTileElements);
            pipe_barrier(PIPE_V);
            asc_gather(value, lut, reinterpret_cast<__ubuf__ uint32_t *>(index), kTileElements);
            pipe_barrier(PIPE_V);
            asc_uint82half(halves, scale_raw, kScaleGroup);
            pipe_barrier(PIPE_V);
            asc_half2int32_rn(index, halves, kScaleGroup);
            pipe_barrier(PIPE_V);
            asc_shiftleft(reinterpret_cast<__ubuf__ uint32_t *>(index),
                          reinterpret_cast<__ubuf__ uint32_t *>(index),
                          uint32_t(__builtin_ctz(sizeof(float))), kScaleGroup);
            pipe_barrier(PIPE_V);
            asc_gather(scale, (lut + (kAlphabet)), reinterpret_cast<__ubuf__ uint32_t *>(index),
                       kScaleGroup);
            pipe_barrier(PIPE_V);
            asc_gather(scale_vector, scale, groups, kTileColumns);
            pipe_barrier(PIPE_V);
            asc_set_vector_mask(0, ~uint64_t(0));
            asc_mul(value, value, scale_vector, kTileRows, 1, 1, 1, kFloatBlocksPerRow,
                    kFloatBlocksPerRow, 0);
            asc_mul((value + (kFloatLanes)), (value + (kFloatLanes)),
                    (scale_vector + (kFloatLanes)), kTileRows, 1, 1, 1, kFloatBlocksPerRow,
                    kFloatBlocksPerRow, 0);
            pipe_barrier(PIPE_V);
            asc_float2bfloat16_rn(output, value, kTileElements);
            set_flag(PIPE_V, PIPE_MTE3, ::event_t(store));
            wait_flag(PIPE_V, PIPE_MTE3, ::event_t(store));
            const uint32_t output_blocks =
                (nc * uint32_t(sizeof(bfloat16_t)) + kDmaBytes - 1) / kDmaBytes;
            asc_copy_ub2gm_align((out + (row * kColumns + column)), output, nr,
                                 nc * uint32_t(sizeof(bfloat16_t)), 0, 0,
                                 kBf16BlocksPerRow - output_blocks,
                                 uint32_t((kColumns - nc) * sizeof(bfloat16_t)));
            set_flag(PIPE_MTE3, PIPE_V, ::event_t(retired));
            wait_flag(PIPE_MTE3, PIPE_V, ::event_t(retired));
        }
        // The next tile's initial clear -> MTE2 handoff protects raw-input
        // reuse. At exit only the final store -> Vector wait remains; retire
        // that consumer directly instead of appending another MTE2 credit.
        set_flag(PIPE_V, PIPE_S, ::event_t(kVectorDrained));
        wait_flag(PIPE_V, PIPE_S, ::event_t(kVectorDrained));
    }
};

__global__ __aicore__ void fp8_weight_kernel(GM_ADDR codes, GM_ADDR scales, GM_ADDR out,
                                             GM_ADDR lut, GM_ADDR groups) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    InitSocState();
    asc_set_copy_pad_val(uint8_t(0));
    SetSaturationFlag<SaturationMode::FLOAT>(false); // E4M3FN NaN and E8M0 overflow semantics.
    DenseFp8Weight kernel;
    kernel.run(codes, scales, out, lut, groups);
}
