#include <kernel_operator.h>
#include <c_api/asc_simd.h>
#include <elementwise/layout.h>
#include <elementwise/row_pipeline.h>
using namespace AscendC;
using namespace elementwise;

#if defined(ELEMENTWISE_RMS)
namespace {
__aicore__ inline void normalize(__ubuf__ float *value, __ubuf__ float *weight,
                                 __ubuf__ float *work, __ubuf__ float *scratch,
                                 __ubuf__ float *stat, uint32_t width, float epsilon) {
    const uint8_t repeats = width / kFp32VectorElements;
    asc_set_vector_mask(0, ~uint64_t(0));
    asc_mul(work, value, value, repeats, 1, 1, 1, kRepeatBlocks, kRepeatBlocks, kRepeatBlocks);
    pipe_barrier(PIPE_V);
    const uint32_t panel = width > kReductionPanelElements ? width / 2 : width;
    reduce_r64(stat, work, scratch, panel);
    if (width > kReductionPanelElements) {
        reduce_r64(stat + RmsStatistics::inverse, work + panel, scratch, panel);
        asc_add(stat, stat, stat + RmsStatistics::inverse, uint32_t(1));
        pipe_barrier(PIPE_V);
    }
    asc_set_vector_mask(0, 1);
    asc_mul_scalar(stat, stat, 1.0f / width, uint8_t(1), 1, 1, kRepeatBlocks, kRepeatBlocks);
    pipe_barrier(PIPE_V);
    asc_add_scalar(stat, stat, epsilon, uint8_t(1), 1, 1, kRepeatBlocks, kRepeatBlocks);
    pipe_barrier(PIPE_V);
    asc_sqrt(stat, stat, uint8_t(1), 1, 1, kRepeatBlocks, kRepeatBlocks);
    asc_duplicate(stat + RmsStatistics::inverse, 1.0f, kFp32BlockElements);
    pipe_barrier(PIPE_V);
    asc_set_vector_mask(0, 1);
    asc_div(stat + RmsStatistics::inverse, stat + RmsStatistics::inverse, stat, uint8_t(1), 1, 1, 1,
            kRepeatBlocks, kRepeatBlocks, kRepeatBlocks);
    pipe_barrier(PIPE_V);
    constexpr uint32_t broadcast = 2 * kFp32BlockElements;
    asc_brcb(reinterpret_cast<__ubuf__ uint32_t *>(stat + broadcast),
             reinterpret_cast<__ubuf__ uint32_t *>(stat + RmsStatistics::inverse), 1, kRepeatBlocks,
             1);
    pipe_barrier(PIPE_V);
    asc_set_vector_mask(0, ~uint64_t(0));
    asc_mul(work, value, stat + broadcast, repeats, 1, 1, 0, kRepeatBlocks, kRepeatBlocks, 0);
    pipe_barrier(PIPE_V);
    asc_mul(work, work, weight, repeats, 1, 1, 1, kRepeatBlocks, kRepeatBlocks, kRepeatBlocks);
    pipe_barrier(PIPE_V);
}
} // namespace

__global__ __aicore__ void rms_norm_kernel(GM_ADDR input_ptr, GM_ADDR weight_ptr,
                                           GM_ADDR output_ptr, float epsilon, int64_t rows) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    InitSocState();
    SetSaturationFlag<SaturationMode::FLOAT>(false); // IEEE Inf/NaN, as in the FP32 reference.
    constexpr uint32_t width = ELEMENTWISE_WIDTH;
    const uint64_t full_tasks = rows / ELEMENTWISE_WORKERS;
    const uint32_t extra_tasks = rows % ELEMENTWISE_WORKERS;
    constexpr RmsLayout layout(2 * kReductionPanelElements, kActiveSlots);
    auto raw = reinterpret_cast<__ubuf__ bfloat16_t *>(uint64_t(layout.raw));
    auto packed = reinterpret_cast<__ubuf__ bfloat16_t *>(uint64_t(layout.packed));
    auto weight_raw = reinterpret_cast<__ubuf__ bfloat16_t *>(uint64_t(layout.weight_raw));
    auto weight = reinterpret_cast<__ubuf__ float *>(uint64_t(layout.weight));
    auto value = reinterpret_cast<__ubuf__ float *>(uint64_t(layout.value));
    auto work = reinterpret_cast<__ubuf__ float *>(uint64_t(layout.work));
    auto scratch = reinterpret_cast<__ubuf__ float *>(uint64_t(layout.scratch));
    auto stat = reinterpret_cast<__ubuf__ float *>(uint64_t(layout.stat));
    __gm__ bfloat16_t *input, *weights, *output;
    input = reinterpret_cast<__gm__ bfloat16_t *>(input_ptr);
    weights = reinterpret_cast<__gm__ bfloat16_t *>(weight_ptr);
    output = reinterpret_cast<__gm__ bfloat16_t *>(output_ptr);
    RowEvents events;
    asc_copy_gm2ub(weight_raw, weights, uint32_t((width) * sizeof(uint16_t)));
    // Weight conversion can execute while MTE2 imports the input row.
    // Separate one-shot ready IDs prevent two pending notifications from
    // sharing a token when Scalar issue runs ahead of Vector.
    constexpr TEventID weight_ready = 2;
    set_flag(PIPE_MTE2, PIPE_V, ::event_t(weight_ready));
    wait_flag(PIPE_MTE2, PIPE_V, ::event_t(weight_ready));
    unpack(weight, weight_raw, width);
    pipe_barrier(PIPE_V);
#if defined(ELEMENTWISE_SINGLE_TILE)
    const uint64_t row_offset = uint64_t(GetBlockIdx()) * width;
    asc_copy_gm2ub(raw, (input + (row_offset)), uint32_t((width) * sizeof(uint16_t)));
    set_flag(PIPE_MTE2, PIPE_V, ::event_t(events.input_ready[0]));
    wait_flag(PIPE_MTE2, PIPE_V, ::event_t(events.input_ready[0]));
    unpack(value, raw, width);
    pipe_barrier(PIPE_V);
    normalize(value, weight, work, scratch, stat, width, epsilon);
    pack(packed, work, width);
    set_flag(PIPE_V, PIPE_MTE3, ::event_t(events.output_ready[0]));
    wait_flag(PIPE_V, PIPE_MTE3, ::event_t(events.output_ready[0]));
    asc_copy_ub2gm((output + (row_offset)), packed, uint32_t((width) * sizeof(uint16_t)));
#else
    const uint64_t core = GetBlockIdx(), cores = ELEMENTWISE_WORKERS;
    const uint64_t tasks = full_tasks + (core < extra_tasks);
    for (uint64_t step = 0; step < tasks + kSlots; ++step) {
        const uint32_t slot = step % kSlots;
        // Retire t-2, load t, compute t-1. The final two iterations only
        // retire packed outputs; no reuse credit has a missing consumer.
        if (step >= kSlots) {
            wait_flag(PIPE_V, PIPE_MTE3, ::event_t(events.output_ready[slot]));
            asc_copy_ub2gm((output + ((core + (step - kSlots) * cores) * width)),
                           (packed + (slot * width)), uint32_t((width) * sizeof(uint16_t)));
            if (step < tasks)
                set_flag(PIPE_MTE3, PIPE_V, ::event_t(events.output_reusable[slot]));
        }
        if (step < tasks) {
            if (step >= kSlots)
                wait_flag(PIPE_V, PIPE_MTE2, ::event_t(events.raw_reusable[slot]));
            asc_copy_gm2ub((raw + (slot * width)), (input + ((core + step * cores) * width)),
                           uint32_t((width) * sizeof(uint16_t)));
            set_flag(PIPE_MTE2, PIPE_V, ::event_t(events.input_ready[slot]));
        }
        if (step >= 1 && step <= tasks) {
            const uint32_t compute_slot = (step - 1) % kSlots;
            wait_flag(PIPE_MTE2, PIPE_V, ::event_t(events.input_ready[compute_slot]));
            unpack(value, (raw + (compute_slot * width)), width);
            if (step + 1 < tasks)
                set_flag(PIPE_V, PIPE_MTE2, ::event_t(events.raw_reusable[compute_slot]));
            pipe_barrier(PIPE_V);
            normalize(value, weight, work, scratch, stat, width, epsilon);
            if (step >= 3)
                wait_flag(PIPE_MTE3, PIPE_V, ::event_t(events.output_reusable[compute_slot]));
            pack((packed + (compute_slot * width)), work, width);
            set_flag(PIPE_V, PIPE_MTE3, ::event_t(events.output_ready[compute_slot]));
        }
    }
#endif
    set_flag(PIPE_MTE3, PIPE_S, ::event_t(events.output_drained));
    wait_flag(PIPE_MTE3, PIPE_S, ::event_t(events.output_drained));
}
#else
#if defined(ELEMENTWISE_STORAGE_FP16)
using Storage = half;
#else
using Storage = bfloat16_t;
#endif
namespace {
__aicore__ inline void activate(__ubuf__ float *gate, __ubuf__ float *up, __ubuf__ float *negative,
                                __ubuf__ float *work, __ubuf__ float *ones, uint32_t tile_elements,
                                float limit) {
    const uint8_t repeats = tile_elements / kFp32VectorElements;
    asc_set_vector_mask(0, ~uint64_t(0));
    asc_min_scalar(gate, gate, limit, repeats, 1, 1, kRepeatBlocks, kRepeatBlocks);
    asc_max_scalar(up, up, -limit, repeats, 1, 1, kRepeatBlocks, kRepeatBlocks);
    pipe_barrier(PIPE_V);
    asc_min_scalar(up, up, limit, repeats, 1, 1, kRepeatBlocks, kRepeatBlocks);
    asc_mul_scalar(negative, gate, -1.0f, repeats, 1, 1, kRepeatBlocks, kRepeatBlocks);
    pipe_barrier(PIPE_V);
    asc_exp(work, negative, repeats, 1, 1, kRepeatBlocks, kRepeatBlocks);
    pipe_barrier(PIPE_V);
    asc_add_scalar(work, work, 1.0f, repeats, 1, 1, kRepeatBlocks, kRepeatBlocks);
    pipe_barrier(PIPE_V);
    asc_div(negative, ones, work, repeats, 1, 1, 1, kRepeatBlocks, 0, kRepeatBlocks);
    pipe_barrier(PIPE_V);
    asc_mul(work, gate, negative, repeats, 1, 1, 1, kRepeatBlocks, kRepeatBlocks, kRepeatBlocks);
    pipe_barrier(PIPE_V);
    asc_mul(work, work, up, repeats, 1, 1, 1, kRepeatBlocks, kRepeatBlocks, kRepeatBlocks);
    pipe_barrier(PIPE_V);
}
} // namespace
__global__ __aicore__ void swiglu_kernel(GM_ADDR gate_ptr, GM_ADDR up_ptr, GM_ADDR count_ptr,
                                         GM_ADDR output_ptr, float limit, int64_t capacity) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    constexpr uint32_t width = ELEMENTWISE_WIDTH;
    constexpr uint32_t rows_per_tile = ELEMENTWISE_TILE_ROWS;
    constexpr uint32_t row_stride = align_elements(width);
    constexpr bool packed_input = ELEMENTWISE_PACKED;
    constexpr uint32_t tile_elements = rows_per_tile * row_stride;
    constexpr SwiGluLayout layout(kSwiGluTileCapacity, kActiveSlots);
    auto gate_raw = reinterpret_cast<__ubuf__ Storage *>(uint64_t(layout.gate_raw));
    auto up_raw = reinterpret_cast<__ubuf__ Storage *>(uint64_t(layout.up_raw));
    auto packed = reinterpret_cast<__ubuf__ Storage *>(uint64_t(layout.packed));
    auto gate = reinterpret_cast<__ubuf__ float *>(uint64_t(layout.gate));
    auto up = reinterpret_cast<__ubuf__ float *>(uint64_t(layout.up));
    auto negative = reinterpret_cast<__ubuf__ float *>(uint64_t(layout.negative));
    auto work = reinterpret_cast<__ubuf__ float *>(uint64_t(layout.work));
    auto ones = reinterpret_cast<__ubuf__ float *>(uint64_t(layout.ones));
    __gm__ Storage *gates, *ups, *output;
    __gm__ int32_t *live_count;
    gates = reinterpret_cast<__gm__ Storage *>(gate_ptr);
    ups = reinterpret_cast<__gm__ Storage *>(up_ptr);
    output = reinterpret_cast<__gm__ Storage *>(output_ptr);
    int64_t rows = capacity;
    if constexpr (ELEMENTWISE_PREFIX) {
        live_count = reinterpret_cast<__gm__ int32_t *>(count_ptr);
        const int64_t live = live_count[0];
        rows = live < 0 ? 0 : (live > capacity ? capacity : live);
    }
    if constexpr (ELEMENTWISE_PREFIX) {
        // The live prefix is device data updated by Graph replay; host launch
        // covers capacity and cannot eliminate this data-dependent decision.
        if (int64_t(GetBlockIdx()) * rows_per_tile >= rows)
            return;
    }
    InitSocState();
    SetSaturationFlag<SaturationMode::FLOAT>(false); // IEEE Inf/NaN, as in the FP32 reference.
    RowEvents events;
#if defined(ELEMENTWISE_SINGLE_TILE)
    const int64_t first = int64_t(GetBlockIdx()) * rows_per_tile;
    asc_duplicate(ones, 1.0f, kFp32VectorElements);
    for (uint32_t lane = 0; lane < rows_per_tile; ++lane)
        if (first + lane < rows) {
            const int64_t input_offset = (first + lane) * width * (packed_input ? 2 : 1);
            asc_copy_gm2ub((gate_raw + (lane * row_stride)), (gates + (input_offset)),
                           uint32_t((width) * sizeof(uint16_t)));
            asc_copy_gm2ub((up_raw + (lane * row_stride)),
                           (ups + (input_offset + (packed_input ? width : 0))),
                           uint32_t((width) * sizeof(uint16_t)));
        }
    set_flag(PIPE_MTE2, PIPE_V, ::event_t(events.input_ready[0]));
    wait_flag(PIPE_MTE2, PIPE_V, ::event_t(events.input_ready[0]));
    pipe_barrier(PIPE_V);
    unpack(gate, gate_raw, tile_elements);
    unpack(up, up_raw, tile_elements);
    pipe_barrier(PIPE_V);
    activate(gate, up, negative, work, ones, tile_elements, limit);
    pack(packed, work, tile_elements);
    set_flag(PIPE_V, PIPE_MTE3, ::event_t(events.output_ready[0]));
    wait_flag(PIPE_V, PIPE_MTE3, ::event_t(events.output_ready[0]));
    for (uint32_t lane = 0; lane < rows_per_tile; ++lane)
        if (first + lane < rows)
            asc_copy_ub2gm((output + ((first + lane) * width)), (packed + (lane * row_stride)),
                           uint32_t((width) * sizeof(uint16_t)));
#else
    asc_duplicate(ones, 1.0f, kFp32VectorElements);
    pipe_barrier(PIPE_V);
    const int64_t core = GetBlockIdx(), cores = ELEMENTWISE_WORKERS;
    const int64_t tiles = (rows + rows_per_tile - 1) / rows_per_tile;
    const int64_t tasks = tiles > core ? (tiles - core + cores - 1) / cores : 0;
    for (int64_t step = 0; step < tasks + kSlots; ++step) {
        const uint32_t slot = step % kSlots;
        if (step >= kSlots) {
            wait_flag(PIPE_V, PIPE_MTE3, ::event_t(events.output_ready[slot]));
            const int64_t first = (core + (step - kSlots) * cores) * rows_per_tile;
            for (uint32_t lane = 0; lane < rows_per_tile; ++lane)
                if (first + lane < rows)
                    asc_copy_ub2gm((output + ((first + lane) * width)),
                                   (packed + (slot * tile_elements + lane * row_stride)),
                                   uint32_t((width) * sizeof(uint16_t)));
            if (step < tasks)
                set_flag(PIPE_MTE3, PIPE_V, ::event_t(events.output_reusable[slot]));
        }
        if (step < tasks) {
            if (step >= kSlots)
                wait_flag(PIPE_V, PIPE_MTE2, ::event_t(events.raw_reusable[slot]));
            const int64_t first = (core + step * cores) * rows_per_tile;
            for (uint32_t lane = 0; lane < rows_per_tile; ++lane)
                if (first + lane < rows) {
                    const int64_t input_offset = (first + lane) * width * (packed_input ? 2 : 1);
                    asc_copy_gm2ub((gate_raw + (slot * tile_elements + lane * row_stride)),
                                   (gates + (input_offset)), uint32_t((width) * sizeof(uint16_t)));
                    asc_copy_gm2ub((up_raw + (slot * tile_elements + lane * row_stride)),
                                   (ups + (input_offset + (packed_input ? width : 0))),
                                   uint32_t((width) * sizeof(uint16_t)));
                }
            set_flag(PIPE_MTE2, PIPE_V, ::event_t(events.input_ready[slot]));
        }
        if (step >= 1 && step <= tasks) {
            const uint32_t compute_slot = (step - 1) % kSlots;
            wait_flag(PIPE_MTE2, PIPE_V, ::event_t(events.input_ready[compute_slot]));
            pipe_barrier(PIPE_V);
            unpack(gate, (gate_raw + (compute_slot * tile_elements)), tile_elements);
            unpack(up, (up_raw + (compute_slot * tile_elements)), tile_elements);
            if (step + 1 < tasks)
                set_flag(PIPE_V, PIPE_MTE2, ::event_t(events.raw_reusable[compute_slot]));
            pipe_barrier(PIPE_V);
            activate(gate, up, negative, work, ones, tile_elements, limit);
            if (step >= 3)
                wait_flag(PIPE_MTE3, PIPE_V, ::event_t(events.output_reusable[compute_slot]));
            pack((packed + (compute_slot * tile_elements)), work, tile_elements);
            set_flag(PIPE_V, PIPE_MTE3, ::event_t(events.output_ready[compute_slot]));
        }
    }
#endif
    set_flag(PIPE_MTE2, PIPE_S, ::event_t(events.load_drained));
    wait_flag(PIPE_MTE2, PIPE_S, ::event_t(events.load_drained));
    set_flag(PIPE_V, PIPE_S, ::event_t(events.scalar_ready));
    wait_flag(PIPE_V, PIPE_S, ::event_t(events.scalar_ready));
    set_flag(PIPE_MTE3, PIPE_S, ::event_t(events.output_drained));
    wait_flag(PIPE_MTE3, PIPE_S, ::event_t(events.output_drained));
}
#endif
