#include <mhc/stats_pipeline.h>
using namespace mhc;
__global__ __vector__ void mhc_stats(GM_ADDR projection, GM_ADDR squares, GM_ADDR scale,
                                     GM_ADDR base, GM_ADDR pre, GM_ADDR post, GM_ADDR comb,

#if defined(MHC_STATS_POST)
                                     GM_ADDR input, GM_ADDR residual, GM_ADDR output,
#endif
                                     float epsilon, uint64_t rows, uint64_t padded_rows) {
#if defined(MHC_STATS_POST) || defined(MHC_STATS_SCALAR)
    constexpr uint32_t r = 1;
#else
    constexpr uint32_t r = kStatsRowCapacity;
#endif
    constexpr const StatsParams &p = kStatsPlan;
    InitSocState();
    SetSaturationFlag<SaturationMode::FLOAT>(false); // IEEE Inf/NaN, as in the FP32 reference.
    VectorEvents ev;
    StatisticsConstants constants;
#if defined(MHC_STATS_POST)
    bool updated_pending[kSlots] = {false, false};
    constexpr TEventID kUpdatedReuse[kSlots] = {1, 3};
    const uint64_t jobs = rows * p.post_column_tiles;
#else
    const uint64_t jobs = (rows + r - 1) / r;
#endif
    for (uint64_t job = GetBlockIdx(); job < jobs; job += kWorkers) {
#if defined(MHC_STATS_POST)
        const uint64_t first = job / p.post_column_tiles;
        const uint32_t start = job % p.post_column_tiles * p.post_tile_columns;
        compute_statistics(projection, squares, scale, base, pre, post, comb, p, first, r,
                           start == 0, ev, constants, epsilon, rows, padded_rows);
        // compute_statistics has retired all local DMAs; state starts at its aligned
        // arena end and cannot alias any coefficient buffer still being read.
        constexpr StatsLayout statistics;
        const uint32_t arena = round_up(statistics.bytes, kVectorRepeatBytes),
                       t = p.post_tile_columns, b = p.branches;
        const PostLayout l(b, p.hidden_width, t);
        auto matrix = ub<float>(statistics.matrix);
        auto gates = ub<float>(statistics.gate);
        auto raw = ub<bfloat16_t>(arena + l.raw), rawx = ub<bfloat16_t>(arena + l.rawx),
             packed = ub<bfloat16_t>(arena + l.packed);
        auto streams = ub<float>(arena + l.streams), value = ub<float>(arena + l.value),
             total = ub<float>(arena + l.total), work = ub<float>(arena + l.work);
        auto x = gm<bfloat16_t>(input), res = gm<bfloat16_t>(residual),
             out = gm<bfloat16_t>(output);
        const uint32_t n = p.hidden_width - start < t ? p.hidden_width - start : t;
        {
            set_flag(PIPE_V, PIPE_MTE2, ::event_t(VectorEvents::raw_free));
            wait_flag(PIPE_V, PIPE_MTE2, ::event_t(VectorEvents::raw_free));
        }
        load_rows(raw, (res + (first * b * p.hidden_width + start)), b, n, p.hidden_width, t);
        asc_copy_gm2ub_align(rawx, (x + (first * p.hidden_width + start)), 1, n * sizeof(*(rawx)),
                             0, 0, 0, 0);
        {
            set_flag(PIPE_MTE2, PIPE_V, ::event_t(VectorEvents::loaded));
            wait_flag(PIPE_MTE2, PIPE_V, ::event_t(VectorEvents::loaded));
        }
        {
            asc_bfloat162float(streams, raw, b * t);
            asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
        };
        {
            asc_bfloat162float(value, rawx, n);
            asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
        };
        pipe_barrier(PIPE_V);
        const uint32_t tile_elements = n;
        const uint64_t tile_mask =
            tile_elements >= kRepeatFloats ? UINT64_MAX : (uint64_t(1) << tile_elements) - 1;
        const uint8_t tile_repeats = (n) / kRepeatFloats;
        asc_set_vector_mask(0, tile_mask);
        for (uint32_t dest = 0; dest < b; ++dest) {
            asc_mul_scalar(total, streams, matrix[dest], tile_repeats, 1, 1, kRepeatBlocks,
                           kRepeatBlocks);
            pipe_barrier(PIPE_V);
            for (uint32_t source = 1; source < b; ++source) {
                asc_axpy(total, (streams + (source * t)), matrix[source * kBlockFloats + dest],
                         tile_repeats, 1, 1, kRepeatBlocks, kRepeatBlocks);
                pipe_barrier(PIPE_V);
            }
            asc_axpy(total, value, gates[kBlockFloats + dest], tile_repeats, 1, 1, kRepeatBlocks,
                     kRepeatBlocks);
            pipe_barrier(PIPE_V);
            // Axpy leaves work unused throughout post. Its first BF16 half
            // is the second packed bank, so DMA can overlap the next dest.
            const uint32_t slot = dest % kSlots;
            auto target = slot ? reinterpret_cast<__ubuf__ bfloat16_t *>(work) : packed;
            if (updated_pending[slot]) {
                wait_flag(PIPE_MTE3, PIPE_V, ::event_t(kUpdatedReuse[slot]));
                updated_pending[slot] = false;
            }
            {
                asc_float2bfloat16_rn(target, total, n);
                asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
            };
            pipe_barrier(PIPE_V);
            {
                set_flag(PIPE_V, PIPE_MTE3, ::event_t(VectorEvents::store_ready));
                wait_flag(PIPE_V, PIPE_MTE3, ::event_t(VectorEvents::store_ready));
            }
            asc_copy_ub2gm_align((out + ((first * b + dest) * p.hidden_width + start)), target, 1,
                                 n * sizeof(*(target)), 0, 0, 0, 0);
            set_flag(PIPE_MTE3, PIPE_V, ::event_t(kUpdatedReuse[slot]));
            updated_pending[slot] = true;
        }
#else
        compute_statistics(projection, squares, scale, base, pre, post, comb, p, job * r, r, true,
                           ev, constants, epsilon, rows, padded_rows);
#endif
    }
#if defined(MHC_STATS_POST)
    for (uint32_t slot = 0; slot < kSlots; ++slot)
        if (updated_pending[slot])
            wait_flag(PIPE_MTE3, PIPE_V, ::event_t(kUpdatedReuse[slot]));
#endif
    {
        set_flag(PIPE_MTE2, PIPE_S, ::event_t(VectorEvents::load_drained));
        wait_flag(PIPE_MTE2, PIPE_S, ::event_t(VectorEvents::load_drained));
        set_flag(PIPE_MTE3, PIPE_S, ::event_t(VectorEvents::store_drained));
        wait_flag(PIPE_MTE3, PIPE_S, ::event_t(VectorEvents::store_drained));
        set_flag(PIPE_V, PIPE_S, ::event_t(VectorEvents::scalar_read));
        wait_flag(PIPE_V, PIPE_S, ::event_t(VectorEvents::scalar_read));
    }
}
