// Fused BF16 boundary conversions. Routed intermediates remain FP16 in GM;
// weighting and top-k reduction use FP32 only inside the vector core's UB.
#include <kernel_operator.h>
#include <common/arch2201.h>
#include <c_api/asc_simd.h>
#include <common/grouped_metadata.h>
#include <moe_routes/conversion.h>
using namespace AscendC;
namespace route_metadata = grouped_metadata;
namespace {
// Storage capacity supports both latency and bandwidth tilings without extra
// JIT variants. Eight/six-byte conversion buffers fit the SDK UB budget.
constexpr uint32_t kConversionCapacityElements = moe_routes::kBandwidthCapacity;
// Both conversions share the same load/FP32 span; combine additionally owns
// an FP32 accumulator. Two bounded allocation capacities preserve the measured
// latency/bandwidth UB placement. Copy/arithmetic extents remain runtime.
struct ConversionLayout {
    uint32_t elements, raw, fp, accumulator, gather_output, inverse, combine_output;
    __aicore__ explicit constexpr ConversionLayout(uint32_t active_elements) {
        constexpr uint32_t kAlignmentElements = ONE_BLK_SIZE / sizeof(half);
        elements =
            (active_elements + kAlignmentElements - 1) / kAlignmentElements * kAlignmentElements;
        raw = 0;
        fp = elements * sizeof(half);
        accumulator = fp + elements * sizeof(float);
        gather_output = accumulator;
        inverse = gather_output + elements * sizeof(half);
        combine_output = accumulator + elements * sizeof(float);
    }
};
static_assert(kConversionCapacityElements * (2 * sizeof(float) + 2 * sizeof(half)) <
              arch2201::kUbBytes);

// Cast enters NORMAL mask mode before this stage. Reuse one mask for scale
// and accumulation, retaining the original per-slot FP32 order. An arbitrary
// hidden-width tail is handled separately from complete vector repeats.
__aicore__ void accumulate_route(__ubuf__ float *sum, __ubuf__ float *values, uint32_t count,
                                 float weight) {
    constexpr uint32_t kRepeatElements = 256 / sizeof(float), kRepeatBlocks = 8;
    const uint32_t full = count / kRepeatElements * kRepeatElements;
    if (full) {
        asc_set_vector_mask(0, ~uint64_t(0));
        asc_mul_scalar(values, values, weight, uint8_t(full / kRepeatElements), 1, 1, kRepeatBlocks,
                       kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_add(sum, sum, values, uint8_t(full / kRepeatElements), 1, 1, 1, kRepeatBlocks,
                kRepeatBlocks, kRepeatBlocks);
        pipe_barrier(PIPE_V);
    }
    if (full < count) {
        asc_set_vector_mask(0, (uint64_t(1) << (count - full)) - 1);
        asc_mul_scalar(values + full, values + full, weight, uint8_t(1), 1, 1, kRepeatBlocks,
                       kRepeatBlocks);
        pipe_barrier(PIPE_V);
        asc_add(sum + full, sum + full, values + full, uint8_t(1), 1, 1, 1, kRepeatBlocks,
                kRepeatBlocks, kRepeatBlocks);
        pipe_barrier(PIPE_V);
    }
}

} // namespace

#if defined(MOE_ROUTES_GATHER)
__global__ __aicore__ void route_gather(GM_ADDR input, GM_ADDR order_addr, GM_ADDR meta_addr,
                                        GM_ADDR output, GM_ADDR inverse_addr, int64_t rows) {
    constexpr int64_t hidden = MOE_ROUTES_HIDDEN, topk = MOE_ROUTES_TOPK;
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    InitSocState();
    SetSaturationFlag<SaturationMode::FLOAT>(false); // BF16/FP16 conversion follows IEEE Inf/NaN.
    constexpr auto tiling =
        moe_routes::conversion_for_width<MOE_ROUTES_CAPACITY>(hidden, MOE_ROUTES_WORKERS);
    constexpr uint32_t tile_elements = MOE_ROUTES_CAPACITY;
    constexpr ConversionLayout layout(MOE_ROUTES_CAPACITY);
    auto raw = reinterpret_cast<__ubuf__ bfloat16_t *>(uint64_t(layout.raw));
    auto fp = reinterpret_cast<__ubuf__ float *>(uint64_t(layout.fp));
    auto out = reinterpret_cast<__ubuf__ half *>(uint64_t(layout.gather_output));
    auto index = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(layout.inverse));
    __gm__ bfloat16_t *x;
    __gm__ half *y;
    __gm__ int32_t *order, *meta, *inverse;
    x = (__gm__ bfloat16_t *)input;
    y = (__gm__ half *)output;
    order = (__gm__ int32_t *)order_addr;
    meta = (__gm__ int32_t *)meta_addr;
    inverse = (__gm__ int32_t *)inverse_addr;
    const int64_t total = meta[route_metadata::kTotalRows];
    constexpr int32_t load = 0;        // one live token on this pipe pair
    constexpr int32_t store = 0;       // one live token on this pipe pair
    constexpr int32_t reuse = 0;       // one live token on this pipe pair
    constexpr int32_t index_ready = 0; // one live token on this pipe pair
    constexpr int32_t index_reuse = 0; // one live token on this pipe pair
    for (moe_routes::ConversionCursor cursor(tiling, GetBlockIdx(), MOE_ROUTES_WORKERS);
         cursor.row < uint64_t(total); cursor.advance()) {
        const int64_t row = cursor.row, col = cursor.column * tile_elements;
        int64_t slot = order[row], token = slot / topk;
        uint32_t n = hidden - col < tile_elements ? hidden - col : tile_elements;
        // Scalar GM stores dirty a whole cache line: different AIVs must not
        // use them for adjacent inverse slots. DMA writes only these 4 bytes.
        if (col == 0) {
            index[0] = row;
            set_flag(PIPE_S, PIPE_MTE3, ::event_t(index_ready));
            wait_flag(PIPE_S, PIPE_MTE3, ::event_t(index_ready));
            asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((inverse + (slot))),
                                 reinterpret_cast<__ubuf__ uint8_t *>(index), 1, sizeof(int32_t), 0,
                                 0, 0, 0);
            set_flag(PIPE_MTE3, PIPE_S, ::event_t(index_reuse));
            wait_flag(PIPE_MTE3, PIPE_S, ::event_t(index_reuse));
        }
        asc_copy_gm2ub_align(reinterpret_cast<__ubuf__ uint8_t *>(raw),
                             reinterpret_cast<__gm__ uint8_t *>((x + (token * hidden + col))), 1,
                             n * uint32_t(sizeof(half)), 0, 0, 0, 0);
        set_flag(PIPE_MTE2, PIPE_V, ::event_t(load));
        wait_flag(PIPE_MTE2, PIPE_V, ::event_t(load));
        asc_bfloat162float(fp, raw, n);
        pipe_barrier(PIPE_V);
        asc_float2half_rn(out, fp, n);
        set_flag(PIPE_V, PIPE_MTE3, ::event_t(store));
        wait_flag(PIPE_V, PIPE_MTE3, ::event_t(store));
        asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((y + (row * hidden + col))),
                             reinterpret_cast<__ubuf__ uint8_t *>(out), 1,
                             n * uint32_t(sizeof(half)), 0, 0, 0, 0);
        set_flag(PIPE_MTE3, PIPE_MTE2, ::event_t(reuse));
        wait_flag(PIPE_MTE3, PIPE_MTE2, ::event_t(reuse));
    }
    // The final reuse wait belongs to MTE2, after the output DMA. Retiring
    // that consumer also proves the preceding MTE2->V->MTE3 chain complete.
    constexpr int32_t kGatherRetired = 0;
    set_flag(PIPE_MTE2, PIPE_S, ::event_t(kGatherRetired));
    wait_flag(PIPE_MTE2, PIPE_S, ::event_t(kGatherRetired));
}

#elif defined(MOE_ROUTES_COMBINE)
__global__ __aicore__ void route_combine(GM_ADDR input, GM_ADDR inverse_addr, GM_ADDR ids_addr,
                                         GM_ADDR weights_addr, GM_ADDR output, int64_t rows) {
    constexpr int64_t hidden = MOE_ROUTES_HIDDEN, topk = MOE_ROUTES_TOPK;
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    InitSocState();
    SetSaturationFlag<SaturationMode::FLOAT>(
        false); // FP32 accumulation and BF16 export preserve Inf/NaN.
    constexpr auto tiling =
        moe_routes::conversion_for_width<MOE_ROUTES_CAPACITY>(hidden, MOE_ROUTES_WORKERS);
    constexpr uint32_t tile_elements = MOE_ROUTES_CAPACITY;
    constexpr ConversionLayout layout(MOE_ROUTES_CAPACITY);
    auto raw = reinterpret_cast<__ubuf__ half *>(uint64_t(layout.raw));
    auto fp = reinterpret_cast<__ubuf__ float *>(uint64_t(layout.fp));
    auto sum = reinterpret_cast<__ubuf__ float *>(uint64_t(layout.accumulator));
    auto out = reinterpret_cast<__ubuf__ bfloat16_t *>(uint64_t(layout.combine_output));
    __gm__ half *x;
    __gm__ bfloat16_t *y;
    __gm__ int32_t *inverse;
    __gm__ int32_t *ids;
    __gm__ float *weights;
    x = (__gm__ half *)input;
    y = (__gm__ bfloat16_t *)output;
    inverse = (__gm__ int32_t *)inverse_addr;
    ids = (__gm__ int32_t *)ids_addr;
    weights = (__gm__ float *)weights_addr;
    constexpr int32_t load = 0;   // one live token on this pipe pair
    constexpr int32_t reuse = 0;  // one live token on this pipe pair
    constexpr int32_t store = 0;  // one live token on this pipe pair
    constexpr int32_t retire = 0; // one live token on this pipe pair
    bool input_credit_pending = false;
    for (moe_routes::ConversionCursor cursor(tiling, GetBlockIdx(), MOE_ROUTES_WORKERS);
         cursor.row < uint64_t(rows);) {
        const int64_t row = cursor.row, col = cursor.column * tile_elements;
        // Decide whether this actor has a future tile before publishing
        // input reuse credits. Advance once, retaining the current addresses.
        cursor.advance();
        const bool has_next_tile = cursor.row < uint64_t(rows);
        uint32_t n = hidden - col < tile_elements ? hidden - col : tile_elements;
        asc_duplicate(sum, 0.f, n);
        pipe_barrier(PIPE_V);
        for (int64_t k = 0; k < topk; ++k) {
            int64_t slot = row * topk + k;
            if (ids[slot] < 0)
                continue;
            int64_t source = inverse[slot];
            asc_copy_gm2ub_align(reinterpret_cast<__ubuf__ uint8_t *>(raw),
                                 reinterpret_cast<__gm__ uint8_t *>((x + (source * hidden + col))),
                                 1, n * uint32_t(sizeof(half)), 0, 0, 0, 0);
            set_flag(PIPE_MTE2, PIPE_V, ::event_t(load));
            wait_flag(PIPE_MTE2, PIPE_V, ::event_t(load));
            asc_half2float(fp, raw, n);
            pipe_barrier(PIPE_V);
            accumulate_route(sum, fp, n, weights[slot]);
            // Only a following top-k slot can overwrite raw input. Preserve
            // the early reuse handoff for that overlap; the final slot
            // already has a Vector consumer and needs no input credit.
            input_credit_pending = k + 1 < topk || has_next_tile;
            if (input_credit_pending) {
                set_flag(PIPE_V, PIPE_MTE2, ::event_t(reuse));
                wait_flag(PIPE_V, PIPE_MTE2, ::event_t(reuse));
            }
        }
        asc_float2bfloat16_rn(out, sum, n);
        set_flag(PIPE_V, PIPE_MTE3, ::event_t(store));
        wait_flag(PIPE_V, PIPE_MTE3, ::event_t(store));
        asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((y + (row * hidden + col))),
                             reinterpret_cast<__ubuf__ uint8_t *>(out), 1,
                             n * uint32_t(sizeof(half)), 0, 0, 0, 0);
        set_flag(PIPE_MTE3, PIPE_V, ::event_t(retire));
        wait_flag(PIPE_MTE3, PIPE_V, ::event_t(retire));
    }
    // Input credits end on MTE2; output credits end on V. Neither producer
    // completion alone retires the appended consumer-side waits.
    constexpr int32_t kCombineRetired = 0;
    // An invalid final slot can leave an earlier input credit without a
    // later load. Retire its MTE2 consumer; otherwise the last actual load
    // was consumed by Vector and is covered by the output chain below.
    if (input_credit_pending) {
        set_flag(PIPE_MTE2, PIPE_S, ::event_t(kCombineRetired));
        wait_flag(PIPE_MTE2, PIPE_S, ::event_t(kCombineRetired));
    }
    set_flag(PIPE_V, PIPE_S, ::event_t(kCombineRetired));
    wait_flag(PIPE_V, PIPE_S, ::event_t(kCombineRetired));
}

#endif
