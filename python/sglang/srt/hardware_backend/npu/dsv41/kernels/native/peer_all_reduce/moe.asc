#include <peer_all_reduce/moe_pipeline.h>

#if defined(PEER_GATHER)
#define PEER_ENTRY peer_moe_gather
#elif PEER_FINALIZE
#define PEER_ENTRY peer_moe_finalize_return
#else
#define PEER_ENTRY peer_moe_return
#endif
extern "C" __global__ __aicore__ void PEER_ENTRY(GM_ADDR input, GM_ADDR inverse, GM_ADDR ids,
                                                 GM_ADDR weights, GM_ADDR shared, GM_ADDR output,
                                                 GM_ADDR local, GM_ADDR table, uint32_t rank,
                                                 uint32_t rows, uint32_t topk) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    AscendC::InitSocState();
    AscendC::SetSaturationFlag<AscendC::SaturationMode::FLOAT>(false);
    peer_moe::View view(local, table, rank, rows);
#if defined(PEER_GATHER)
    peer_moe::gather(view, input, output);
#else
    peer_moe::publish_partial<PEER_FINALIZE>(view, input, inverse, ids, weights, topk);
    peer_moe::reduce_owned(view, shared);
    peer_moe::restore(view, output);
#endif
    view.finish();
}
