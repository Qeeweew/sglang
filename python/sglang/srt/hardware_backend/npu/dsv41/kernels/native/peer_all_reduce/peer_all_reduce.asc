// Two-rank BF16 SUM, one-shot pull. A channel has exactly one writer on
// each rank. Ready publishes completed MTE3 stores; ack retires peer MTE2
// readers before the producer may reuse its staging partition. The epoch is
// device state, so repeated Graph replay needs no host-side patching.
#include <common/device.h>
#include <kernel_operator.h>
#include <c_api/asc_simd.h>
#include <peer_all_reduce/protocol.h>

using namespace AscendC;
namespace p = peer_all_reduce;
using namespace peer_protocol;

extern "C" __global__ __aicore__ void peer_all_reduce_sum(GM_ADDR input, GM_ADDR output,
                                                          GM_ADDR local, GM_ADDR peer,
                                                          GM_ADDR table, uint32_t elements) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    InitSocState();
    SetSaturationFlag<SaturationMode::FLOAT>(false);
    const uint32_t channel = GetBlockIdx();
    const uint64_t epoch = peer_protocol::begin(local, table, 2);
    // Address ownership is independent of message length. A channel may reuse
    // its bytes as soon as its peer reader acknowledges them, even when other
    // channels are still retiring the previous, differently sized message.
    const uint32_t begin = channel * p::kTileElements;
    constexpr uint32_t stride = p::kWorkers * p::kTileElements;
    auto x = reinterpret_cast<__gm__ bfloat16_t *>(input);
    auto y = reinterpret_cast<__gm__ bfloat16_t *>(output);
    auto stage = reinterpret_cast<__gm__ bfloat16_t *>(local + p::kControlBytes);
    auto remote = reinterpret_cast<__gm__ bfloat16_t *>(peer + p::kControlBytes);
    auto a = reinterpret_cast<__ubuf__ bfloat16_t *>(uint64_t(0));
    auto b = reinterpret_cast<__ubuf__ bfloat16_t *>(uint64_t(8192));
    auto af = reinterpret_cast<__ubuf__ float *>(uint64_t(16384));
    auto bf = reinterpret_cast<__ubuf__ float *>(uint64_t(32768));

    for (uint32_t offset = begin; offset < elements; offset += stride) {
        const uint32_t n =
            elements - offset < p::kTileElements ? elements - offset : p::kTileElements;
        asc_copy_gm2ub(a, x + offset, n * 2);
        native_device::pipe_fence<PIPE_MTE2, PIPE_MTE3, EVENT_ID0>();
        asc_copy_ub2gm(stage + offset, a, n * 2);
        native_device::pipe_fence<PIPE_MTE3, PIPE_MTE2, EVENT_ID0>();
    }
    native_device::pipe_fence<PIPE_MTE2, PIPE_S, EVENT_ID0>();
    publish(signal(local, 1, channel), epoch);
    await(signal(peer, 1, channel), epoch);
    // Scalar polling must complete before issuing the peer DMA.
    native_device::pipe_fence<PIPE_S, PIPE_MTE2, EVENT_ID0>();
    for (uint32_t offset = begin; offset < elements; offset += stride) {
        const uint32_t n =
            elements - offset < p::kTileElements ? elements - offset : p::kTileElements;
        asc_copy_gm2ub(a, x + offset, n * 2);
        asc_copy_gm2ub(b, remote + offset, n * 2);
        native_device::pipe_fence<PIPE_MTE2, PIPE_V, EVENT_ID0>();
        asc_bfloat162float(af, a, n);
        asc_bfloat162float(bf, b, n);
        pipe_barrier(PIPE_V);
        asc_add(af, af, bf, n);
        pipe_barrier(PIPE_V);
        asc_float2bfloat16_rn(a, af, n);
        native_device::pipe_fence<PIPE_V, PIPE_MTE3, EVENT_ID0>();
        asc_copy_ub2gm(y + offset, a, n * 2);
        native_device::pipe_fence<PIPE_MTE3, PIPE_MTE2, EVENT_ID0>();
    }
    native_device::pipe_fence<PIPE_MTE2, PIPE_S, EVENT_ID0>();
    peer_protocol::finish(local, epoch);
}
