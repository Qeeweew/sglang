#include <kernel_operator.h>
#include <attention/cube_pipeline.h>
#include <attention/vector_pipeline.h>
#if ATTENTION_MODE == 1
using EntrySources = attention::Sources;
#else
using EntrySources = attention::DirectSources;
#endif
__global__ __aicore__ void attention_kernel(EntrySources packet) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    AscendC::InitSocState();
    AscendC::SetSaturationFlag<AscendC::SaturationMode::FLOAT>(false);
#if ATTENTION_MODE == 1
    const auto &sources = packet;
#else
    const attention::Sources sources{
        packet.q,   packet.kv,       0, 0, packet.table,  0,
        packet.cu,  packet.lengths,  0, 0, packet.window, packet.sinks,
        packet.out, packet.workspace, packet.tokens, packet.batch};
#endif
    if ASCEND_IS_AIC {
        attention::CubePipeline pipeline(sources, AscendC::GetBlockIdx());
        pipeline.run();
    }
    if ASCEND_IS_AIV {
        attention::VectorPipeline pipeline(sources, attention::cube_actor_index(),
                                                  AscendC::GetSubBlockIdx());
        pipeline.run();
    }
}
