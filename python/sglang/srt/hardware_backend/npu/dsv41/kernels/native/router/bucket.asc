#include <common/device.h>
#include <kernel_operator.h>
#include <c_api/asc_simd.h>
#include <common/arch2201.h>
#include <common/grouped_metadata.h>
#include <router/bucket_layout.h>
using namespace AscendC;
namespace {
constexpr uint32_t E = ROUTER_BUCKET_EXPERTS, C = router_bucket::kChunk;
constexpr uint32_t P = (E + 63) / 64 * 64, B = P * sizeof(int32_t);
constexpr uint32_t H = router_bucket::histogram_stride(E), kOffsets = 13 * B;
constexpr uint32_t kMetadata = kOffsets + router_bucket::aligned((E + 1) * sizeof(int32_t));
static_assert(router_bucket::table_bytes(E) <= arch2201::kUbBytes);
// One integer exclusive scan for the global table; no input-size variants.
// A/B each have a zero P-element head and a P-element prefix tail. The caller
// publishes Scalar histogram writes with S->V and consumes results with V->S.
__aicore__ void prefix(__ubuf__ int32_t *counts, __ubuf__ int32_t *out,
                       __ubuf__ int32_t *indices) {
    auto a = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(6 * B));
    auto b = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(8 * B));
    auto bytes = reinterpret_cast<__ubuf__ uint32_t *>(uint64_t(11 * B));
    auto addresses = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(12 * B));
    asc_duplicate(a, int32_t(0), P);
    asc_duplicate(b, int32_t(0), P);
    asc_add_scalar(a + P, counts, int32_t(0), E);
    asc_shiftleft(bytes, reinterpret_cast<__ubuf__ uint32_t *>(indices), uint32_t(2), E);
    pipe_barrier(PIPE_V);
    for (uint32_t step = 1; step < E; step *= 2) {
        asc_add_scalar(addresses, reinterpret_cast<__ubuf__ int32_t *>(bytes), int32_t((P - step) * 4), E);
        pipe_barrier(PIPE_V);
        asc_gather(b + P, a, reinterpret_cast<__ubuf__ uint32_t *>(addresses), E);
        pipe_barrier(PIPE_V);
        asc_add(b + P, a + P, b + P, E);
        pipe_barrier(PIPE_V);
        auto old = a; a = b; b = old;
    }
    asc_add_scalar(addresses, reinterpret_cast<__ubuf__ int32_t *>(bytes), int32_t((P - 1) * 4), E);
    pipe_barrier(PIPE_V);
    asc_gather(out, a, reinterpret_cast<__ubuf__ uint32_t *>(addresses), E);
    pipe_barrier(PIPE_V);
}
// Stable active-expert compression; count mask excludes initialized tail lanes.
__aicore__ uint32_t active_experts(__ubuf__ int32_t *counts, __ubuf__ int32_t *indices,
                                   __ubuf__ int32_t *out) {
    if ASCEND_IS_AIV {
    auto mask = reinterpret_cast<__ubuf__ uint32_t *>(uint64_t(12 * B));
    asc_eq_scalar((__ubuf__ uint8_t *)mask, counts, int32_t(0), uint8_t((E + 63) / 64), 1, 1, 8, 8);
    pipe_barrier(PIPE_V);
    asc_not((__ubuf__ uint16_t *)mask, (__ubuf__ uint16_t *)mask, (E + 15) / 16);
    pipe_barrier(PIPE_V);
    asc_set_mask_count();
    asc_set_vector_mask(0, E);
    vreducev2((__ubuf__ uint32_t *)out, (__ubuf__ uint32_t *)indices, mask, 1, 1, 0, 8, 1);
    native_device::pipe_fence<PIPE_V, PIPE_S, EVENT_ID0>();
    const uint32_t count = get_rsvd_cnt();
    asc_set_mask_norm();
    asc_set_vector_mask(~uint64_t(0), ~uint64_t(0));
    return count;
    }
    return 0;
}
} // namespace

__global__ __aicore__ void route_bucket(GM_ADDR ids_gm, GM_ADDR local_gm, GM_ADDR counts_gm,
                                       GM_ADDR offsets_gm, GM_ADDR order_gm, GM_ADDR metadata_gm,
                                       GM_ADDR histogram_gm, int64_t slots, int32_t first,
                                       uint32_t workers) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    InitSocState();
    auto ids = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(0));
    auto local = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(4 * C));
    const uint32_t worker = GetBlockIdx();
    constexpr uint32_t kDmaSlots = ONE_BLK_SIZE / sizeof(int32_t);
    const int64_t shard = (slots + workers * kDmaSlots - 1) / (workers * kDmaSlots) * kDmaSlots;
    const int64_t begin = worker * shard, end = min(slots, begin + shard);
    // 1. Per-worker histogram and local IDs; only conflict-bearing integer
    // histogram/index work is Scalar, always inside private UB.
    asc_duplicate(local, int32_t(0), P);
    native_device::pipe_fence<PIPE_V, PIPE_S, EVENT_ID0>();
    for (int64_t pos = begin; pos < end; pos += C) {
        const uint32_t n = min(int64_t(C), end - pos);
        asc_copy_gm2ub_align((__ubuf__ uint8_t *)ids, (__gm__ uint8_t *)((__gm__ int32_t *)ids_gm + pos),
                             1, n * 4, 0, 0, 0, 0);
        native_device::pipe_fence<PIPE_MTE2, PIPE_S, EVENT_ID0>();
        for (uint32_t i = 0; i < n; ++i) {
            const int32_t e = ids[i] - first;
            ids[i] = uint32_t(e) < E ? e : -1;
            if (ids[i] >= 0) ++local[e];
        }
        native_device::pipe_fence<PIPE_S, PIPE_MTE3, EVENT_ID0>();
        asc_copy_ub2gm_align((__gm__ uint8_t *)((__gm__ int32_t *)local_gm + pos), (__ubuf__ uint8_t *)ids,
                             1, n * 4, 0, 0, 0, 0);
        native_device::pipe_fence<PIPE_MTE3, PIPE_MTE2, EVENT_ID0>();
    }
    native_device::pipe_fence<PIPE_S, PIPE_MTE3, EVENT_ID0>();
    asc_copy_ub2gm((__gm__ int32_t *)histogram_gm + worker * H, local, H * 4);
    asc_sync_inter_arrive(PIPE_MTE3, 0);
    asc_sync_inter_wait(PIPE_S, 0);

    // 2. Vector counts/prefix/active compression. Each worker owns one
    // contiguous expert interval, so its final order is one contiguous stream.
    auto counts = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(4 * B));
    auto starts = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(5 * B));
    auto indices = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(10 * B));
    auto active_ids = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(6 * B));
    auto offsets = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(kOffsets));
    auto metadata = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(kMetadata));
    auto owned = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(router_bucket::owned_offset(E)));
    asc_duplicate(counts, int32_t(0), P);
    pipe_barrier(PIPE_V);
    for (uint32_t base = 0; base < workers; base += router_bucket::kHistogramRows) {
        const uint32_t n = min(router_bucket::kHistogramRows, workers - base);
        asc_copy_gm2ub(ids, (__gm__ int32_t *)histogram_gm + base * H, n * H * 4);
        native_device::pipe_fence<PIPE_MTE2, PIPE_V, EVENT_ID0>();
        for (uint32_t row = 0; row < n; ++row) {
            asc_add(counts, counts, ids + row * H, E);
            pipe_barrier(PIPE_V);
        }
        native_device::pipe_fence<PIPE_V, PIPE_MTE2, EVENT_ID0>();
    }
    native_device::pipe_fence<PIPE_V, PIPE_S, EVENT_ID0>();
    constexpr uint32_t seed = ONE_BLK_SIZE / sizeof(int32_t);
    for (uint32_t i = 0; i < seed; ++i) indices[i] = i;
    native_device::pipe_fence<PIPE_S, PIPE_V, EVENT_ID0>();
    for (uint32_t n = seed; n < P; n *= 2) {
        asc_add_scalar(indices + n, indices, int32_t(n), min(n, P - n));
        pipe_barrier(PIPE_V);
    }
    prefix(counts, starts, indices);
    asc_add_scalar(offsets, starts, int32_t(0), E);
    const uint32_t active = active_experts(counts, indices, active_ids);
    const uint32_t first_expert = E * worker / workers, last_expert = E * (worker + 1) / workers;
    uint32_t owned_count = 0;
    int32_t destination = starts[first_expert];
    for (uint32_t i = 0; i < active; ++i) {
        const uint32_t e = active_ids[i];
        if (e >= first_expert && e < last_expert)
            owned[owned_count++] = e;
        if (worker == 0) {
            const uint32_t at = (i + 1) * grouped_metadata::kWords;
            metadata[at] = e; metadata[at + 1] = starts[e];
            metadata[at + 2] = counts[e]; metadata[at + 3] = 0;
        }
    }
    if (worker == 0) {
        const int32_t total = starts[E - 1] + counts[E - 1];
        offsets[E] = total;
        metadata[0] = active; metadata[1] = total; metadata[2] = 0; metadata[3] = grouped_metadata::kVersion;
        native_device::pipe_fence<PIPE_S, PIPE_MTE3, EVENT_ID0>();
        asc_copy_ub2gm_align((__gm__ uint8_t *)counts_gm, (__ubuf__ uint8_t *)counts, 1, E * 4, 0, 0, 0, 0);
        asc_copy_ub2gm_align((__gm__ uint8_t *)offsets_gm, (__ubuf__ uint8_t *)offsets, 1, (E + 1) * 4, 0, 0, 0, 0);
        asc_copy_ub2gm_align((__gm__ uint8_t *)metadata_gm, (__ubuf__ uint8_t *)metadata,
                             1, (active + 1) * sizeof(grouped_metadata::Entry), 0, 0, 0, 0);
        native_device::pipe_fence<PIPE_MTE3, PIPE_S, EVENT_ID0>();
    }

    // 3. Vector stable compaction; concatenate the owned expert interval in
    // one bounded output stream. Integer UB packing coalesces tiny expert runs
    // and full tiles alike, avoiding unaligned UB DMA or one DMA per expert.
    indices = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(4 * C));
    auto selected = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(8 * C));
    auto output = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(12 * C));
    auto mask = reinterpret_cast<__ubuf__ uint32_t *>(uint64_t(16 * C));
    for (uint32_t i = 0; i < seed; ++i) indices[i] = i;
    native_device::pipe_fence<PIPE_S, PIPE_V, EVENT_ID0>();
    for (uint32_t n = seed; n < C; n *= 2) {
        asc_add_scalar(indices + n, indices, int32_t(n), n);
        pipe_barrier(PIPE_V);
    }
    uint32_t buffered = 0;
    for (uint32_t expert = 0; expert < owned_count; ++expert) {
        for (int64_t pos = 0; pos < slots; pos += C) {
            const uint32_t n = min(int64_t(C), slots - pos);
            if (n % 64) {
                asc_duplicate(ids + n / 64 * 64, int32_t(-1), 64);
                pipe_barrier(PIPE_V);
            }
            native_device::pipe_fence<PIPE_V, PIPE_MTE2, EVENT_ID0>();
            asc_copy_gm2ub_align((__ubuf__ uint8_t *)ids, (__gm__ uint8_t *)((__gm__ int32_t *)local_gm + pos),
                                 1, n * 4, 0, 0, 0, 0);
            native_device::pipe_fence<PIPE_MTE2, PIPE_V, EVENT_ID0>();
            asc_eq_scalar((__ubuf__ uint8_t *)mask, ids, owned[expert],
                           uint8_t((n + 63) / 64), 1, 1, 8, 8);
            pipe_barrier(PIPE_V);
            uint32_t count = 0;
            if ASCEND_IS_AIV {
                asc_set_mask_count();
                asc_set_vector_mask(0, n);
                vreducev2((__ubuf__ uint32_t *)selected, (__ubuf__ uint32_t *)indices, mask, 1, 1, 0, 8, 1);
                native_device::pipe_fence<PIPE_V, PIPE_S, EVENT_ID0>();
                count = get_rsvd_cnt();
                asc_set_mask_norm();
                asc_set_vector_mask(~uint64_t(0), ~uint64_t(0));
            }
            for (uint32_t at = 0; at < count;) {
                const uint32_t take = min(C - buffered, count - at);
                // Only the leading partial DMA block needs Scalar integer
                // copies. Gather handles an arbitrary selected source offset
                // while keeping the destination Vector-aligned.
                const uint32_t head = min(take, (kDmaSlots - buffered % kDmaSlots) % kDmaSlots);
                for (uint32_t i = 0; i < head; ++i)
                    output[buffered + i] = pos + selected[at + i];
                if (take > head) {
                    const uint32_t ncopy = take - head;
                    asc_shiftleft((__ubuf__ uint32_t *)ids, (__ubuf__ uint32_t *)indices,
                                    uint32_t(2), ncopy);
                    pipe_barrier(PIPE_V);
                    asc_add_scalar(ids, ids, int32_t((at + head) * sizeof(int32_t)), ncopy);
                    pipe_barrier(PIPE_V);
                    asc_gather(output + buffered + head, selected, (__ubuf__ uint32_t *)ids, ncopy);
                    pipe_barrier(PIPE_V);
                    asc_add_scalar(output + buffered + head, output + buffered + head, int32_t(pos), ncopy);
                    native_device::pipe_fence<PIPE_V, PIPE_S, EVENT_ID0>();
                }
                buffered += take; at += take;
                if (buffered == C) {
                    native_device::pipe_fence<PIPE_S, PIPE_MTE3, EVENT_ID0>();
                    asc_copy_ub2gm_align((__gm__ uint8_t *)((__gm__ int32_t *)order_gm + destination),
                                         (__ubuf__ uint8_t *)output, 1, C * 4, 0, 0, 0, 0);
                    native_device::pipe_fence<PIPE_MTE3, PIPE_S, EVENT_ID0>();
                    destination += C; buffered = 0;
                }
            }
        }
    }
    if (buffered) {
        native_device::pipe_fence<PIPE_S, PIPE_MTE3, EVENT_ID0>();
        asc_copy_ub2gm_align((__gm__ uint8_t *)((__gm__ int32_t *)order_gm + destination),
                             (__ubuf__ uint8_t *)output, 1, buffered * 4, 0, 0, 0, 0);
        native_device::pipe_fence<PIPE_MTE3, PIPE_S, EVENT_ID0>();
    }
    native_device::pipe_fence<PIPE_V, PIPE_S, EVENT_ID0>();
}
