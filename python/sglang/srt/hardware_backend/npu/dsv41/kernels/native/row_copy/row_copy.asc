// Byte-exact gather and scatter share the same tiled row movement.
#include <common/device.h>
#include <kernel_operator.h>
#include <c_api/asc_simd.h>
#include <common/arch2201.h>

using namespace AscendC;
namespace {
constexpr uint32_t kCopyTileBytes = 4 * arch2201::kKiB;
constexpr uint32_t kCopySlots = 2;
static_assert(kCopySlots * kCopyTileBytes <= arch2201::kUbBytes);
} // namespace

#if ROW_COPY_SCATTER
#define ROW_COPY_KERNEL scatter_rows_kernel
#else
#define ROW_COPY_KERNEL gather_rows_kernel
#endif

__global__ __aicore__ void ROW_COPY_KERNEL(GM_ADDR source, GM_ADDR row_map, GM_ADDR output,
                                         int64_t map_rows, int64_t source_rows, int64_t output_rows) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    constexpr uint32_t workers = ROW_COPY_WORKERS;
    constexpr int64_t row_bytes = ROW_COPY_ROW_BYTES;
    constexpr uint32_t row_group = ROW_COPY_ROW_GROUP;
    constexpr bool scatter = ROW_COPY_SCATTER;
    InitSocState();
    constexpr uint32_t fill_byte = ROW_COPY_FILL;
    __gm__ uint8_t *src, *dst;
    __gm__ int32_t *map;
    src = reinterpret_cast<__gm__ uint8_t *>(source);
    dst = reinterpret_cast<__gm__ uint8_t *>(output);
    map = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)row_map);
    // Two private slots overlap the GM read/write engines. Each final store
    // publishes MTE3 -> S on slot0/1; Scalar consumes it before issuing any
    // new producer for that slot. The first two producers need no credit.
    // Partial GM cache lines require serialized RMW, even within one row.
    constexpr uint32_t slots = row_bytes % ONE_BLK_SIZE == 0 ? kCopySlots : 1;
    bool pending[kCopySlots] = {false, false};
    int64_t generation = 0;
    int64_t tasks = scatter ? 1 : (map_rows + row_group - 1) / row_group;
    int64_t group_start = scatter ? 0 : GetBlockIdx();
    int64_t group_step = scatter ? 1 : workers;
    for (int64_t group = group_start; group < tasks; group += group_step) {
        int64_t start = scatter ? 0 : group * row_group;
        int64_t end =
            scatter ? map_rows : ((start + row_group < map_rows) ? start + row_group : map_rows);
        for (int64_t row = start; row < end; ++row) {
            int64_t mapped = map[row];
            bool valid = mapped >= 0 && mapped < (scatter ? output_rows : source_rows);
            if (scatter && (!valid || (mapped / row_group) % workers != GetBlockIdx()))
                continue;
            int64_t si = scatter ? row : mapped, di = scatter ? mapped : row;
            for (int64_t chunk = 0; chunk < row_bytes; chunk += kCopyTileBytes, ++generation) {
                const uint32_t slot = uint32_t(generation) & (slots - 1);
                if (pending[slot])
                    wait_flag(PIPE_MTE3, PIPE_S, ::event_t(slot));
                auto tmp = reinterpret_cast<__ubuf__ uint8_t *>(uint64_t(slot * kCopyTileBytes));
                uint32_t n =
                    (row_bytes - chunk < kCopyTileBytes) ? row_bytes - chunk : kCopyTileBytes;
                if (valid) {
                    asc_copy_gm2ub_align(
                        reinterpret_cast<__ubuf__ uint8_t *>(tmp),
                        reinterpret_cast<__gm__ uint8_t *>((src + (si * row_bytes + chunk))), 1, n,
                        0, 0, 0, 0);
                    native_device::pipe_fence<PIPE_MTE2, PIPE_MTE3>(slot);
                } else {
                    asc_duplicate(reinterpret_cast<__ubuf__ uint32_t *>(tmp),
                                  fill_byte ? 0xffffffffU : 0U,
                                  (n + sizeof(uint32_t) - 1) / sizeof(uint32_t));
                    pipe_barrier(PIPE_V);
                    native_device::pipe_fence<PIPE_V, PIPE_MTE3>(slot);
                }
                asc_copy_ub2gm_align(
                    reinterpret_cast<__gm__ uint8_t *>((dst + (di * row_bytes + chunk))),
                    reinterpret_cast<__ubuf__ uint8_t *>(tmp), 1, n, 0, 0, 0, 0);
                set_flag(PIPE_MTE3, PIPE_S, ::event_t(slot));
                pending[slot] = true;
            }
            if constexpr (scatter) {
                // A later route can target this same row. Retire all pieces
                // before the next source row, preserving last-wins ordering.
                for (uint32_t slot = 0; slot < slots; ++slot)
                    if (pending[slot]) {
                        wait_flag(PIPE_MTE3, PIPE_S, ::event_t(slot));
                        pending[slot] = false;
                    }
            }
        }
    }
    // Every slot's final store and its ready consumer retire before return.
    for (uint32_t slot = 0; slot < slots; ++slot)
        if (pending[slot])
            wait_flag(PIPE_MTE3, PIPE_S, ::event_t(slot));
}
