// DSpark reads only [max(prefix-window_rows, 0), prefix+block), not the entire context.
// Preserve the full-context table allocation and update only those device-selected
// page entries. No visible-length specialization and no host length read.
#include <kernel_operator.h>
#include <c_api/asc_simd.h>
#include <page_metadata/launch.h>
using namespace AscendC;

namespace {
constexpr int32_t kWorkers = PAGE_METADATA_WORKERS;
constexpr int32_t page_shift_for_rows(int32_t rows) {
    int32_t shift = 0;
    while ((int64_t(1) << shift) < rows)
        ++shift;
    return (int64_t(1) << shift) == rows ? shift : -1;
}
// A request group owns complete contiguous CU/length output cache lines.
constexpr uint32_t kDmaAlignmentBytes = 32;
constexpr uint32_t kRequestsPerGroup = page_metadata::kRequestsPerGroup;
static_assert(kRequestsPerGroup * sizeof(int32_t) == kDmaAlignmentBytes);
// Scalar mapping traversal uses bounded chunks; logical block/page counts stay runtime.
constexpr uint32_t kMappingTileElements = 32;
// Eight prefix boundaries plus their terminal boundary occupy two DMA lines.
constexpr uint32_t kBoundaryCapacityElements = 2 * kRequestsPerGroup;
constexpr uint32_t kPageBytes = sizeof(int32_t);
constexpr uint32_t kSlotBytes = sizeof(int64_t);
// Independent MTE2/MTE3 -> Scalar task drains. All immediate handoffs have
// already consumed event 0 on these pipe pairs before the final retirement.
constexpr TEventID kMemoryConsumerDrain = 0;
__aicore__ inline int64_t page_index(int64_t value, int64_t page_rows, int32_t page_shift) {
    return page_shift >= 0 ? value >> page_shift : value / page_rows;
}
constexpr int32_t kPageShift = page_shift_for_rows(PAGE_METADATA_PAGE_ROWS);
} // namespace

__global__ __aicore__ void draft_page_metadata_kernel(GM_ADDR req_to_token, GM_ADDR full_to_swa,
                                                      GM_ADDR requests, GM_ADDR prefix,
                                                      GM_ADDR full_slots, GM_ADDR cu,
                                                      GM_ADDR lengths, GM_ADDR table, GM_ADDR slots,
                                                      GM_ADDR routed_rows, int32_t batch) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    constexpr int32_t block = PAGE_METADATA_BLOCK;
    constexpr int64_t request_rows = PAGE_METADATA_REQUEST_ROWS;
    constexpr int64_t context = PAGE_METADATA_CONTEXT;
    constexpr int64_t mapping_size = PAGE_METADATA_MAPPING_SIZE;
    constexpr int32_t page_rows = PAGE_METADATA_PAGE_ROWS;
    constexpr int32_t window_rows = PAGE_METADATA_WINDOW_ROWS;
    constexpr int32_t page_shift = kPageShift;
    // Column stride is derivable once per actor. Keep unbounded table/mapping
    // extents INT64; batch*block and page/window already have INT32 host bounds.
    constexpr int64_t columns = (context + page_rows - 1) / page_rows;
    __gm__ int32_t *tokens, *pages, *boundaries, *seq_lens, *live_rows;
    __gm__ int64_t *mapping, *req, *pos, *full, *swa;
    tokens = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)req_to_token);
    pages = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)table);
    boundaries = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)cu);
    seq_lens = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)lengths);
    live_rows = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)routed_rows);
    mapping = reinterpret_cast<__gm__ int64_t *>((__gm__ int64_t *)full_to_swa);
    req = reinterpret_cast<__gm__ int64_t *>((__gm__ int64_t *)requests);
    pos = reinterpret_cast<__gm__ int64_t *>((__gm__ int64_t *)prefix);
    full = reinterpret_cast<__gm__ int64_t *>((__gm__ int64_t *)full_slots);
    swa = reinterpret_cast<__gm__ int64_t *>((__gm__ int64_t *)slots);

    // Single slot per output/input arena. Each store retires MTE3 before
    // Scalar reuses its source; MTE2 input retires before the next chunk load.
    constexpr uint32_t page_offset = 0;
    constexpr uint32_t slot_offset = page_offset + kMappingTileElements * sizeof(int32_t);
    constexpr uint32_t input_offset = slot_offset + kMappingTileElements * sizeof(int64_t);
    constexpr uint32_t boundary_offset = input_offset + kMappingTileElements * sizeof(int64_t);
    constexpr uint32_t length_offset =
        boundary_offset + kBoundaryCapacityElements * sizeof(int32_t);
    auto page = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(page_offset));
    auto slot = reinterpret_cast<__ubuf__ int64_t *>(uint64_t(slot_offset));
    auto input = reinterpret_cast<__ubuf__ int64_t *>(uint64_t(input_offset));
    auto boundary = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(boundary_offset));
    auto length = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(length_offset));
    constexpr TEventID sm = 0, ms = 0, ls = 0, sl = 0;
    int64_t owned_live_rows = 0;
    for (int64_t start = GetBlockIdx() * kRequestsPerGroup; start < batch;
         start += kWorkers * kRequestsPerGroup) {
        uint32_t n = batch - start < kRequestsPerGroup ? batch - start : kRequestsPerGroup;
        for (uint32_t j = 0; j < n; ++j) {
            int64_t b = start + j;
            int64_t request = req[b], first_position = pos[b];
            owned_live_rows += request > 0 ? block : 0;
            bool live = request > 0 && request < request_rows;
            bool valid = live && first_position >= 0 && first_position <= context - block;
            boundary[j] = static_cast<int32_t>(b * block);
            length[j] = valid ? static_cast<int32_t>(first_position + block) : 0;

            if (valid) {
                int64_t begin =
                    first_position > window_rows
                        ? page_index(first_position - window_rows, page_rows, page_shift)
                        : 0;
                int64_t end =
                    page_index(first_position + block + page_rows - 1, page_rows, page_shift);
                for (int64_t p = begin; p < end; p += kMappingTileElements) {
                    uint32_t count =
                        end - p < kMappingTileElements ? end - p : kMappingTileElements;
                    for (uint32_t k = 0; k < count; ++k) {
                        int64_t full_token = tokens[request * context + (p + k) * page_rows];
                        int64_t translated = full_token >= 0 && full_token < mapping_size
                                                 ? mapping[full_token]
                                                 : int64_t(-1);
                        // PyTorch floor division maps sentinel -1 to page -1.
                        page[k] =
                            translated >= 0 ? page_index(translated, page_rows, page_shift) : -1;
                    }
                    set_flag(PIPE_S, PIPE_MTE3, ::event_t(sm));
                    wait_flag(PIPE_S, PIPE_MTE3, ::event_t(sm));
                    asc_copy_ub2gm_align(
                        reinterpret_cast<__gm__ uint8_t *>((pages + (b * columns + p))),
                        reinterpret_cast<__ubuf__ uint8_t *>(page), 1, count * kPageBytes, 0, 0, 0,
                        0);
                    set_flag(PIPE_MTE3, PIPE_S, ::event_t(ms));
                    wait_flag(PIPE_MTE3, PIPE_S, ::event_t(ms));
                }
            }
            for (int64_t t = 0; t < block; t += kMappingTileElements) {
                uint32_t count =
                    block - t < kMappingTileElements ? block - t : kMappingTileElements;
                asc_copy_gm2ub_align(reinterpret_cast<__ubuf__ uint8_t *>(input),
                                     reinterpret_cast<__gm__ uint8_t *>((full + (b * block + t))),
                                     1, count * kSlotBytes, 0, 0, 0, 0);
                set_flag(PIPE_MTE2, PIPE_S, ::event_t(ls));
                wait_flag(PIPE_MTE2, PIPE_S, ::event_t(ls));
                for (uint32_t k = 0; k < count; ++k) {
                    int64_t value = input[k];
                    slot[k] =
                        valid && value >= 0 && value < mapping_size ? mapping[value] : int64_t(-1);
                }
                set_flag(PIPE_S, PIPE_MTE2, ::event_t(sl));
                wait_flag(PIPE_S, PIPE_MTE2, ::event_t(sl));
                set_flag(PIPE_S, PIPE_MTE3, ::event_t(sm));
                wait_flag(PIPE_S, PIPE_MTE3, ::event_t(sm));
                asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((swa + (b * block + t))),
                                     reinterpret_cast<__ubuf__ uint8_t *>(slot), 1,
                                     count * kSlotBytes, 0, 0, 0, 0);
                set_flag(PIPE_MTE3, PIPE_S, ::event_t(ms));
                wait_flag(PIPE_MTE3, PIPE_S, ::event_t(ms));
            }
        }
        bool last = start + n == batch;
        if (last)
            boundary[n] = static_cast<int32_t>(batch * block);
        set_flag(PIPE_S, PIPE_MTE3, ::event_t(sm));
        wait_flag(PIPE_S, PIPE_MTE3, ::event_t(sm));
        asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((boundaries + (start))),
                             reinterpret_cast<__ubuf__ uint8_t *>(boundary), 1,
                             (n + (last ? 1U : 0U)) * kPageBytes, 0, 0, 0, 0);
        asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((seq_lens + (start))),
                             reinterpret_cast<__ubuf__ uint8_t *>(length), 1, n * kPageBytes, 0, 0,
                             0, 0);
        set_flag(PIPE_MTE3, PIPE_S, ::event_t(ms));
        wait_flag(PIPE_MTE3, PIPE_S, ::event_t(ms));
    }
    if (GetBlockIdx() == 0) {
        // Actor0 already read and counted its own eight-request groups.
        // Scan only the intervening groups owned by the other actors, so a
        // single worker never rereads the request list. Invalid positive IDs
        // retain the routed-row contract even when their metadata is empty.
        int64_t live = owned_live_rows;
        for (int64_t group = 0; group < batch; group += kWorkers * kRequestsPerGroup)
            for (int64_t b = group + kRequestsPerGroup;
                 b < min(int64_t(batch), group + kWorkers * kRequestsPerGroup); ++b)
                live += req[b] > 0 ? block : 0;
        length[0] = static_cast<int32_t>(live);
        if (!batch)
            boundary[0] = 0;
        set_flag(PIPE_S, PIPE_MTE3, ::event_t(sm));
        wait_flag(PIPE_S, PIPE_MTE3, ::event_t(sm));
        if (!batch)
            asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>(boundaries),
                                 reinterpret_cast<__ubuf__ uint8_t *>(boundary), 1, kPageBytes, 0,
                                 0, 0, 0);
        asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>(live_rows),
                             reinterpret_cast<__ubuf__ uint8_t *>(length), 1, kPageBytes, 0, 0, 0,
                             0);
        set_flag(PIPE_MTE3, PIPE_S, ::event_t(ms));
        wait_flag(PIPE_MTE3, PIPE_S, ::event_t(ms));
    }
    set_flag(PIPE_MTE2, PIPE_S, ::event_t(kMemoryConsumerDrain));
    wait_flag(PIPE_MTE2, PIPE_S, ::event_t(kMemoryConsumerDrain));
    set_flag(PIPE_MTE3, PIPE_S, ::event_t(kMemoryConsumerDrain));
    wait_flag(PIPE_MTE3, PIPE_S, ::event_t(kMemoryConsumerDrain));
}
