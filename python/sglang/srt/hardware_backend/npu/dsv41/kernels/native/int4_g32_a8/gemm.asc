#include <int4_g32_a8/cube_pipeline.h>
#include <int4_g32_a8/vector_pipeline.h>

extern "C" __global__ __mix__(1, 2) void int4_g32_a8_kernel(int4_g32_a8::Inputs args) {
    using namespace int4_g32_a8;
    if (!reinterpret_cast<__gm__ const int32_t *>(args.routing)[grouped_metadata::kActiveCount])
        return;
    int core = AscendC::GetBlockIdx();
    if ASCEND_IS_AIV {
        core /= 2;
    }
    const int lane = AscendC::GetSubBlockIdx();
    auto bridge = reinterpret_cast<__gm__ int8_t *>(args.scratch) + int64_t(core) * worker_bytes;
    grouped_gemm::Schedule<rows, columns> schedule(reinterpret_cast<GM_ADDR>(args.routing),
                                                args.experts, panels, width);
    Tile tile{}, previous{};
    int generation = 0, job = 0, previous_rows = 0;
    bool more = false;
    if (!schedule.next(core, tile))
        return;
    AscendC::InitSocState();
    AscendC::SetSaturationFlag<AscendC::SaturationMode::FLOAT>(false);
    const int known = schedule.known_steps(core, workers);
    if ASCEND_IS_AIC {
        asc_set_l0c_copy_params(1, 0, 0);
        native_device::pipe_fence<PIPE_S, PIPE_FIX>(0);
        if constexpr (rows > fractal_rows)
            set_l3d_rpt(uint64_t(1) << 16);
    }
    do {
        if ASCEND_IS_AIC {
            const int live_rows = rows == fractal_rows || (keep_activation && tile.valid > rows / 2)
                                      ? rows : (tile.valid + 15) / 16 * 16;
            if constexpr (rows > fractal_rows) {
                if (live_rows != previous_rows) {
                    if (job)
                        native_device::pipe_fence<PIPE_FIX, PIPE_MTE1>(6);
                    if (live_rows > fractal_rows) {
                        native_device::pipe_fence<PIPE_MTE1, PIPE_S>(6);
                        set_fmatrix(uint64_t(live_rows) | (uint64_t(1) << 16));
                        native_device::pipe_fence<PIPE_S, PIPE_MTE1>(6);
                    }
                    previous_rows = live_rows;
                }
            }
            const bool same_activation = keep_activation && job && tile.row == previous.row && tile.valid == previous.valid;
            for (int part = 0; part < panels; ++part)
                cube(args, tile, part, generation + part, job, bridge, live_rows, known, same_activation);
            if constexpr (keep_activation)
                previous = tile;
        }
        if ASCEND_IS_AIV {
            for (int step = carry_weights && job ? lookahead + 1 : 0;
                 step < weight_steps + (carry_weights ? 0 : slots); ++step) {
                const int serial = generation * blocks + step;
                if (step < weight_steps)
                    load(args, tile, step, serial, lane);
                if (step >= 1 && step <= weight_steps)
                    decode(step - 1, serial - 1, known);
                if (step >= 2)
                    publish(step - 2, serial - 2, lane, bridge, known);
            }
        }
        Tile ahead{};
        if constexpr (carry_weights)
            more = (known < 0 || generation + panels < known) && schedule.next(core + (job + 1) * workers, ahead);
        if ASCEND_IS_AIV {
            const int next_serial = (generation + panels) * blocks;
            if constexpr (carry_weights) {
                if (more) {
                    for (int step = 0; step < lookahead; ++step) {
                        const int serial = next_serial + step;
                        load(args, ahead, step, serial, lane);
                        decode(serial - 1, serial - 1, known);
                        publish(serial - 2, serial - 2, lane, bridge, known);
                    }
                    const int serial = next_serial + lookahead;
                    decode(serial - 1, serial - 1, known);
                    publish(serial - 2, serial - 2, lane, bridge, known);
                } else {
                    decode(weight_steps - 1, next_serial - 1, known);
                    publish(weight_steps - 2, next_serial - 2, lane, bridge, known);
                    publish(weight_steps - 1, next_serial - 1, lane, bridge, known);
                }
            }
            if (job)
                finish(args, previous, job - 1, lane, bridge, more ? &ahead : nullptr);
            else if (carry_weights && more)
                load(args, ahead, lookahead, next_serial + lookahead, lane);
            previous = tile;
        }
        generation += panels;
        ++job;
        if constexpr (carry_weights)
            tile = ahead;
        else
            more = (known < 0 || generation < known) && schedule.next(core + job * workers, tile);
    } while (more);
    if ASCEND_IS_AIV {
        if (job)
            finish(args, previous, job - 1, lane, bridge);
        wait_flag(PIPE_V, PIPE_MTE2, ::event_t(6));
        wait_flag(PIPE_MTE3, PIPE_V, ::event_t(6));
    }
    for (int slot = 0; known < 0 && slot < slots; ++slot) {
        if ASCEND_IS_AIV {
            if (slot < generation * blocks) {
                wait_flag(PIPE_V, PIPE_MTE2, ::event_t(slot));
                wait_flag(PIPE_MTE3, PIPE_V, ::event_t(slot));
            }
            if (slot < generation)
                AscendC::CrossCoreWaitFlag<2, PIPE_MTE3>(2 + slot);
        }
        if ASCEND_IS_AIC {
            if (slot < generation)
                wait_flag(PIPE_MTE1, PIPE_MTE2, ::event_t(slot));
            if (slot < generation * chunks)
                wait_flag(PIPE_M, PIPE_MTE1, ::event_t(slot));
        }
    }
    pipe_barrier(PIPE_ALL);
}
