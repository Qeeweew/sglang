// CED per-request tail maps and byte-exact row movement.
#include <common/device.h>
#include <kernel_operator.h>
#include <c_api/asc_simd.h>
#include <common/arch2201.h>
using namespace AscendC;
namespace {
// HEAD uses two metadata repeat groups and a 4-KiB row-copy DMA chunk.
// Neither capacity constrains request/window/row sizes: all are tiled.
constexpr uint32_t kMapTileElements = 2 * ONE_REPEAT_BYTE_SIZE / sizeof(int32_t);
constexpr uint32_t kCopyTileBytes = 4 * arch2201::kKiB;
constexpr uint32_t kCopySlots = 2;
constexpr int32_t kIndexHandoff = 0; // sole V<->S token in metadata generation
static_assert(kCopySlots * kCopyTileBytes <= arch2201::kUbBytes);

__aicore__ constexpr uint32_t gcd_bytes(uint64_t a, uint32_t b) {
    while (b) {
        const uint32_t next = a % b;
        a = b;
        b = next;
    }
    return uint32_t(a);
}
// The SDK high-level ArithProgression fetches hidden TPipe events. CED owns
// this handoff explicitly: seed one DMA block in Scalar, then double the live
// contiguous span with four dependent vector adds. No queue allocator needed.
__aicore__ void fill_sequential_rows(__ubuf__ int32_t *rows, int32_t first) {
    constexpr uint32_t kSeedElements = ONE_BLK_SIZE / sizeof(int32_t);
    native_device::pipe_fence<PIPE_V, PIPE_S, kIndexHandoff>();
    for (uint32_t i = 0; i < kSeedElements; ++i)
        rows[i] = first + int32_t(i);
    native_device::pipe_fence<PIPE_S, PIPE_V, kIndexHandoff>();
#pragma unroll
    for (uint32_t span = kSeedElements; span < kMapTileElements; span *= 2) {
        asc_add_scalar((rows + (span)), rows, int32_t(span), span);
        pipe_barrier(PIPE_V);
    }
}
} // namespace
#if defined(CED_METADATA)

__global__ __aicore__ void ced_metadata_kernel(GM_ADDR cu, GM_ADDR row_map, GM_ADDR requests,
                                               GM_ADDR tail_cu, GM_ADDR live, uint32_t batch, int64_t capacity) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    constexpr uint32_t window = CED_WINDOW;
    // This entry owns two fixed metadata spans. No queue/pool state is needed.
    auto map_tile = reinterpret_cast<__ubuf__ int32_t *>(uint64_t(0));
    auto request_tile =
        reinterpret_cast<__ubuf__ int32_t *>(uint64_t(kMapTileElements * sizeof(int32_t)));
    __gm__ int32_t *input, *output, *req, *prefix, *count;
    input = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)cu);
    output = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)row_map);
    req = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)requests);
    prefix = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)tail_cu);
    count = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)live);
    int64_t needed = 0;
    for (uint32_t b = 0; b < batch; ++b) {
        int32_t first = input[b], end = input[b + 1];
        uint32_t n = (first >= 0 && end >= first) ? static_cast<uint32_t>(end - first) : 0;
        needed += n < window ? n : window;
    }
    constexpr uint32_t kScalarMapElements = ONE_BLK_SIZE / sizeof(int32_t);
    if constexpr (CED_SMALL_MAP) {
        // No Vector reader/producer exists in this single-block plan.
        DisableDmaAtomic();
        const bool overflow = needed > capacity;
        int64_t cursor = 0;
        prefix[0] = 0;
        for (uint32_t b = 0; b < batch; ++b) {
            const int32_t first = input[b], end = input[b + 1];
            const uint32_t length = first >= 0 && end >= first ? uint32_t(end - first) : 0;
            const uint32_t n = overflow ? 0 : (length < window ? length : window);
            for (uint32_t j = 0; j < n; ++j) {
                map_tile[cursor + j] = end - int32_t(n) + j;
                request_tile[cursor + j] = b;
            }
            cursor += n;
            prefix[b + 1] = cursor;
        }
        // Aligned DMA may read the entire UB block, including unused lanes.
        for (uint32_t j = uint32_t(cursor); j < kScalarMapElements; ++j) {
            map_tile[j] = -1;
            request_tile[j] = -1;
        }
        if (capacity > 0) {
            constexpr uint32_t kScalarMapReady = 0, kScalarMapStored = 0;
            native_device::pipe_fence<PIPE_S, PIPE_MTE3, kScalarMapReady>();
            asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>(output),
                                 reinterpret_cast<__ubuf__ uint8_t *>(map_tile), 1,
                                 uint32_t(capacity * sizeof(int32_t)), 0, 0, 0, 0);
            asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>(req),
                                 reinterpret_cast<__ubuf__ uint8_t *>(request_tile), 1,
                                 uint32_t(capacity * sizeof(int32_t)), 0, 0, 0, 0);
            native_device::pipe_fence<PIPE_MTE3, PIPE_S, kScalarMapStored>();
        }
        count[0] = overflow ? -needed : cursor;
        return;
    }
    InitSocState();
    constexpr int32_t kMapReadyForStore = 0; // one live token on this pipe pair
    constexpr int32_t kMapReusable = 0;      // one live token on this pipe pair
    // Live rows are fully generated below; initialize only the unused tail.
    // Overflow publishes no valid rows, so its complete output is invalid.
    const int64_t invalid_begin = needed > capacity ? 0 : needed;
    if (invalid_begin < capacity) {
        asc_duplicate(map_tile, -1, kMapTileElements);
        asc_duplicate(request_tile, -1, kMapTileElements);
        pipe_barrier(PIPE_V);
        for (int64_t start = invalid_begin; start < capacity; start += kMapTileElements) {
            uint32_t n = (capacity - start < kMapTileElements) ? capacity - start : kMapTileElements;
            native_device::pipe_fence<PIPE_V, PIPE_MTE3, kMapReadyForStore>();
            asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((output + (start))),
                                 reinterpret_cast<__ubuf__ uint8_t *>(map_tile), 1,
                                 n * uint32_t(sizeof(int32_t)), 0, 0, 0, 0);
            asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((req + (start))),
                                 reinterpret_cast<__ubuf__ uint8_t *>(request_tile), 1,
                                 n * uint32_t(sizeof(int32_t)), 0, 0, 0, 0);
            native_device::pipe_fence<PIPE_MTE3, PIPE_V, kMapReusable>();
        }
    }
    if (needed > capacity) {
        native_device::pipe_fence<PIPE_V, PIPE_S, kIndexHandoff>();
        for (uint32_t b = 0; b <= batch; ++b)
            prefix[b] = 0;
        // No partial route publication: negative live reports required size.
        count[0] = -needed;
        return;
    }
    int64_t cursor = 0;
    prefix[0] = 0;
    for (uint32_t b = 0; b < batch; ++b) {
        int32_t first = input[b], end = input[b + 1];
        uint32_t n = (first >= 0 && end >= first) ? static_cast<uint32_t>(end - first) : 0;
        n = n < window ? n : window;
        if (cursor + n > capacity)
            n = capacity > cursor ? capacity - cursor : 0;
        for (uint32_t j = 0; j < n; j += kMapTileElements) {
            uint32_t tile = (n - j < kMapTileElements) ? n - j : kMapTileElements;
            fill_sequential_rows(map_tile, end - static_cast<int32_t>(n) + j);
            asc_duplicate(request_tile, static_cast<int32_t>(b), kMapTileElements);
            pipe_barrier(PIPE_V);
            native_device::pipe_fence<PIPE_V, PIPE_MTE3, kMapReadyForStore>();
            asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((output + (cursor + j))),
                                 reinterpret_cast<__ubuf__ uint8_t *>(map_tile), 1,
                                 tile * uint32_t(sizeof(int32_t)), 0, 0, 0, 0);
            asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((req + (cursor + j))),
                                 reinterpret_cast<__ubuf__ uint8_t *>(request_tile), 1,
                                 tile * uint32_t(sizeof(int32_t)), 0, 0, 0, 0);
            native_device::pipe_fence<PIPE_MTE3, PIPE_V, kMapReusable>();
        }
        cursor += n;
        prefix[b + 1] = cursor;
    }
    // The final MTE3->V reuse wait is a consumer instruction on V. Retire
    // that instruction as well as its DMA producer before returning.
    native_device::pipe_fence<PIPE_V, PIPE_S, kIndexHandoff>();
    count[0] = cursor;
}
#else
__global__ __aicore__ void ced_copy_kernel(GM_ADDR source, GM_ADDR row_map, GM_ADDR output,
                                                int64_t map_rows, int64_t source_rows, int64_t output_rows) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    constexpr uint32_t workers = CED_WORKERS;
    constexpr int64_t row_bytes = CED_ROW_BYTES;
    constexpr uint32_t row_group = 32 / gcd_bytes(CED_ROW_BYTES, 32);
    constexpr bool scatter = CED_SCATTER;
    InitSocState();
    constexpr uint32_t fill_byte = CED_FILL;
    __gm__ uint8_t *src, *dst;
    __gm__ int32_t *map;
    src = reinterpret_cast<__gm__ uint8_t *>(source);
    dst = reinterpret_cast<__gm__ uint8_t *>(output);
    map = reinterpret_cast<__gm__ int32_t *>((__gm__ int32_t *)row_map);
    // Two private slots overlap the GM read/write engines. Each final store
    // publishes MTE3 -> S on slot0/1; Scalar consumes it before issuing any
    // new producer for that slot. The first two producers need no credit.
    // Partial GM cache lines require serialized RMW, even within one row.
    constexpr uint32_t slots = row_bytes % ONE_BLK_SIZE == 0 ? kCopySlots : 1;
    bool pending[kCopySlots] = {false, false};
    int64_t generation = 0;
    int64_t tasks = scatter ? 1 : (map_rows + row_group - 1) / row_group;
    int64_t group_start = scatter ? 0 : GetBlockIdx();
    int64_t group_step = scatter ? 1 : workers;
    for (int64_t group = group_start; group < tasks; group += group_step) {
        int64_t start = scatter ? 0 : group * row_group;
        int64_t end =
            scatter ? map_rows : ((start + row_group < map_rows) ? start + row_group : map_rows);
        for (int64_t row = start; row < end; ++row) {
            int64_t mapped = map[row];
            bool valid = mapped >= 0 && mapped < (scatter ? output_rows : source_rows);
            if (scatter && (!valid || (mapped / row_group) % workers != GetBlockIdx()))
                continue;
            int64_t si = scatter ? row : mapped, di = scatter ? mapped : row;
            for (int64_t chunk = 0; chunk < row_bytes; chunk += kCopyTileBytes, ++generation) {
                const uint32_t slot = uint32_t(generation) & (slots - 1);
                if (pending[slot])
                    wait_flag(PIPE_MTE3, PIPE_S, ::event_t(slot));
                auto tmp = reinterpret_cast<__ubuf__ uint8_t *>(uint64_t(slot * kCopyTileBytes));
                uint32_t n =
                    (row_bytes - chunk < kCopyTileBytes) ? row_bytes - chunk : kCopyTileBytes;
                if (valid) {
                    asc_copy_gm2ub_align(
                        reinterpret_cast<__ubuf__ uint8_t *>(tmp),
                        reinterpret_cast<__gm__ uint8_t *>((src + (si * row_bytes + chunk))), 1, n,
                        0, 0, 0, 0);
                    native_device::pipe_fence<PIPE_MTE2, PIPE_MTE3>(slot);
                } else {
                    asc_duplicate(reinterpret_cast<__ubuf__ uint32_t *>(tmp),
                                  fill_byte ? 0xffffffffU : 0U,
                                  (n + sizeof(uint32_t) - 1) / sizeof(uint32_t));
                    pipe_barrier(PIPE_V);
                    native_device::pipe_fence<PIPE_V, PIPE_MTE3>(slot);
                }
                asc_copy_ub2gm_align(
                    reinterpret_cast<__gm__ uint8_t *>((dst + (di * row_bytes + chunk))),
                    reinterpret_cast<__ubuf__ uint8_t *>(tmp), 1, n, 0, 0, 0, 0);
                set_flag(PIPE_MTE3, PIPE_S, ::event_t(slot));
                pending[slot] = true;
            }
            if constexpr (scatter) {
                // A later route can target this same row. Retire all pieces
                // before the next source row, preserving last-wins ordering.
                for (uint32_t slot = 0; slot < slots; ++slot)
                    if (pending[slot]) {
                        wait_flag(PIPE_MTE3, PIPE_S, ::event_t(slot));
                        pending[slot] = false;
                    }
            }
        }
    }
    // Every slot's final store and its ready consumer retire before return.
    for (uint32_t slot = 0; slot < slots; ++slot)
        if (pending[slot])
            wait_flag(PIPE_MTE3, PIPE_S, ::event_t(slot));

}
#endif
