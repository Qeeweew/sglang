// Compressed MXFP4 grouped GEMM, Ascend 910B mixed AIC + 2 AIV.
#include <kernel_operator.h>
#include <quant_grouped_gemm/decode_pipeline.h>
#include <quant_grouped_gemm/cube_pipeline.h>

using Plan =
    quant_gmm::Layout<QUANT_GMM_BM, QUANT_GMM_BN>;

extern "C" __global__ __mix__(1, 2) void quant_grouped_gemm_kernel(GM_ADDR activation,
                                                                  GM_ADDR packed, GM_ADDR scales,
                                                                  GM_ADDR routing, GM_ADDR output,
                                                                  GM_ADDR workspace) {
    constexpr int experts = QUANT_GMM_EXPERTS;
    constexpr int cores = QUANT_GMM_WORKERS;
    static_assert(cores > 0 && experts > 0 && QUANT_GMM_K > 0 && QUANT_GMM_N > 0 &&
                  Plan::StepK > 0 && QUANT_GMM_K % Plan::StepK == 0);
    // Own the SDK defaults once: atomic/mask state on both actors, plus
    // AIC Load3D padding and boundary. Cube initializes only its other state.
    AscendC::InitSocState();
    // Preserve IEEE inf/NaN behavior for FP16 decode and conversion.
    AscendC::SetSaturationFlag<AscendC::SaturationMode::FLOAT>(false);
    if ASCEND_IS_AIV {
        quant_gmm::DecodePipeline<Plan> pipeline;
        pipeline.run(packed, scales, routing, workspace, experts, cores);
    }
    if ASCEND_IS_AIC {
        quant_gmm::CubePipeline<Plan> pipeline;
        pipeline.run(activation, routing, output, workspace, experts, cores);
    }
}
