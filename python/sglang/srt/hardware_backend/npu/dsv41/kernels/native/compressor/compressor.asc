// V4.1 C1/C2 projected epilogue and transactional pending-state update.
// Ascend C dav-2201; asc-devkit 9.1 DataCopy, DataCopyPad, ReduceSum and
// Explicit private events. No projection, RoPE, quantization or cache scatter.
#include <common/device.h>
#include <kernel_operator.h>
#include <compressor/params.h>
#include <c_api/asc_simd.h>
#include <compressor/arena.h>
using namespace AscendC;
namespace {
constexpr int64_t kWorkers = COMPRESSOR_WORKERS;
}

class MetadataWriter {
    __ubuf__ uint8_t *scratch;
    // Scalar writes -> DMA export -> Scalar scratch reuse, one live token.
    static constexpr TEventID publish = 0, retire = 0;
    template <typename T> __aicore__ inline __ubuf__ T *local_packet() {
        return reinterpret_cast<__ubuf__ T *>(scratch);
    }

  public:
    __aicore__ inline void initialize(uint32_t address) {
        scratch = reinterpret_cast<__ubuf__ uint8_t *>(uint64_t(address));
    }
    __aicore__ inline void write_i64(__gm__ int64_t *dst, int64_t index, int64_t value) {
        auto local = local_packet<int64_t>();
        local[0] = value;
        native_device::pipe_fence<PIPE_S, PIPE_MTE3, publish>();
        asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((dst + (index))),
                             reinterpret_cast<__ubuf__ uint8_t *>(local), 1, 8, 0, 0, 0, 0);
        native_device::pipe_fence<PIPE_MTE3, PIPE_S, retire>();
    }
    __aicore__ inline void write_i32(__gm__ int32_t *dst, int64_t index, int32_t value) {
        auto local = local_packet<int32_t>();
        local[0] = value;
        native_device::pipe_fence<PIPE_S, PIPE_MTE3, publish>();
        asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((dst + (index))),
                             reinterpret_cast<__ubuf__ uint8_t *>(local), 1, 4, 0, 0, 0, 0);
        native_device::pipe_fence<PIPE_MTE3, PIPE_S, retire>();
    }
    __aicore__ inline void write_pair(__gm__ int64_t *dst, __gm__ int64_t *rope, int64_t index,
                                      int64_t completion, int64_t source) {
        auto local = local_packet<int64_t>();
        local[0] = completion;
        local[4] = source;
        native_device::pipe_fence<PIPE_S, PIPE_MTE3, publish>();
        asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((dst + (index))),
                             reinterpret_cast<__ubuf__ uint8_t *>(local), 1, 8, 0, 0, 0, 0);
        asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((rope + (index))),
                             reinterpret_cast<__ubuf__ uint8_t *>((local + (4))), 1, 8, 0, 0, 0, 0);
        native_device::pipe_fence<PIPE_MTE3, PIPE_S, retire>();
    }
    __aicore__ inline void write_positions(__gm__ int64_t *dst, __gm__ int64_t *rope, int64_t begin,
                                           int64_t end, int64_t start, int64_t accepted, bool valid,
                                           int64_t ratio) {
        auto local = local_packet<int64_t>();
        for (int64_t first = begin; first < end; first += 32) {
            int64_t count = end - first < 32 ? end - first : 32;
            for (int64_t lane = 0; lane < count; ++lane) {
                int64_t offset = first + lane - begin, position = start + offset;
                bool completed = valid && offset < accepted && (ratio == 1 || position % 2 == 1);
                local[lane] = completed ? position : -1;
                local[32 + lane] = completed ? position - (ratio - 1) : -1;
            }
            native_device::pipe_fence<PIPE_S, PIPE_MTE3, publish>();
            asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((dst + (first))),
                                 reinterpret_cast<__ubuf__ uint8_t *>(local), 1,
                                 uint32_t(count * 8), 0, 0, 0, 0);
            asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>((rope + (first))),
                                 reinterpret_cast<__ubuf__ uint8_t *>((local + (32))), 1,
                                 uint32_t(count * 8), 0, 0, 0, 0);
            native_device::pipe_fence<PIPE_MTE3, PIPE_S, retire>();
        }
    }
};

// Each actor owns one width-sized payload per stage. Load retires before
// Vector reads; every output store retires before payload/workspace reuse.
// C1 and C2 remain finite dataflow variants because their input dtype and
// weighted-pooling arithmetic differ, independently of width/token count.
// Preserve dav-2201 SDK ReduceSum's accumulator-mode vcadd, FP32 result
// and Scalar publication, while making its three formerly hidden events private.
__aicore__ inline void reduce_rms_squares(__ubuf__ float *dst, __ubuf__ float *src,
                                          uint32_t count) {
    if ASCEND_IS_AIV {
        constexpr TEventID kAccumulatorReady = 1, kVectorPublished = 1, kDmaPublished = 1;
        SetMaskCount();
        SetVectorMask<float, MaskMode::COUNTER>(0, count);
        vcadd(dst, src, 1, DEFAULT_REDUCE_DST_REP_STRIDE, DEFAULT_BLK_STRIDE, DEFAULT_REPEAT_STRIDE,
              true); // accumulator mode must be a literal
        native_device::pipe_fence<PIPE_V, PIPE_S, kAccumulatorReady>();
        dst[0] = GetReduceRepeatSumSpr<float>();
        native_device::pipe_fence<PIPE_S, PIPE_V, kVectorPublished>();
        native_device::pipe_fence<PIPE_S, PIPE_MTE3, kDmaPublished>();
        SetMaskNorm();
        SetVectorMask<float>(uint64_t(-1), uint64_t(-1));
    }
}

template <int RATIO> class Prepare {
    MetadataWriter writer;

  public:
    __aicore__ inline void run(GM_ADDR projected, GM_ADDR scores, GM_ADDR gamma, GM_ADDR cu_ptr,
                               GM_ADDR requests_ptr, GM_ADDR pending_ptr, GM_ADDR lengths_ptr,
                               GM_ADDR pooled_ptr, GM_ADDR latent_ptr, GM_ADDR positions_ptr,
                               GM_ADDR rope_ptr, GM_ADDR starts_ptr, int64_t tokens, int64_t batches) {
        constexpr int64_t slots = COMPRESSOR_SLOTS, width = COMPRESSOR_WIDTH;
        constexpr float inverse_width = 1.0f / float(width);
        using Arena = compressor::PrepareArena<RATIO>;
        writer.initialize(Arena::kMetadata);
        auto raw = reinterpret_cast<__ubuf__ bfloat16_t *>(uint64_t(Arena::kRaw));
        auto packed = reinterpret_cast<__ubuf__ bfloat16_t *>(uint64_t(Arena::kPacked));
        auto first = reinterpret_cast<__ubuf__ float *>(uint64_t(Arena::kFirst));
        __ubuf__ float *second, *work, *reciprocal;
        if constexpr (RATIO == 2) {
            second = reinterpret_cast<__ubuf__ float *>(uint64_t(Arena::kSecond));
            work = reinterpret_cast<__ubuf__ float *>(uint64_t(Arena::kWork));
            reciprocal = reinterpret_cast<__ubuf__ float *>(uint64_t(Arena::kReciprocal));
        }
        auto s0 = reinterpret_cast<__ubuf__ float *>(uint64_t(Arena::kScore0));
        auto s1 = reinterpret_cast<__ubuf__ float *>(uint64_t(Arena::kScore1));
        auto weight = reinterpret_cast<__ubuf__ float *>(uint64_t(Arena::kWeight));
        auto stats = reinterpret_cast<__ubuf__ float *>(uint64_t(Arena::kStats));
        auto reduction = reinterpret_cast<__ubuf__ float *>(uint64_t(Arena::kRefinement));
        __gm__ float *kv32, *gate, *pending, *norm, *pooled;
        __gm__ bfloat16_t *kv16, *latent;
        __gm__ int32_t *cu, *requests;
        __gm__ int64_t *lengths, *positions, *rope_positions, *starts;
        kv32 = reinterpret_cast<__gm__ float *>(projected);
        kv16 = reinterpret_cast<__gm__ bfloat16_t *>(projected);
        gate = reinterpret_cast<__gm__ float *>(scores);
        pending = reinterpret_cast<__gm__ float *>(pending_ptr);
        norm = reinterpret_cast<__gm__ float *>(gamma);
        pooled = reinterpret_cast<__gm__ float *>(pooled_ptr);
        latent = reinterpret_cast<__gm__ bfloat16_t *>(latent_ptr);
        cu = reinterpret_cast<__gm__ int32_t *>(cu_ptr);
        requests = reinterpret_cast<__gm__ int32_t *>(requests_ptr);
        lengths = reinterpret_cast<__gm__ int64_t *>(lengths_ptr);
        positions = reinterpret_cast<__gm__ int64_t *>(positions_ptr);
        rope_positions = reinterpret_cast<__gm__ int64_t *>(rope_ptr);
        starts = reinterpret_cast<__gm__ int64_t *>(starts_ptr);
        for (int64_t b = GetBlockIdx(); b < batches; b += kWorkers) {
            int64_t slot = requests[b];
            int64_t start = slot >= 0 && slot < slots ? lengths[slot] : -1;
            writer.write_i64(starts, b, start);
        }
        constexpr TEventID ready = 0;     // one token on this pipe pair
        constexpr TEventID load_safe = 0; // one token on this pipe pair
        constexpr TEventID publish = 0;   // one token on this pipe pair
        constexpr TEventID retire = 0;    // one token on this pipe pair
        constexpr TEventID scalar = 0;    // one token on this pipe pair
        asc_copy_gm2ub(weight, norm, uint32_t((width) * sizeof(float)));
        native_device::pipe_fence<PIPE_MTE2, PIPE_V, ready>();
        for (int64_t t = GetBlockIdx(); t < tokens; t += kWorkers) {
            int64_t lo = 0, hi = batches;
            while (lo + 1 < hi) {
                int64_t mid = (lo + hi) / 2;
                if (cu[mid] <= t)
                    lo = mid;
                else
                    hi = mid;
            }
            int64_t b = lo, offset = t - cu[b];
            int64_t slot = requests[b];
            int64_t start = slot >= 0 && slot < slots ? lengths[slot] : -1;
            int64_t position = start + offset;
            bool complete = start >= 0 && (RATIO == 1 || (position % 2) == 1);
            if (complete) {
                if constexpr (RATIO == 1) {
                    asc_copy_gm2ub(raw, (kv16 + (t * width)),
                                   uint32_t((width) * sizeof(bfloat16_t)));
                } else {
                    if (offset == 0) {
                        asc_copy_gm2ub(first, (pending + (slot * 2 * width)),
                                       uint32_t((width) * sizeof(float)));
                        asc_copy_gm2ub(s0, (pending + ((slot * 2 + 1) * width)),
                                       uint32_t((width) * sizeof(float)));
                    } else {
                        asc_copy_gm2ub(first, (kv32 + ((t - 1) * width)),
                                       uint32_t((width) * sizeof(float)));
                        asc_copy_gm2ub(s0, (gate + ((t - 1) * width)),
                                       uint32_t((width) * sizeof(float)));
                    }
                    asc_copy_gm2ub(second, (kv32 + (t * width)), uint32_t((width) * sizeof(float)));
                    asc_copy_gm2ub(s1, (gate + (t * width)), uint32_t((width) * sizeof(float)));
                }
                native_device::pipe_fence<PIPE_MTE2, PIPE_V, ready>();
                if constexpr (RATIO == 1) {
                    asc_bfloat162float(first, raw, width);
                } else {
                    asc_max(work, s0, s1, width);
                    pipe_barrier(PIPE_V);
                    asc_sub(s0, s0, work, width);
                    asc_sub(s1, s1, work, width);
                    pipe_barrier(PIPE_V);
                    asc_exp(s0, s0, width);
                    asc_exp(s1, s1, width);
                    pipe_barrier(PIPE_V);
                    asc_add(work, s0, s1, width);
                    pipe_barrier(PIPE_V);
                    asc_duplicate(reciprocal, 1.0f, width);
                    pipe_barrier(PIPE_V);
                    asc_div(reciprocal, reciprocal, work, width);
                    pipe_barrier(PIPE_V);
                    // dav-2201 Div is approximate. Refine the shared inverse
                    // once: r <- r * (2 - denominator*r), entirely FP32.
                    asc_mul(work, work, reciprocal, width);
                    pipe_barrier(PIPE_V);
                    asc_mul_scalar(work, work, -1.0f, width);
                    pipe_barrier(PIPE_V);
                    asc_add_scalar(work, work, 2.0f, width);
                    pipe_barrier(PIPE_V);
                    asc_mul(reciprocal, reciprocal, work, width);
                    pipe_barrier(PIPE_V);
                    asc_mul(s0, s0, reciprocal, width);
                    asc_mul(s1, s1, reciprocal, width);
                    pipe_barrier(PIPE_V);
                    asc_mul(first, first, s0, width);
                    asc_mul(second, second, s1, width);
                    pipe_barrier(PIPE_V);
                    asc_add(first, first, second, width);
                }
                pipe_barrier(PIPE_V);
                // Keep the full FP32 pool in the audit output. The checkpoint
                // contract rounds pooled values to BF16 before RMS statistics.
                native_device::pipe_fence<PIPE_V, PIPE_MTE3, publish>();
                asc_copy_ub2gm((pooled + (t * width)), first, uint32_t((width) * sizeof(float)));
                if constexpr (RATIO == 1) {
                    // C1 is already BF16. Read the original BF16 row again:
                    // its FP32 values equal round_BF16(first), including signed
                    // zero. This avoids one redundant FP32->BF16 conversion.
                    asc_bfloat162float(s0, raw, width);
                } else {
                    asc_float2bfloat16_rn(packed, first, width);
                    pipe_barrier(PIPE_V);
                    asc_bfloat162float(s0, packed, width);
                }
                pipe_barrier(PIPE_V);
                asc_mul(s1, s0, s0, width);
                pipe_barrier(PIPE_V);
                reduce_rms_squares(stats, s1, width);
                pipe_barrier(PIPE_V);
                // This entire scalar-statistic chain shares one NORMAL mask.
                // Barriers and the FP32 evaluation order are unchanged.
                asc_set_vector_mask(0, 1);
                asc_mul_scalar(stats, stats, inverse_width, uint8_t(1), 1, 1, 8, 8);
                pipe_barrier(PIPE_V);
                asc_add_scalar(stats, stats, 1e-20f, uint8_t(1), 1, 1, 8, 8);
                pipe_barrier(PIPE_V);
                asc_add_scalar(reduction, stats, 0.0f, uint8_t(1), 1, 1, 8, 8);
                pipe_barrier(PIPE_V);
                asc_rsqrt(stats, stats, uint8_t(1), 1, 1, 8, 8);
                pipe_barrier(PIPE_V);
                // Keep variance in (reduction + (0)), refine r <- r*(1.5-.5*v*r*r).
                asc_mul((reduction + (8)), stats, stats, uint8_t(1), 1, 1, 1, 8, 8, 8);
                pipe_barrier(PIPE_V);
                asc_mul((reduction + (8)), (reduction + (8)), reduction, uint8_t(1), 1, 1, 1, 8, 8,
                        8);
                pipe_barrier(PIPE_V);
                asc_mul_scalar((reduction + (8)), (reduction + (8)), -0.5f, uint8_t(1), 1, 1, 8, 8);
                pipe_barrier(PIPE_V);
                asc_add_scalar((reduction + (8)), (reduction + (8)), 1.5f, uint8_t(1), 1, 1, 8, 8);
                pipe_barrier(PIPE_V);
                asc_mul(stats, stats, (reduction + (8)), uint8_t(1), 1, 1, 1, 8, 8, 8);
                native_device::pipe_fence<PIPE_V, PIPE_S, scalar>();
                float inverse = stats[0];
                asc_mul_scalar(s0, s0, inverse, width);
                pipe_barrier(PIPE_V);
                asc_mul(s0, s0, weight, width);
                pipe_barrier(PIPE_V);
                asc_float2bfloat16_rn(packed, s0, width);
                writer.write_pair(positions, rope_positions, t, position, position - (RATIO - 1));
            } else {
                asc_duplicate(first, 0.0f, width);
                pipe_barrier(PIPE_V);
                asc_float2bfloat16_rn(packed, first, width);
                native_device::pipe_fence<PIPE_V, PIPE_MTE3, publish>();
                asc_copy_ub2gm((pooled + (t * width)), first, uint32_t((width) * sizeof(float)));
                writer.write_pair(positions, rope_positions, t, -1, -1);
            }
            native_device::pipe_fence<PIPE_V, PIPE_MTE3, publish>();
            asc_copy_ub2gm((latent + (t * width)), packed, uint32_t((width) * sizeof(bfloat16_t)));
            native_device::pipe_fence<PIPE_MTE3, PIPE_V, retire>();
            native_device::pipe_fence<PIPE_V, PIPE_MTE2, load_safe>();
        }
        constexpr TEventID kInputDrained = 0;
        native_device::pipe_fence<PIPE_MTE2, PIPE_S, kInputDrained>();
    }
};

template <int RATIO> class Commit {
    MetadataWriter writer;

  public:
    __aicore__ inline void run(GM_ADDR kv_ptr, GM_ADDR score_ptr, GM_ADDR cu_ptr,
                               GM_ADDR requests_ptr, GM_ADDR starts_ptr, GM_ADDR accepted_ptr,
                               GM_ADDR pending_ptr, GM_ADDR lengths_ptr,
                               GM_ADDR accepted_positions_ptr, GM_ADDR accepted_rope_ptr,
                               GM_ADDR status_ptr, int64_t batches) {
        constexpr int64_t slots = COMPRESSOR_SLOTS;
        constexpr int64_t width = COMPRESSOR_WIDTH;
        constexpr uint32_t pending_bytes = 2 * compressor::kWidthCapacityElements * 4;
        writer.initialize(pending_bytes);
        auto staging = reinterpret_cast<__ubuf__ float *>(uint64_t(0));
        __gm__ float *kv, *scores, *pending;
        __gm__ int32_t *cu, *requests, *accepted, *status;
        __gm__ int64_t *starts, *lengths, *accepted_positions, *accepted_rope_positions;
        kv = reinterpret_cast<__gm__ float *>(kv_ptr);
        scores = reinterpret_cast<__gm__ float *>(score_ptr);
        pending = reinterpret_cast<__gm__ float *>(pending_ptr);
        cu = reinterpret_cast<__gm__ int32_t *>(cu_ptr);
        requests = reinterpret_cast<__gm__ int32_t *>(requests_ptr);
        accepted = reinterpret_cast<__gm__ int32_t *>(accepted_ptr);
        status = reinterpret_cast<__gm__ int32_t *>(status_ptr);
        starts = reinterpret_cast<__gm__ int64_t *>(starts_ptr);
        lengths = reinterpret_cast<__gm__ int64_t *>(lengths_ptr);
        accepted_positions = reinterpret_cast<__gm__ int64_t *>(accepted_positions_ptr);
        accepted_rope_positions = reinterpret_cast<__gm__ int64_t *>(accepted_rope_ptr);
        constexpr TEventID ready = 0;     // one token on this pipe pair
        constexpr TEventID publish = 0;   // one token on this pipe pair
        constexpr TEventID retire = 0;    // one token on this pipe pair
        constexpr TEventID load_safe = 0; // one token on this pipe pair
        for (int64_t b = GetBlockIdx(); b < batches; b += kWorkers) {
            int64_t begin = cu[b], end = cu[b + 1];
            int64_t slot = requests[b], start = starts[b];
            int64_t keep = accepted[b];
            int32_t result = 0;
            if (slot < 0 || slot >= slots || start < 0)
                result = 3;
            else if (keep < 0 || keep > end - begin)
                result = 1;
            else if (lengths[slot] != start)
                result = 2;
            writer.write_positions(accepted_positions, accepted_rope_positions, begin, end, start,
                                   keep, result == 0, RATIO);
            if (result == 0 && keep > 0) {
                int64_t next = start + keep;
                if constexpr (RATIO == 2) {
                    if (next % 2 == 1) {
                        int64_t row = begin + keep - 1;
                        asc_copy_gm2ub(staging, (kv + (row * width)),
                                       uint32_t((width) * sizeof(float)));
                        asc_copy_gm2ub((staging + (width)), (scores + (row * width)),
                                       uint32_t((width) * sizeof(float)));
                        native_device::pipe_fence<PIPE_MTE2, PIPE_V, ready>();
                        native_device::pipe_fence<PIPE_V, PIPE_MTE3, publish>();
                        asc_copy_ub2gm((pending + (slot * 2 * width)), staging,
                                       uint32_t((2 * width) * sizeof(float)));
                        native_device::pipe_fence<PIPE_MTE3, PIPE_V, retire>();
                        native_device::pipe_fence<PIPE_V, PIPE_MTE2, load_safe>();
                    }
                }
                // Publication follows the pending payload in the same stream.
                writer.write_i64(lengths, slot, next);
            }
            writer.write_i32(status, b, result);
        }
        constexpr TEventID kInputDrained = 0;
        native_device::pipe_fence<PIPE_MTE2, PIPE_S, kInputDrained>();
    }
};

#ifndef COMPRESSOR_COMMIT
__global__ __aicore__ void compressor_prepare_kernel(GM_ADDR kv, GM_ADDR scores, GM_ADDR gamma,
                                                     GM_ADDR cu, GM_ADDR requests, GM_ADDR pending,
                                                     GM_ADDR lengths, GM_ADDR pooled,
                                                     GM_ADDR latent, GM_ADDR positions,
                                                     GM_ADDR rope_positions, GM_ADDR starts, int64_t tokens,
                                                         int64_t batches) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    InitSocState();
    if constexpr (COMPRESSOR_RATIO == 1) {
        Prepare<1> op;
        op.run(kv, scores, gamma, cu, requests, pending, lengths, pooled, latent, positions,
               rope_positions, starts, tokens, batches);
    } else {
        Prepare<2> op;
        op.run(kv, scores, gamma, cu, requests, pending, lengths, pooled, latent, positions,
               rope_positions, starts, tokens, batches);
    }
}

#else
__global__ __aicore__ void compressor_commit_kernel(GM_ADDR kv, GM_ADDR scores, GM_ADDR cu,
                                                    GM_ADDR requests, GM_ADDR starts,
                                                    GM_ADDR accepted, GM_ADDR pending,
                                                    GM_ADDR lengths, GM_ADDR positions,
                                                    GM_ADDR rope_positions, GM_ADDR status, int64_t batches) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    InitSocState();
    if constexpr (COMPRESSOR_RATIO == 1) {
        Commit<1> op;
        op.run(kv, scores, cu, requests, starts, accepted, pending, lengths, positions,
               rope_positions, status, batches);
    } else {
        Commit<2> op;
        op.run(kv, scores, cu, requests, starts, accepted, pending, lengths, positions,
               rope_positions, status, batches);
    }
}

#endif
