#include <common/arch2201.h>
#include <common/device.h>
#include <h32_quant/launch.h>
#include <kernel_operator.h>
#include <c_api/asc_simd.h>

using namespace AscendC;
namespace {
using native_device::ub_ptr;
using h32_quant::kMaxWidth;
using h32_quant::kPanelElements;
constexpr uint32_t kScaleBatchRows = 32;
constexpr uint32_t kInputBase = 12 * kMaxWidth;
constexpr uint32_t kRoundedBase = 16 * kMaxWidth;
constexpr uint32_t kCodesBase = 18 * kMaxWidth;
constexpr uint32_t kPeakBase = 20 * kMaxWidth;
constexpr uint32_t kScalesBase = kPeakBase + 32;
static_assert(kScalesBase + 2 * kScaleBatchRows * sizeof(float) <= arch2201::kUbBytes);

__aicore__ inline void prefetch(__gm__ uint16_t *input, int64_t row, uint32_t width, int slot) {
    asc_copy_gm2ub(ub_ptr<uint16_t>(kInputBase + slot * 2 * kMaxWidth), input + row * width,
                   2 * width);
    set_flag(PIPE_MTE2, PIPE_V, ::event_t(slot));
}

template <bool ToNatural>
__aicore__ inline void transpose_panels(__ubuf__ uint16_t *dst, __ubuf__ uint16_t *src,
                                        uint8_t panels) {
    // Split each H32 position into its high bit and low four bits.
    // The address lists map natural [group, high, low] to [low, high, group] or back.
    uint64_t dst_rows[16], src_rows[16];
    for (int row = 0; row < 16; ++row) {
        const int natural_row = 2 * (row % 8) + row / 8;
        dst_rows[row] = reinterpret_cast<uint64_t>(dst + 16 * (ToNatural ? natural_row : row));
        src_rows[row] = reinterpret_cast<uint64_t>(src + 16 * (ToNatural ? row : natural_row));
    }
    const uint16_t stride = panels > 1 ? 16 : 0; // 32-byte blocks per panel
    TransDataTo5HD<uint16_t>(dst_rows, src_rows, {false, false, panels, stride, stride});
    pipe_barrier(PIPE_V);
}

enum class ButterflyLayout { Interleaved, TransposedInput, TransposedOutput };

template <ButterflyLayout layout = ButterflyLayout::Interleaved>
__aicore__ inline void butterfly(__ubuf__ float *dst, __ubuf__ float *src, uint8_t panels) {
    constexpr bool transposed_input = layout == ButterflyLayout::TransposedInput;
    constexpr bool transposed_output = layout == ButterflyLayout::TransposedOutput;
    constexpr uint8_t src_stride = transposed_input ? 2 : 1;
    constexpr uint8_t dst_stride = transposed_output ? 4 : 2;
    for (int half = 0; half < 2; ++half) {
        auto left = src + half * 64 * src_stride;
        auto right = left + (transposed_input ? 8 : 128);
        auto sum = dst + half * (transposed_output ? 8 : 128);
        auto diff = sum + (transposed_output ? 16 : 8);
        asc_add(sum, left, right, panels, dst_stride, src_stride, src_stride, 32, 32, 32);
        asc_sub(diff, left, right, panels, dst_stride, src_stride, src_stride, 32, 32, 32);
    }
    pipe_barrier(PIPE_V);
}
} // namespace

extern "C" __global__ __aicore__ void h32_quant_kernel(
    GM_ADDR input, GM_ADDR codes, GM_ADDR scales, GM_ADDR count, int64_t rows, uint32_t width,
    uint32_t bf16, uint32_t interleaved) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    auto first = ub_ptr<float>(0);
    auto second = ub_ptr<float>(4 * kMaxWidth);
    auto work = ub_ptr<float>(8 * kMaxWidth);
    auto rounded = ub_ptr<half>(kRoundedBase);
    auto stat = ub_ptr<float>(kPeakBase);
    const uint8_t panels = width / kPanelElements;
    if (count) {
        const int32_t live = reinterpret_cast<__gm__ int32_t *>(count)[0];
        rows = min(rows, int64_t(live > 0 ? live : 0));
    }
    // Balanced contiguous ranges allow one DMA per block of scales.
    const int64_t worker = GetBlockIdx(), workers = GetBlockNum();
    const int64_t remainder = rows % workers;
    const int64_t length = rows / workers + (worker < remainder);
    if (!length)
        return;
    const int64_t start = worker * (rows / workers) + min(worker, remainder);
    auto source = reinterpret_cast<__gm__ uint16_t *>(input);
    asc_set_deq_scale(half(1));
    prefetch(source, start, width, 0);
    for (int64_t offset = 0; offset < length; ++offset) {
        const int64_t row = start + offset;
        const int slot = offset & 1, next_slot = slot ^ 1;
        const bool reuse_slot = offset + 2 < length;
        if (offset + 1 < length) {
            if (offset)
                wait_flag(PIPE_V, PIPE_MTE2, ::event_t(next_slot));
            prefetch(source, row + 1, width, next_slot);
        }
        wait_flag(PIPE_MTE2, PIPE_V, ::event_t(slot));
        auto raw = ub_ptr<uint16_t>(kInputBase + slot * 2 * kMaxWidth);
        auto cast_input = raw;
        if (!interleaved) {
            cast_input = reinterpret_cast<__ubuf__ uint16_t *>(work);
            transpose_panels<false>(cast_input, raw, panels);
        }
        if (bf16)
            asc_bfloat162float(first, reinterpret_cast<__ubuf__ bfloat16_t *>(cast_input), width);
        else
            asc_half2float(first, reinterpret_cast<__ubuf__ half *>(cast_input), width);
        if (reuse_slot)
            set_flag(PIPE_V, PIPE_MTE2, ::event_t(slot));
        pipe_barrier(PIPE_V);

        asc_set_vector_mask(0, UINT64_MAX);
        if (interleaved)
            butterfly(second, first, panels);
        else
            butterfly<ButterflyLayout::TransposedInput>(second, first, panels);
        butterfly(first, second, panels);
        butterfly(second, first, panels);
        butterfly(first, second, panels);
        butterfly<ButterflyLayout::TransposedOutput>(second, first, panels);

        asc_abs(first, second, width);
        pipe_barrier(PIPE_V);
        asc_datablock_reduce_max(work, first, width);
        pipe_barrier(PIPE_V);
        asc_datablock_reduce_max(first, work, width / 8);
        pipe_barrier(PIPE_V);
        asc_datablock_reduce_max(work, first, width / 64);
        pipe_barrier(PIPE_V);
        asc_repeat_reduce_max_only_value(stat, work, (width + 511) / 512);
        native_device::pipe_fence<PIPE_V, PIPE_S, EVENT_ID0>();
        const float peak = stat[0];
        const float scale = peak > 0.f ? peak / 127.f : 1.f;
        const int scale_index = offset % kScaleBatchRows;
        const int scale_slot = (offset / kScaleBatchRows) & 1;
        auto scale_batch = ub_ptr<float>(kScalesBase + scale_slot * kScaleBatchRows * sizeof(float));
        if (!scale_index && offset >= 2 * kScaleBatchRows)
            wait_flag(PIPE_MTE3, PIPE_S, ::event_t(scale_slot));
        scale_batch[scale_index] = scale;
        if (scale_index == kScaleBatchRows - 1 || offset + 1 == length) {
            native_device::pipe_fence<PIPE_S, PIPE_MTE3>(scale_slot);
            asc_copy_ub2gm_align(
                reinterpret_cast<__gm__ uint8_t *>(scales) + (row - scale_index) * sizeof(float),
                reinterpret_cast<__ubuf__ uint8_t *>(scale_batch),
                (scale_index + 1) * sizeof(float));
            if (offset - scale_index + 2 * kScaleBatchRows < length)
                set_flag(PIPE_MTE3, PIPE_S, ::event_t(scale_slot));
        }

        asc_mul_scalar(first, second, 1.f / scale, width);
        pipe_barrier(PIPE_V);
        auto integers = reinterpret_cast<__ubuf__ int32_t *>(work);
        asc_float2int32_rn(integers, first, width);
        pipe_barrier(PIPE_V);
        asc_deq_int322half(rounded, integers, width);
        pipe_barrier(PIPE_V);
        auto natural = reinterpret_cast<__ubuf__ uint16_t *>(first);
        transpose_panels<true>(natural, reinterpret_cast<__ubuf__ uint16_t *>(rounded), panels);
        auto quantized = ub_ptr<int8_t>(kCodesBase + slot * kMaxWidth);
        if (offset >= 2)
            wait_flag(PIPE_MTE3, PIPE_V, ::event_t(slot));
        asc_half2int8(quantized, reinterpret_cast<__ubuf__ half *>(natural), width);
        native_device::pipe_fence<PIPE_V, PIPE_MTE3>(slot);
        asc_copy_ub2gm(reinterpret_cast<__gm__ int8_t *>(codes) + row * width, quantized, width);
        if (reuse_slot)
            set_flag(PIPE_MTE3, PIPE_V, ::event_t(slot));
    }
    pipe_barrier(PIPE_ALL);
}
