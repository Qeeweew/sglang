#include <common/device.h>
#include <kernel_operator.h>
#include <c_api/asc_simd.h>

using namespace AscendC;
namespace {
using native_device::ub_ptr;
constexpr uint32_t width = H32_WIDTH;
}

extern "C" __global__ __aicore__ void h32_quant_kernel(GM_ADDR input, GM_ADDR indices,
                                                        GM_ADDR codes, GM_ADDR scales, int64_t rows,
                                                        GM_ADDR count) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    auto first = ub_ptr<float>(0), second = ub_ptr<float>(4 * width), work = ub_ptr<float>(8 * width);
    auto perm = ub_ptr<uint32_t>(12 * width);
    auto raw = ub_ptr<uint16_t>(20 * width);
    auto stat = ub_ptr<float>(22 * width);
    static_assert(22 * width + 32 <= 192 * 1024);
    if (count) {
        const int32_t live = reinterpret_cast<__gm__ int32_t *>(count)[0];
        rows = min(rows, int64_t(live > 0 ? live : 0));
    }
    if (GetBlockIdx() >= rows) return;
    asc_copy_gm2ub(perm + (H32_INTERLEAVED ? width : 0), reinterpret_cast<__gm__ uint32_t *>(indices) +
                   (H32_INTERLEAVED ? width : 0), (H32_INTERLEAVED ? 4 : 8) * width);
    for (int64_t row = GetBlockIdx(); row < rows; row += GetBlockNum()) {
        asc_copy_gm2ub(raw, reinterpret_cast<__gm__ uint16_t *>(input) + row * width, 2 * width);
        native_device::pipe_fence<PIPE_MTE2, PIPE_V, EVENT_ID0>();
#if H32_BF16
        asc_bfloat162float(first, reinterpret_cast<__ubuf__ bfloat16_t *>(raw), width);
#else
        asc_half2float(first, reinterpret_cast<__ubuf__ half *>(raw), width);
#endif
        pipe_barrier(PIPE_V);
        auto src = first, dst = second;
#if !H32_INTERLEAVED
        asc_gather(second, first, perm, width);
        pipe_barrier(PIPE_V);
        src = second; dst = first;
#endif
        asc_set_vector_mask(0, UINT64_MAX);
        for (int stage = 0; stage < 5; ++stage) {
            for (int base = 0; base < 128; base += 64) {
                asc_add(dst + 2 * base, src + base, src + base + 128, uint8_t(width / 256), 2, 1, 1, 32, 32, 32);
                asc_sub(dst + 2 * base + 8, src + base, src + base + 128, uint8_t(width / 256), 2, 1, 1, 32, 32, 32);
            }
            pipe_barrier(PIPE_V);
            auto swap = src; src = dst; dst = swap;
        }
        asc_gather(dst, src, perm + width, width);
        pipe_barrier(PIPE_V);
        asc_abs(src, dst, width);
        pipe_barrier(PIPE_V);
        asc_datablock_reduce_max(work, src, width);
        pipe_barrier(PIPE_V);
        asc_datablock_reduce_max(src, work, width / 8);
        pipe_barrier(PIPE_V);
        asc_datablock_reduce_max(work, src, width / 64);
        pipe_barrier(PIPE_V);
        asc_repeat_reduce_max_only_value(stat, work, (width + 511) / 512);
        native_device::pipe_fence<PIPE_V, PIPE_S, EVENT_ID0>();
        const float peak = stat[0];
        const float scale = peak > 0.f ? peak / 127.f : 1.f;
        stat[0] = scale;
        native_device::pipe_fence<PIPE_S, PIPE_MTE3, EVENT_ID0>();
        asc_copy_ub2gm_align(reinterpret_cast<__gm__ uint8_t *>(scales) + row * 4,
                             reinterpret_cast<__ubuf__ uint8_t *>(stat), 1, 4, 0, 0, 0, 0);
        asc_mul_scalar(src, dst, 1.f / scale, width);
        pipe_barrier(PIPE_V);
        asc_float2int32_rn(reinterpret_cast<__ubuf__ int32_t *>(work), src, width);
        pipe_barrier(PIPE_V);
        asc_int322float(dst, reinterpret_cast<__ubuf__ int32_t *>(work), width);
        pipe_barrier(PIPE_V);
        asc_float2half(reinterpret_cast<__ubuf__ half *>(raw), dst, width);
        pipe_barrier(PIPE_V);
        asc_half2int8(reinterpret_cast<__ubuf__ int8_t *>(src), reinterpret_cast<__ubuf__ half *>(raw), width);
        native_device::pipe_fence<PIPE_V, PIPE_MTE3, EVENT_ID0>();
        asc_copy_ub2gm(reinterpret_cast<__gm__ int8_t *>(codes) + row * width,
                       reinterpret_cast<__ubuf__ int8_t *>(src), width);
        pipe_barrier(PIPE_ALL);
    }
}
