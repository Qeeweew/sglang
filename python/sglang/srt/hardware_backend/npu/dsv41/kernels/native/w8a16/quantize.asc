#include <common/device.h>
#include <kernel_operator.h>
#include <c_api/asc_simd.h>
#include <w8a16/quantize_params.h>
using namespace AscendC;
namespace w8a16 {
using native_device::ub_ptr;
namespace {
constexpr uint32_t kLogicalK = W8A16_QUANT_K;
constexpr uint32_t kQuantRows = W8A16_QUANT_ROWS;
constexpr uint32_t kWorkers = W8A16_QUANT_WORKERS;
constexpr uint32_t kGroupElements = 256;
constexpr uint32_t kWeightBatches = 1;
// Raw BF16 slots: MTE2 -> run_vector -> MTE2.
// INT8/FP16 scale slots: run_vector -> MTE3 -> run_vector.
// Arithmetic/reduction scratch is shared and retired by explicit V barriers.
class QuantizePipeline {
    int64_t rows_;

    // This pipeline owns the UB arena and its event slots.
    static constexpr QuantizeLayout kLayout{kQuantRows, kGroupElements};
    __gm__ bfloat16_t *input_;
    __gm__ int8_t *quantized_;
    __gm__ half *scales_;
    struct Tile {
        uint32_t batch, group, valid_rows;
        int64_t first_row;
    };
    __aicore__ inline void load_panel(const Tile &tile, uint32_t slot, int64_t generation) {
        auto raw = ub_ptr<bfloat16_t>(uint32_t(slot * kLayout.elements * sizeof(bfloat16_t)));
        if (generation >= kQuantSlots)
            wait_flag(PIPE_V, PIPE_MTE2, ::event_t(slot));
        if (tile.valid_rows != kQuantRows && rows_ >= kQuantRows) {
            {
                asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
                asc_duplicate(reinterpret_cast<__ubuf__ uint16_t *>(raw), uint16_t(0),
                              uint8_t(kLayout.elements / 128), 1, 8);
            };
            constexpr uint8_t kPaddingHandoff = kQuantSlots;
            native_device::pipe_fence<PIPE_V, PIPE_MTE2, kPaddingHandoff>();
        }
        const int64_t source = (tile.first_row * kWeightBatches + tile.batch) * kLogicalK +
                               tile.group * kGroupElements;
        const uint64_t stride_bytes =
            (uint64_t(kWeightBatches) * kLogicalK - kGroupElements) * sizeof(bfloat16_t);
        if (stride_bytes / 32 <= UINT16_MAX) {
            asc_copy_gm2ub(raw, (input_ + (source)), uint16_t(tile.valid_rows),
                           uint16_t(kGroupElements * sizeof(bfloat16_t) / 32),
                           uint16_t(stride_bytes / 32), 0);
        } else if (stride_bytes <= UINT32_MAX) {
            asc_copy_gm2ub_align(raw, (input_ + (source)), uint16_t(tile.valid_rows),
                                 kGroupElements * uint32_t(sizeof(bfloat16_t)), 0, 0,
                                 uint32_t(stride_bytes), 0);
        }
        set_flag(PIPE_MTE2, PIPE_V, ::event_t(slot));
    }
    __aicore__ inline void compute_panel(uint32_t slot, int64_t generation, int64_t tasks) {
        const uint32_t count = kLayout.elements;
        auto raw = ub_ptr<bfloat16_t>(uint32_t(slot * count * sizeof(bfloat16_t)));
        auto values = ub_ptr<float>(kLayout.values_bytes);
        auto temporary = ub_ptr<float>(kLayout.temporary_bytes);
        auto partial = ub_ptr<float>(kLayout.partial_bytes);
        auto maxima = ub_ptr<float>(kLayout.maxima_bytes);
        auto scale32 = ub_ptr<float>(kLayout.scale_fp32_bytes);
        auto scale16 = ub_ptr<half>(kLayout.scale_fp16_bytes) + (slot * kLayout.scale_pitch);
        auto broadcast = ub_ptr<float>(kLayout.broadcast_bytes);
        auto integer = ub_ptr<int16_t>(kLayout.integer_bytes);
        auto rounded = ub_ptr<half>(kLayout.rounded_bytes);
        auto quantized = ub_ptr<int8_t>(kLayout.quantized_bytes) + (slot * count);
        wait_flag(PIPE_MTE2, PIPE_V, ::event_t(slot));
        if (generation >= kQuantSlots)
            wait_flag(PIPE_MTE3, PIPE_V, ::event_t(slot));
        // Every arithmetic tile contains complete 64/128-lane repeats.
        // Explicit strides avoid the SDK's generic count/tail dispatch while
        // retaining runtime G128/G256 and row capacity in one device entry.
        const uint8_t repeats32 = count / 64, repeats16 = count / 128;
        {
            asc_set_vector_mask(0, UINT64_MAX);
            asc_bfloat162float(values, raw, repeats32, 1, 1, 8, 4);
        };
        pipe_barrier(PIPE_V);
        {
            asc_set_vector_mask(0, UINT64_MAX);
            asc_abs(temporary, values, repeats32, 1, 1, 8, 8);
        };
        pipe_barrier(PIPE_V);
        {
            asc_set_vector_mask(0, (64) >= 64 ? UINT64_MAX : (uint64_t(1) << ((64) & 63)) - 1);
            asc_datablock_reduce_max(partial, temporary, uint8_t(count / 64), 1, 1, 8);
        };
        pipe_barrier(PIPE_V);
        {
            asc_set_vector_mask(0, (kGroupElements / 8) >= 64
                                       ? UINT64_MAX
                                       : (uint64_t(1) << ((kGroupElements / 8) & 63)) - 1);
            asc_repeat_reduce_max_only_value(maxima, partial, uint8_t(kQuantRows), 1, 1,
                                             kGroupElements / 64);
        };
        pipe_barrier(PIPE_V);
        {
            asc_set_vector_mask(0, (uint64_t(kQuantRows)) >= 64
                                       ? UINT64_MAX
                                       : (uint64_t(1) << ((uint64_t(kQuantRows)) & 63)) - 1);
            asc_mul_scalar(scale32, maxima, 1.0f / 127.0f, 1, 1, 1, 8, 8);
        };
        pipe_barrier(PIPE_V);
        // Minimum positive FP16 subnormal; scales are rounded/stored before use.
        {
            asc_set_vector_mask(0, (uint64_t(kQuantRows)) >= 64
                                       ? UINT64_MAX
                                       : (uint64_t(1) << ((uint64_t(kQuantRows)) & 63)) - 1);
            asc_max_scalar(scale32, scale32, 0x1p-24f, 1, 1, 1, 8, 8);
        };
        pipe_barrier(PIPE_V);
        {
            asc_set_vector_mask(0, (uint64_t(kQuantRows)) >= 64
                                       ? UINT64_MAX
                                       : (uint64_t(1) << ((uint64_t(kQuantRows)) & 63)) - 1);
            asc_float2half_rn(scale16, scale32, 1, 1, 1, 4, 8);
        };
        pipe_barrier(PIPE_V);
        {
            asc_set_vector_mask(0, (uint64_t(kQuantRows)) >= 64
                                       ? UINT64_MAX
                                       : (uint64_t(1) << ((uint64_t(kQuantRows)) & 63)) - 1);
            asc_half2float(scale32, scale16, 1, 1, 1, 8, 4);
        };
        pipe_barrier(PIPE_V);
        asc_brcb(reinterpret_cast<__ubuf__ uint32_t *>(broadcast),
                 reinterpret_cast<__ubuf__ uint32_t *>(scale32), 1, 8, kQuantRows / 8);
        pipe_barrier(PIPE_V);
        asc_set_vector_mask(0, (64) >= 64 ? UINT64_MAX : (uint64_t(1) << ((64) & 63)) - 1);
        // G128/G256 has at most four fragments. Only this capacity is
        // expanded; the group size and all DMA extents remain runtime.
#pragma unroll
        for (uint32_t chunk = 0; chunk < kQuantMaxGroupElements / 64; ++chunk) {
            const uint32_t column = chunk * 64;
            if (column >= kGroupElements)
                break;
            asc_div((temporary + (column)), (values + (column)), broadcast, uint8_t(kQuantRows), 1,
                    1, 0, uint8_t(kGroupElements / 8), uint8_t(kGroupElements / 8), 1);
        }
        pipe_barrier(PIPE_V);
        // A representable stored scale bounds |x/scale| <= 190.5. INT16 RNE
        // and its exact half cast preserve ties before saturated INT8 narrowing.
        {
            asc_set_vector_mask(0, UINT64_MAX);
            asc_float2int16_rn(integer, temporary, repeats32, 1, 1, 4, 8);
        };
        pipe_barrier(PIPE_V);
        {
            asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
            asc_int162half(rounded, integer, repeats16, 1, 1, 8, 8);
        };
        pipe_barrier(PIPE_V);
        {
            asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
            asc_half2int8_rn(quantized, rounded, repeats16, 1, 1, 4, 8);
        };
        if (generation + kQuantSlots < tasks)
            set_flag(PIPE_V, PIPE_MTE2, ::event_t(slot));
        set_flag(PIPE_V, PIPE_MTE3, ::event_t(slot));
    }
    __aicore__ inline void store_tile(const Tile &tile, uint32_t slot, int64_t generation,
                                      int64_t tasks) {
        wait_flag(PIPE_V, PIPE_MTE3, ::event_t(slot));
        auto quantized = ub_ptr<int8_t>(kLayout.quantized_bytes) + (slot * kLayout.elements);
        const int64_t offset = (int64_t(tile.batch) * rows_ + tile.first_row) * kLogicalK +
                               tile.group * kGroupElements;
        const uint32_t stride = kLogicalK - kGroupElements;
        if (stride / 32 <= UINT16_MAX) {
            asc_copy_ub2gm((quantized_ + (offset)), quantized, uint16_t(tile.valid_rows),
                           uint16_t(kGroupElements / 32), 0, uint16_t(stride / 32));
        } else {
            asc_copy_ub2gm_align((quantized_ + (offset)), quantized, uint16_t(tile.valid_rows),
                                 kGroupElements, 0, 0, 0, stride);
        }
        const int64_t scale_offset =
            (int64_t(tile.batch) * (kLogicalK / kGroupElements) + tile.group) * rows_ +
            tile.first_row;
        asc_copy_ub2gm_align(
            (scales_ + (scale_offset)),
            (ub_ptr<half>(kLayout.scale_fp16_bytes) + (slot * kLayout.scale_pitch)), 1,
            tile.valid_rows * uint32_t(sizeof(half)), 0, 0, 0, 0);
        if (generation + kQuantSlots < tasks)
            set_flag(PIPE_MTE3, PIPE_V, ::event_t(slot));
    }

  public:
    __aicore__ inline QuantizePipeline(QuantizeSources sources)
        : rows_(sources.rows), input_(reinterpret_cast<__gm__ bfloat16_t *>(sources.input)),
          quantized_(reinterpret_cast<__gm__ int8_t *>(sources.quantized)),
          scales_(reinterpret_cast<__gm__ half *>(sources.scales)) {}
    __aicore__ inline void run() {
        InitSocState();
        // Float IEEE mode is part of the old entry contract; do not inherit it.
        SetSaturationFlag<SaturationMode::FLOAT>(false);
        const uint32_t groups = kLogicalK / kGroupElements;
        const int64_t total = ((rows_ + kQuantRows - 1) / kQuantRows) * groups * kWeightBatches;
        const uint32_t core = GetBlockIdx();
        const int64_t count = total > core ? (total - core + kWorkers - 1) / kWorkers : 0;
        asc_duplicate(ub_ptr<uint16_t>(kLayout.scale_fp16_bytes), uint16_t(0),
                      kQuantSlots * kLayout.scale_pitch);
        if (rows_ < kQuantRows) {
            // Every job writes the same valid prefix. Untouched padding stays
            // zero for the complete lifetime of each private raw slot.
            for (uint32_t slot = 0; slot < min(int64_t(kQuantSlots), count); ++slot) {
                asc_set_vector_mask(UINT64_MAX, UINT64_MAX);
                asc_duplicate(ub_ptr<uint16_t>(uint32_t(slot * kLayout.elements * sizeof(bfloat16_t))),
                              uint16_t(0), uint8_t(kLayout.elements / 128), 1, 8);
            };
            constexpr uint8_t kPaddingHandoff = kQuantSlots;
            native_device::pipe_fence<PIPE_V, PIPE_MTE2, kPaddingHandoff>();
        }
        pipe_barrier(PIPE_V);
        uint32_t batch = core % kWeightBatches;
        const uint32_t local = core / kWeightBatches;
        const uint32_t batch_step = kWorkers % kWeightBatches;
        const uint32_t local_step = kWorkers / kWeightBatches;
        uint32_t group = local % groups;
        int64_t first_row = int64_t(local / groups) * kQuantRows;
        const uint32_t group_step = local_step % groups;
        const int64_t row_step = int64_t(local_step / groups) * kQuantRows;
        Tile tiles[kQuantSlots];
        for (int64_t step = 0; step < count + kQuantSlots; ++step) {
            if (step >= kQuantSlots) {
                const uint32_t slot = (step - kQuantSlots) % kQuantSlots;
                store_tile(tiles[slot], slot, step - kQuantSlots, count);
            }
            if (step < count) {
                const uint32_t slot = step % kQuantSlots;
                tiles[slot] = Tile{
                    batch, group, uint32_t(min(int64_t(kQuantRows), rows_ - first_row)), first_row};
                load_panel(tiles[slot], slot, step);
                batch += batch_step;
                const uint32_t carry = batch >= kWeightBatches;
                if (carry)
                    batch -= kWeightBatches;
                group += group_step + carry;
                first_row += row_step;
                if (group >= groups) {
                    group -= groups;
                    first_row += kQuantRows;
                }
            }
            if (step && step <= count)
                compute_panel((step - 1) % kQuantSlots, step - 1, count);
        }
        // Retire the consumers of every reused slot credit before leaving
        // the entry. Output DMA completion alone does not retire V/MTE2
        // waits. Final drains use IDs separate from slot0/1 notifications.
        constexpr uint8_t kFinalDrain = 7;
        native_device::pipe_fence<PIPE_V, PIPE_S, kFinalDrain>();
        native_device::pipe_fence<PIPE_MTE2, PIPE_S, kFinalDrain>();
        native_device::pipe_fence<PIPE_MTE3, PIPE_S, kFinalDrain>();
    }
};
} // namespace
} // namespace w8a16
__global__ __aicore__ void w8a16_quantize_kernel(w8a16::QuantizeSources args) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    w8a16::QuantizePipeline pipeline(args);
    pipeline.run();
}
