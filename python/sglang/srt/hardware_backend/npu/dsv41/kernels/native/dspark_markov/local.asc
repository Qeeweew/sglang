#include <common/device.h>
#include <kernel_operator.h>
#include <c_api/asc_simd.h>
#include <dspark_markov/launch.h>

using namespace AscendC;
namespace {
using native_device::ub_ptr;
constexpr uint32_t kColumns = dspark_markov::kColumns;
constexpr uint32_t kLanes = 64;
constexpr uint32_t kGroups = kColumns / kLanes;
__aicore__ inline void read_logits(GM_ADDR input, int64_t index, bool fp32, uint32_t count,
                                    __ubuf__ float *wide, __ubuf__ bfloat16_t *narrow) {
    auto dst = fp32 ? reinterpret_cast<__ubuf__ uint8_t *>(wide) :
                      reinterpret_cast<__ubuf__ uint8_t *>(narrow);
    const uint32_t bytes = fp32 ? 4 : 2;
    asc_copy_gm2ub_align(dst, input + index * bytes, 1, count * bytes, 0, 0, 0, 0);
}
}

__global__ __aicore__ void markov_local_greedy(GM_ADDR base, GM_ADDR bias, GM_ADDR partial,
        int64_t rows, int64_t width, int64_t parts, int64_t base_stride, int64_t bias_stride,
        uint32_t start, uint32_t formats) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    InitSocState();
    auto base16 = ub_ptr<bfloat16_t>(0), bias16 = ub_ptr<bfloat16_t>(2 * kColumns);
    auto left = ub_ptr<float>(4 * kColumns), right = ub_ptr<float>(8 * kColumns);
    auto sums = ub_ptr<float>(12 * kColumns), maxima = ub_ptr<float>(16 * kColumns);
    auto group_sums = ub_ptr<float>(16 * kColumns + 8 * kGroups);
    auto reduced = ub_ptr<float>(16 * kColumns + 12 * kGroups);
    auto masks = ub_ptr<uint64_t>(16 * kColumns + 12 * kGroups + 64);
    auto packet = ub_ptr<uint32_t>(16 * kColumns + 20 * kGroups + 64);
    for (int64_t job = GetBlockIdx(); job < rows * parts; job += GetBlockNum()) {
        const int64_t row = job % rows, first = (job / rows) * kColumns;
        const uint32_t count = width - first < kColumns ? width - first : kColumns;
        uint32_t token = 0x7fffffffU, score = 0xff800000U;
        if (count) {
            read_logits(base, row * base_stride + first, formats & 1, count, left, base16);
            read_logits(bias, row * bias_stride + first, formats & 2, count, right, bias16);
            native_device::pipe_fence<PIPE_MTE2, PIPE_V, EVENT_ID0>();
            if (!(formats & 1)) asc_bfloat162float(left, base16, count);
            if (!(formats & 2)) asc_bfloat162float(right, bias16, count);
            if (count % kLanes) {
                asc_duplicate(reinterpret_cast<__ubuf__ int32_t *>(sums) + count / kLanes * kLanes,
                              int32_t(0xff800000U), kLanes);
            }
            pipe_barrier(PIPE_V);
            asc_add(sums, left, right, count);
            pipe_barrier(PIPE_V);
            const uint8_t groups = (count + kLanes - 1) / kLanes;
            asc_set_vector_mask(0, ~uint64_t(0));
            asc_repeat_reduce_max_value_index(maxima, sums, groups, 1, 1, 8);
            asc_repeat_reduce_sum(group_sums, sums, groups, 1, 1, 8);
            pipe_barrier(PIPE_V);
            const uint64_t active = ~uint64_t(0) >> (64 - groups);
            asc_set_vector_mask(0, active);
            asc_repeat_reduce_sum(reduced + 8, group_sums, 1, 1, 1, 8);
            const uint64_t even = 0x5555555555555555ULL >> (2 * (kGroups - groups));
            asc_set_vector_mask(0, even);
            asc_repeat_reduce_max_value_index(reduced, maxima, 1, 1, 1, 8);
            asc_set_vector_mask(0, ~uint64_t(0));
            native_device::pipe_fence<PIPE_V, PIPE_S, EVENT_ID0>();
            auto bits = reinterpret_cast<__ubuf__ uint32_t *>(reduced);
            const uint32_t index = bits[1];
            uint32_t winner = (index / 2) * kLanes + reinterpret_cast<__ubuf__ uint32_t *>(maxima)[index + 1];
            if ((bits[8] & 0x7fffffffU) > 0x7f800000U) {
                asc_eq(reinterpret_cast<__ubuf__ uint8_t *>(masks), sums, sums, groups, 1, 1, 1, 1, 8, 8);
                native_device::pipe_fence<PIPE_V, PIPE_S, EVENT_ID0>();
                for (uint32_t group = 0; group < groups; ++group) {
                    const uint64_t nan = ~masks[group];
                    if (nan) {
                        winner = group * kLanes + __builtin_ctzll(nan);
                        break;
                    }
                }
            }
            score = reinterpret_cast<__ubuf__ uint32_t *>(sums)[winner];
            token = start + first + winner;
            native_device::pipe_fence<PIPE_S, PIPE_V, EVENT_ID0>();
            native_device::pipe_fence<PIPE_V, PIPE_MTE2, EVENT_ID0>();
        }
        packet[0] = score;
        packet[1] = token;
        native_device::pipe_fence<PIPE_S, PIPE_MTE3, EVENT_ID0>();
        asc_copy_ub2gm_align(partial + job * 8, reinterpret_cast<__ubuf__ uint8_t *>(packet),
                             1, 8, 0, 0, 0, 0);
        native_device::pipe_fence<PIPE_MTE3, PIPE_S, EVENT_ID0>();
    }
}
